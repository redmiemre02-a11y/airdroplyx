---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 border-t-4 border-blue-600 pt-16 pb-8 mt-auto">
  <div class="max-w-[1200px] mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <img src="/logo.jpg" alt="Airdroplyx Logo" class="w-8 h-8 rounded-lg object-cover" />
          <span class="text-white font-extrabold text-xl tracking-tight">airdroplyx</span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-sm mb-4">
          The premier platform for verified cryptocurrency airdrops, testnet guides, and Web3 yield farming strategies. Updated 24/7 by crypto researchers.
        </p>
      </div>
      <div>
        <h4 class="text-white font-bold mb-4 uppercase tracking-wider text-sm">Quick Links</h4>
        <ul class="flex flex-col gap-2 text-sm text-slate-400">
          <li><a href="/" class="hover:text-blue-400 transition-colors">Latest Airdrops</a></li>
          <li><a href="/#hottest" class="hover:text-blue-400 transition-colors">Hottest Opportunities</a></li>
          <li><a href="/academy" class="hover:text-blue-400 transition-colors">Airdrop Academy</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-bold mb-4 uppercase tracking-wider text-sm">Legal & Compliance</h4>
        <ul class="flex flex-col gap-2 text-sm text-slate-400">
          <li><a href="/about" class="hover:text-blue-400 transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-blue-400 transition-colors">Contact</a></li>
          <li><a href="/privacy-policy" class="hover:text-blue-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-of-service" class="hover:text-blue-400 transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {year} Airdroplyx. All rights reserved.</p>
      <p>Disclaimer: Information provided is strictly for educational purposes and should not be construed as financial advice.</p>
    </div>
  </div>
</footer>
