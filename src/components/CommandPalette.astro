---
// Lightweight Command Palette: Search index is loaded on-demand via /search-index.json
// saving ~200 MB of duplicate HTML across 980+ static pages
---

<!-- Global Command Palette Modal Backdrop -->
<div 
  id="command-palette-backdrop" 
  class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-200 flex items-start justify-center pt-16 sm:pt-24 px-4"
  role="dialog"
  aria-modal="true"
  aria-label="Global Search Palette"
>
  <div 
    id="command-palette-modal"
    class="w-full max-w-2xl bg-white dark:bg-slate-900 rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform scale-95 transition-transform duration-200 flex flex-col max-h-[80vh]"
  >
    <!-- Search Input Bar -->
    <div class="relative flex items-center px-5 py-4 border-b border-slate-100 dark:border-slate-800">
      <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input 
        type="text" 
        id="palette-input" 
        placeholder="Search 735+ airdrops, 90 academy guides, 130 news stories..."
        class="w-full ml-3 bg-transparent text-slate-900 dark:text-white placeholder-slate-400 text-base sm:text-lg font-medium outline-none"
        autocomplete="off"
        spellcheck="false"
      />
      <div class="hidden sm:flex items-center gap-1.5 shrink-0">
        <kbd class="px-2 py-1 text-[11px] font-mono font-bold text-slate-400 bg-slate-100 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">ESC</kbd>
      </div>
    </div>

    <!-- Quick Shortcuts / Empty Prompt -->
    <div id="palette-shortcuts-hint" class="px-5 py-2.5 bg-slate-50 dark:bg-slate-850 border-b border-slate-100 dark:border-slate-800 text-[11px] text-slate-500 dark:text-slate-400 flex items-center justify-between font-medium">
      <div class="flex items-center gap-4">
        <span><kbd class="font-mono bg-slate-200/80 dark:bg-slate-700 px-1.5 py-0.5 rounded text-[10px]">↑</kbd> <kbd class="font-mono bg-slate-200/80 dark:bg-slate-700 px-1.5 py-0.5 rounded text-[10px]">↓</kbd> to navigate</span>
        <span><kbd class="font-mono bg-slate-200/80 dark:bg-slate-700 px-1.5 py-0.5 rounded text-[10px]">↵</kbd> to select</span>
      </div>
      <span><kbd class="font-mono bg-slate-200/80 dark:bg-slate-700 px-1.5 py-0.5 rounded text-[10px]">Ctrl+K</kbd> anywhere</span>
    </div>

    <!-- Results List Scrollable -->
    <div id="palette-results" class="overflow-y-auto p-3 space-y-4 divide-y divide-slate-100 dark:divide-slate-800/60 max-h-[55vh]">
      <!-- Dynamically filled via JavaScript -->
    </div>

    <!-- Palette Footer -->
    <div class="px-5 py-3 bg-slate-50 dark:bg-slate-900/90 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-400 flex items-center justify-between">
      <span>Airdroplyx Universal Index</span>
      <span class="font-semibold text-slate-500 dark:text-slate-400">950+ total indexed items</span>
    </div>
  </div>
</div>

<script is:inline>
  const backdrop = document.getElementById('command-palette-backdrop');
  const modal = document.getElementById('command-palette-modal');
  const input = document.getElementById('palette-input');
  const resultsContainer = document.getElementById('palette-results');
  let selectedIndex = 0;
  let currentItems = [];
  let indexData = null;
  let isFetching = false;

  async function loadSearchIndex() {
    if (indexData || isFetching) return indexData;
    isFetching = true;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        indexData = await res.json();
      }
    } catch (e) {
      console.warn('Failed to load search index:', e);
    } finally {
      isFetching = false;
    }
    return indexData;
  }

  // Preload search index on idle or when mouse hovers over document
  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(() => {
      loadSearchIndex();
    }, { timeout: 3000 });
  } else {
    setTimeout(loadSearchIndex, 2000);
  }

  async function openPalette() {
    if (!backdrop || !modal || !input) return;
    backdrop.classList.remove('hidden');
    void backdrop.offsetWidth;
    backdrop.classList.remove('opacity-0');
    modal.classList.remove('scale-95');
    modal.classList.add('scale-100');
    input.value = '';
    selectedIndex = 0;
    setTimeout(() => input.focus(), 50);

    if (!indexData) {
      if (resultsContainer) {
        resultsContainer.innerHTML = '<div class="py-12 text-center text-xs text-slate-400">Loading universal index...</div>';
      }
      await loadSearchIndex();
    }
    renderDefaultView();
  }

  function closePalette() {
    if (!backdrop || !modal) return;
    backdrop.classList.add('opacity-0');
    modal.classList.remove('scale-100');
    modal.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 200);
  }

  function renderDefaultView() {
    if (!indexData) return;
    const quickPages = indexData.pages || [];
    const popularDrops = (indexData.airdrops || []).slice(0, 5);

    currentItems = [...quickPages, ...popularDrops];
    renderItems([
      { title: 'Navigation & Tools', items: quickPages },
      { title: 'Trending Airdrops', items: popularDrops }
    ]);
  }

  function handleSearch(query) {
    if (!indexData) return;
    const q = query.toLowerCase().trim();
    if (!q) {
      renderDefaultView();
      return;
    }

    const matchedDrops = (indexData.airdrops || [])
      .filter(a => a.title.toLowerCase().includes(q) || a.subtitle.toLowerCase().includes(q))
      .slice(0, 6);

    const matchedAcademy = (indexData.academy || [])
      .filter(a => a.title.toLowerCase().includes(q))
      .slice(0, 4);

    const matchedNews = (indexData.news || [])
      .filter(n => n.title.toLowerCase().includes(q) || n.subtitle.toLowerCase().includes(q))
      .slice(0, 4);

    const matchedPages = (indexData.pages || [])
      .filter(p => p.title.toLowerCase().includes(q) || p.subtitle.toLowerCase().includes(q));

    const sections = [];
    currentItems = [];

    if (matchedPages.length > 0) {
      sections.push({ title: 'Pages & Tools', items: matchedPages });
      currentItems.push(...matchedPages);
    }
    if (matchedDrops.length > 0) {
      sections.push({ title: `Airdrops (${matchedDrops.length})`, items: matchedDrops });
      currentItems.push(...matchedDrops);
    }
    if (matchedAcademy.length > 0) {
      sections.push({ title: `Academy Masterclasses (${matchedAcademy.length})`, items: matchedAcademy });
      currentItems.push(...matchedAcademy);
    }
    if (matchedNews.length > 0) {
      sections.push({ title: `News & Alpha (${matchedNews.length})`, items: matchedNews });
      currentItems.push(...matchedNews);
    }

    selectedIndex = 0;
    renderItems(sections);
  }

  function renderItems(sections) {
    if (!resultsContainer) return;

    if (sections.length === 0 || currentItems.length === 0) {
      resultsContainer.innerHTML = `
        <div class="py-12 text-center">
          <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">No matching results found</p>
          <p class="text-xs text-slate-400 mt-1">Try searching for a different protocol, testnet, or guide</p>
        </div>
      `;
      return;
    }

    let globalItemIndex = 0;
    let html = '';

    sections.forEach(section => {
      html += `
        <div class="pt-3 first:pt-0">
          <div class="px-2 pb-2 text-[10px] font-black uppercase tracking-wider text-slate-400 dark:text-slate-500">
            ${section.title}
          </div>
          <div class="space-y-1">
      `;

      section.items.forEach(item => {
        const isSelected = globalItemIndex === selectedIndex;
        const iconOrLogo = item.logo 
          ? `<img src="${item.logo}" class="w-6 h-6 rounded-lg object-contain bg-slate-100 dark:bg-slate-800 p-0.5 shrink-0" alt="${item.title}" />`
          : `<span class="w-6 h-6 flex items-center justify-center text-sm shrink-0">${item.icon || '📄'}</span>`;

        html += `
          <a 
            href="${item.url}" 
            data-index="${globalItemIndex}"
            class="palette-result-item flex items-center justify-between px-3 py-2.5 rounded-2xl transition-colors cursor-pointer ${
              isSelected 
                ? 'bg-blue-600 text-white' 
                : 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200'
            }"
          >
            <div class="flex items-center gap-3 min-w-0">
              ${iconOrLogo}
              <div class="min-w-0">
                <div class="font-bold text-sm truncate leading-snug ${isSelected ? 'text-white' : 'text-slate-900 dark:text-white'}">
                  ${item.title}
                </div>
                <div class="text-[11px] truncate leading-tight ${isSelected ? 'text-blue-100' : 'text-slate-400 dark:text-slate-400'}">
                  ${item.subtitle}
                </div>
              </div>
            </div>
            <span class="text-xs shrink-0 ${isSelected ? 'text-blue-200' : 'text-slate-400'} font-medium ml-2">
              ↵
            </span>
          </a>
        `;
        globalItemIndex++;
      });

      html += `</div></div>`;
    });

    resultsContainer.innerHTML = html;

    // Attach click and mouseenter handlers
    const itemElements = resultsContainer.querySelectorAll('.palette-result-item');
    itemElements.forEach(el => {
      el.addEventListener('mouseenter', (e) => {
        const idx = parseInt(el.getAttribute('data-index') || '0', 10);
        updateSelectedItem(idx);
      });
    });
  }

  function updateSelectedItem(newIndex) {
    if (currentItems.length === 0) return;
    selectedIndex = Math.max(0, Math.min(newIndex, currentItems.length - 1));
    const items = resultsContainer.querySelectorAll('.palette-result-item');
    items.forEach((item, idx) => {
      const isSelected = idx === selectedIndex;
      if (isSelected) {
        item.classList.add('bg-blue-600', 'text-white');
        item.classList.remove('hover:bg-slate-100', 'dark:hover:bg-slate-800', 'text-slate-800', 'text-slate-200');
        const title = item.querySelector('.text-slate-900, .dark\\:text-white');
        if (title) title.classList.add('text-white');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('bg-blue-600', 'text-white');
        item.classList.add('hover:bg-slate-100', 'dark:hover:bg-slate-800', 'text-slate-800', 'text-slate-200');
      }
    });
  }

  // Keybindings
  window.addEventListener('keydown', (e) => {
    // Open on Ctrl+K or Cmd+K
    if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      if (backdrop && !backdrop.classList.contains('hidden')) {
        closePalette();
      } else {
        openPalette();
      }
      return;
    }

    if (!backdrop || backdrop.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closePalette();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      updateSelectedItem(selectedIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      updateSelectedItem(selectedIndex - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (currentItems[selectedIndex]) {
        window.location.href = currentItems[selectedIndex].url;
      }
    }
  });

  // Event Listeners
  if (input) {
    input.addEventListener('input', (e) => {
      handleSearch(e.target.value);
    });
  }

  if (backdrop) {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closePalette();
      }
    });
  }

  // Global trigger hooks (e.g. from buttons with data-open-palette)
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-open-palette]');
    if (trigger) {
      e.preventDefault();
      openPalette();
    }
  });
</script>
