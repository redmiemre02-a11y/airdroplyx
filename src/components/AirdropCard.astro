---
import type { Airdrop } from '../data/airdrops';

interface Props {
  airdrop: Airdrop;
}

const { airdrop } = Astro.props;

const statusBadgeColor = airdrop.status === 'active' ? 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800' : 
                         airdrop.status === 'upcoming' ? 'bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border-amber-200 dark:border-amber-800' : 
                         'bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-200 dark:border-slate-700';
---

<div 
  class="airdrop-card-item bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group relative mb-5"
  data-airdrop-id={airdrop.id}
  data-airdrop-name={(airdrop.name || '').toLowerCase()}
  data-airdrop-category={(airdrop.category || '').toLowerCase()}
  data-airdrop-featured={airdrop.featured ? 'true' : 'false'}
  data-airdrop-desc={(airdrop.description || airdrop.overview || '').toLowerCase()}
>
  
  {airdrop.featured && (
    <div class="absolute -top-3 -right-3 inline-flex items-center gap-1.5 bg-gradient-to-r from-orange-400 to-red-500 rounded-full px-3 py-1 text-[11px] font-bold text-white shadow-lg shadow-orange-500/30 z-10">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M17.5 11.2c-.3-.3-.8-.3-1.1 0-1.8 1.8-3.4 3.7-3.4 6.3 0 1.9 1.6 3.5 3.5 3.5s3.5-1.6 3.5-3.5c0-2.6-1.6-4.5-3.4-6.3zm-10-2.4c-1.8 1.8-3.4 3.7-3.4 6.3 0 1.9 1.6 3.5 3.5 3.5s3.5-1.6 3.5-3.5c0-2.6-1.6-4.5-3.4-6.3-.3-.3-.8-.3-1.1 0zM12 2C7.6 2 4 5.6 4 10s3.6 8 8 8 8-3.6 8-8-3.6-8-8-8zm0 14c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6z"/></svg>
      <span>HOT</span>
    </div>
  )}

  <div class="flex items-start gap-4">
    <!-- Logo Box -->
    <div class="w-[72px] h-[72px] rounded-xl bg-slate-50 dark:bg-slate-700/60 border border-slate-100 dark:border-slate-700 flex items-center justify-center shrink-0 p-1.5 shadow-inner overflow-hidden">
      <img src={airdrop.logo} alt={airdrop.name} class="w-full h-full object-cover rounded-lg drop-shadow-sm group-hover:scale-110 transition-transform duration-300" loading="lazy" />
    </div>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <h3 class="text-[18px] font-bold text-slate-900 dark:text-white mb-1 truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        <a href={`/airdrop/${airdrop.id}`} class="before:absolute before:inset-0">{airdrop.name}</a>
      </h3>
      
      <div class="inline-flex items-center gap-1.5 text-[13px] font-medium text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700/60 px-2.5 py-1 rounded-md mb-3">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>{airdrop.reward || (airdrop as any).potentialReward || 'Confirmed Allocation'}</span>
      </div>
      
      <p class="text-[14px] text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
        {airdrop.description || airdrop.overview}
      </p>
    </div>
  </div>

  <!-- Bottom Row -->
  <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700 flex flex-wrap items-center justify-between gap-3 relative z-20">
    <div class="flex items-center gap-2">
      <span class={`text-[11px] font-extrabold uppercase px-3 py-1 rounded-full border tracking-wide ${statusBadgeColor}`}>
        {airdrop.status}
      </span>
      <span class="text-[11px] font-bold uppercase px-3 py-1 rounded-full border bg-slate-50 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 tracking-wide hidden sm:inline-block">
        {airdrop.category}
      </span>
      {airdrop.publishDate && airdrop.publishDate > '2026-09-13' ? (
        <span class="flex items-center gap-1 text-[11px] font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full border border-indigo-200">
          📅 Releases {new Date(airdrop.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
        </span>
      ) : airdrop.status === 'active' && (
        <span class="flex items-center gap-1.5 text-[11px] font-bold text-red-500 bg-red-50 px-3 py-1 rounded-full border border-red-100 animate-pulse">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Active Drop
        </span>
      )}
    </div>
    
    <div class="flex items-center gap-2 relative z-30">
      <button 
        type="button"
        class="bookmark-toggle-btn p-1.5 rounded-lg text-slate-400 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-950/40 transition-colors"
        data-id={airdrop.id}
        title="Toggle Watchlist"
        aria-label="Toggle Watchlist"
      >
        <svg class="w-4 h-4 star-svg transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
        </svg>
      </button>
      <a href={`/airdrop/${airdrop.id}`} class="text-sm font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 group/btn">
        Guide
        <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>
  </div>

</div>
