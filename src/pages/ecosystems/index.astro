---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ecosystems } from '../../data/ecosystems';
import { airdrops } from '../../data/airdrops';

// Calculate live airdrop counts per ecosystem
const ecosystemsWithCounts = ecosystems.map(eco => {
  const matchingAirdrops = airdrops.filter(a => eco.match(a));
  return {
    ...eco,
    count: matchingAirdrops.length,
    sampleLogos: matchingAirdrops.slice(0, 4).map(a => a.logo)
  };
});
---

<Layout 
  title="Top Crypto Airdrop Ecosystems 2026 | Berachain, Monad, Solana, Bitcoin L2 | Airdroplyx"
  description="Explore categorized cryptocurrency airdrops by blockchain ecosystem. Complete guides for Berachain, Monad, Solana, Bitcoin L2, Story Protocol, AI & DePIN, and Ethereum Layer 2."
>
  <Header />

  <main class="max-w-[1280px] mx-auto px-4 py-12">
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-900/40 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-wider mb-4">
        <span>🌐</span> Categorized Alpha Hubs
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
        Web3 Airdrop Ecosystems
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
        Target your farming capital and time effectively. Dive deep into curated ecosystem hubs featuring verified testnet guides, faucet links, validator strategies, and institutional tokenomics.
      </p>
    </header>

    <!-- Ecosystems Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {ecosystemsWithCounts.map((eco) => (
        <a 
          href={`/ecosystem/${eco.slug}/`}
          class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-7 shadow-sm hover:shadow-xl hover:border-blue-500/50 dark:hover:border-blue-500/50 transition-all flex flex-col justify-between"
        >
          <div>
            <!-- Top Badges -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="inline-block text-[11px] font-black uppercase tracking-wider px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                {eco.badge}
              </span>
              <span class="text-xs font-black text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 px-2.5 py-0.5 rounded-full">
                {eco.count} Airdrops
              </span>
            </div>

            <!-- Title & Tagline -->
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl shrink-0 group-hover:scale-110 transition-transform">{eco.icon}</span>
              <h2 class="text-2xl font-black text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {eco.name}
              </h2>
            </div>

            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 mb-4 line-clamp-1">
              {eco.tagline}
            </p>

            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6 line-clamp-3">
              {eco.description}
            </p>
          </div>

          <div>
            <!-- Sample Logos -->
            <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-800">
              <div class="flex -space-x-2">
                {eco.sampleLogos.map((logo, idx) => (
                  <img 
                    src={logo} 
                    alt="Protocol logo" 
                    class="w-7 h-7 rounded-full border-2 border-white dark:border-slate-900 object-cover bg-slate-100" 
                    loading="lazy"
                  />
                ))}
              </div>

              <span class="text-xs font-bold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Explore Hub <span>→</span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
