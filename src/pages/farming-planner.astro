          time: "15 mins",
          cost: "~$2.00 gas",
          guide: "/airdrop/symbiotic"
        },
        {
          day: "Thursday",
          protocol: "Ethena USDe & sUSDe Yield Vault",
          task: "Lock USDe into liquidity pools (Curve / Pendle) to farm Sats multipliers and delta-neutral funding rates.",
          time: "15 mins",
          cost: "~$1.50 gas",
          guide: "/airdrop/ethena"
        },
        {
          day: "Friday",
          protocol: "Drift Protocol & Kamino Finance (Solana)",
          task: "Provide delta-neutral liquidity into Kamino Multiply and trade perpetuals on Drift to farm season points.",
          time: "15 mins",
          cost: "< $0.05",
          guide: "/airdrop/drift-protocol"
        },
        {
          day: "Saturday",
          protocol: "MakerDAO / Sky USDS Rebalancing",
          task: "Supply sUSDS into Spark Protocol lending markets to capture algorithmic interest and Sky stars.",
          time: "15 mins",
          cost: "~$2.50 gas",
          guide: "/airdrop/makerdao-sky"
        },
        {
          day: "Sunday",
          protocol: "Cluster Isolation Verification",
          task: "Ensure that withdrawal addresses for all profits remain strictly partitioned to unique CEX sub-accounts.",
          time: "15 mins",
          cost: "Free",
          guide: "/sybil-checker"
        }
      ]
    }
  };

  let currentBudget = 'zero';

  function renderSchedule() {
    const config = SCHEDULE_DB[currentBudget] || SCHEDULE_DB.zero;
    const daysContainer = document.getElementById('days-container');
    const titleEl = document.getElementById('itinerary-title');
    const statGas = document.getElementById('stat-est-gas');
    const statProtocols = document.getElementById('stat-est-protocols');
    const statPotential = document.getElementById('stat-est-potential');

    if (titleEl) titleEl.textContent = config.title;
    if (statGas) statGas.textContent = config.gas;
    if (statProtocols) statProtocols.textContent = config.protocols;
    if (statPotential) statPotential.textContent = config.potential;

    if (!daysContainer) return;

    daysContainer.innerHTML = config.days.map((item, idx) => `
      <div class="p-5 rounded-2xl border border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-slate-100/60 dark:hover:bg-slate-800/70 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1 flex-1">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-md text-[10px] font-extrabold uppercase bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-300">
              ${item.day}
            </span>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white">
              ${item.protocol}
            </h4>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
            ${item.task}
          </p>
          <div class="flex items-center gap-3 text-[11px] text-slate-400 font-semibold pt-1">
            <span>⏱️ ${item.time}</span>
            <span>•</span>
            <span class="text-emerald-600 dark:text-emerald-400">⛽ ${item.cost}</span>
          </div>
        </div>

        <a href="${item.guide}" class="shrink-0 px-4 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 hover:bg-blue-50 dark:hover:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-slate-200 dark:border-slate-700 transition-colors shadow-2xs">
          Guide &rarr;
        </a>
      </div>
    `).join('');
  }

  // Capital Budget Buttons
  document.querySelectorAll('.capital-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.capital-btn').forEach(b => {
        b.classList.remove('active', 'border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/30');
        b.classList.add('border-slate-200', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900');
      });
      btn.classList.add('active', 'border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/30');
      btn.classList.remove('border-slate-200', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900');
      currentBudget = btn.dataset.budget;
      renderSchedule();
    });
  });

  // Time Buttons
  document.querySelectorAll('.time-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.time-btn').forEach(b => {
        b.classList.remove('active', 'border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/30');
        b.classList.add('border-slate-200', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900');
      });
      btn.classList.add('active', 'border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/30');
      btn.classList.remove('border-slate-200', 'dark:border-slate-800', 'bg-white', 'dark:bg-slate-900');
    });
  });

  // Export iCal (.ics) Handler
  document.getElementById('export-ical-btn')?.addEventListener('click', () => {
    const config = SCHEDULE_DB[currentBudget] || SCHEDULE_DB.zero;
    let icsContent = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Airdroplyx//Farming Planner//EN\nCALSCALE:GREGORIAN\n";
    
    config.days.forEach((item, idx) => {
      icsContent += "BEGIN:VEVENT\n";
      icsContent += `SUMMARY:Airdroplyx: ${item.protocol} (${item.day})\n`;
      icsContent += `DESCRIPTION:${item.task} - Guide: https://airdroplyx.com${item.guide}\n`;
      icsContent += `STATUS:CONFIRMED\n`;
      icsContent += `TRANSP:TRANSPARENT\n`;
      icsContent += "END:VEVENT\n";
    });

    icsContent += "END:VCALENDAR";

    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', `airdroplyx_farming_schedule_${currentBudget}.ics`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  });

  document.getElementById('generate-schedule-btn')?.addEventListener('click', renderSchedule);
  document.addEventListener('DOMContentLoaded', renderSchedule);
</script>
