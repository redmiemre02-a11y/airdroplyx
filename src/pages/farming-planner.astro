---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { airdrops } from '../data/airdrops';

// High-priority protocol references
const topAirdrops = airdrops.filter(a => a.tier === 'Tier 1').slice(0, 40).map(a => ({
  id: a.id,
  name: a.name,
  category: a.category,
  reward: a.reward,
  logo: a.logo,
  status: a.status
}));
---

<Layout 
  title="Airdrop Routine Planner & Strategy Generator | Airdroplyx" 
  description="Generate a personalized, sybil-safe weekly airdrop farming schedule based on your capital and available time. Export directly to your calendar."
>
  <Header />

  <main class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-12 px-4 transition-colors duration-200">
    <div class="max-w-[1200px] mx-auto">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-medium">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <span>/</span>
        <span class="text-blue-600 dark:text-blue-400 font-semibold">Farming Planner</span>
      </nav>

      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <div class="inline-flex items-center gap-2 bg-emerald-100 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase mb-4 border border-emerald-200 dark:border-emerald-800/60 shadow-sm">
          <span>📅</span>
          <span>Farming Routine Architect</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white mb-4">
          Airdrop Farming Routine Planner
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Stop wondering what to do each day. Input your budget and weekly hours to generate a customized, sybil-safe farming itinerary optimized for maximum retroactive ROI.
        </p>
      </div>

      <!-- Main Config & Output Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
        
        <!-- Left: Configuration Form (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-7 border border-slate-200 dark:border-slate-800 shadow-sm space-y-6">
            <h2 class="text-base font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 dark:border-slate-800 pb-3">
              ⚙️ Your Farming Parameters
            </h2>

            <!-- Capital Tier Selector -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2.5">
                1. Available Capital Budget
              </label>
              <div class="grid grid-cols-2 gap-2.5">
                <button type="button" class="capital-btn active p-3 rounded-2xl border-2 border-blue-600 bg-blue-50/50 dark:bg-blue-950/30 text-left transition-all" data-budget="zero">
                  <span class="block text-base font-extrabold text-slate-900 dark:text-white">$0 (Free)</span>
                  <span class="block text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Testnets & DePIN</span>
                </button>
                <button type="button" class="capital-btn p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-left transition-all hover:border-blue-400" data-budget="micro">
                  <span class="block text-base font-extrabold text-slate-900 dark:text-white">$20 - $100</span>
                  <span class="block text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Micro L2s & Swaps</span>
                </button>
                <button type="button" class="capital-btn p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-left transition-all hover:border-blue-400" data-budget="medium">
                  <span class="block text-base font-extrabold text-slate-900 dark:text-white">$100 - $500</span>
                  <span class="block text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">DeFi & Bridges</span>
                </button>
                <button type="button" class="capital-btn p-3 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-left transition-all hover:border-blue-400" data-budget="whale">
                  <span class="block text-base font-extrabold text-slate-900 dark:text-white">$1,000+ (Whale)</span>
                  <span class="block text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Restaking & LP Vaults</span>
                </button>
              </div>
            </div>

            <!-- Time Availability Selector -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2.5">
                2. Weekly Time Commitment
              </label>
              <div class="grid grid-cols-3 gap-2">
                <button type="button" class="time-btn active p-2.5 rounded-xl border-2 border-blue-600 bg-blue-50/50 dark:bg-blue-950/30 text-center transition-all" data-hours="casual">
                  <span class="block text-xs font-bold text-slate-900 dark:text-white">1 - 3 Hours</span>
                  <span class="block text-[10px] text-slate-500 dark:text-slate-400">Casual</span>
                </button>
                <button type="button" class="time-btn p-2.5 rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-center transition-all hover:border-blue-400" data-hours="active">
                  <span class="block text-xs font-bold text-slate-900 dark:text-white">4 - 8 Hours</span>
                  <span class="block text-[10px] text-slate-500 dark:text-slate-400">Regular</span>
                </button>
                <button type="button" class="time-btn p-2.5 rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-center transition-all hover:border-blue-400" data-hours="hardcore">
                  <span class="block text-xs font-bold text-slate-900 dark:text-white">10+ Hours</span>
                  <span class="block text-[10px] text-slate-500 dark:text-slate-400">Grinder</span>
                </button>
              </div>
            </div>

            <!-- Target Ecosystem Focus -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2.5">
                3. Ecosystem Focus
              </label>
              <div class="flex flex-wrap gap-1.5" id="ecosystem-tags">
                <button type="button" class="eco-pill active px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white transition-all shadow-sm" data-eco="all">All Ecosystems</button>
                <button type="button" class="eco-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 transition-all" data-eco="evm">Parallel EVM & L2s</button>
                <button type="button" class="eco-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 transition-all" data-eco="btc">Bitcoin L2s & Runes</button>
                <button type="button" class="eco-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 transition-all" data-eco="depin">DePIN & AI</button>
              </div>
            </div>

            <!-- Generate Button -->
            <button id="generate-schedule-btn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-extrabold py-3.5 px-6 rounded-2xl shadow-xl shadow-blue-500/25 transition-all text-sm flex items-center justify-center gap-2">
              <span>✨</span>
              <span>Generate Weekly Farming Itinerary</span>
            </button>
          </div>

          <!-- Anti-Sybil Timing Guidelines Box -->
          <div class="bg-gradient-to-br from-amber-50 to-orange-50 dark:from-slate-900 dark:to-slate-850 p-6 rounded-3xl border border-amber-200/80 dark:border-amber-900/40 text-xs shadow-sm">
            <h4 class="font-bold text-amber-900 dark:text-amber-400 mb-2 flex items-center gap-1.5 text-sm">
              <span>🛡️</span>
              <span>Planner Anti-Sybil Rule</span>
            </h4>
            <p class="text-amber-950 dark:text-slate-300 leading-relaxed mb-3">
              Never execute identical tasks across multiple wallets on the same calendar day. Spread your wallets across the week to maximize distinct active days/weeks while keeping execution intervals unpredictable.
            </p>
            <a href="/sybil-checker" class="text-amber-700 dark:text-amber-400 font-bold hover:underline flex items-center gap-1">
              <span>Check your wallet risk score</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Right: Generated Weekly Itinerary (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-sm">
            
            <!-- Itinerary Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100 dark:border-slate-800 mb-6">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Weekly Itinerary</span>
                <h3 class="text-xl font-black text-slate-900 dark:text-white" id="itinerary-title">
                  Zero Capital & Testnet Protocol Routine
                </h3>
              </div>

              <!-- Export Calendar Button -->
              <div class="flex items-center gap-2">
                <button id="export-ical-btn" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-all flex items-center gap-1.5 shadow-sm">
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  <span>Export to iCal / Calendar</span>
                </button>
              </div>
            </div>

            <!-- Estimated Itinerary Overview Stats -->
            <div class="grid grid-cols-3 gap-3 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 mb-6 text-center">
              <div>
                <span class="text-[11px] font-semibold text-slate-400 block uppercase">Est. Weekly Gas</span>
                <span class="text-base font-extrabold text-slate-900 dark:text-white" id="stat-est-gas">$0.00</span>
              </div>
              <div>
                <span class="text-[11px] font-semibold text-slate-400 block uppercase">Weekly Protocols</span>
                <span class="text-base font-extrabold text-blue-600 dark:text-blue-400" id="stat-est-protocols">7 Targets</span>
              </div>
              <div>
                <span class="text-[11px] font-semibold text-slate-400 block uppercase">Qualifying Potential</span>
                <span class="text-base font-extrabold text-emerald-600 dark:text-emerald-400" id="stat-est-potential">Tier 1 Drops</span>
              </div>
            </div>

            <!-- Day-by-Day Task Schedule Container -->
            <div class="space-y-4" id="days-container">
              <!-- Dynamically populated via script -->
            </div>

          </div>
        </div>

      </div>

    </div>
  </main>
</Layout>

<script is:inline>
  // Schedule Templates Based on Configuration
  const SCHEDULE_DB = {
    zero: {
