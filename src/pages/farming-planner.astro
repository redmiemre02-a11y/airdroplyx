        }
      ]
    },
    whale: {
      title: "Whale Capital ($1,000+) Institutional Vaults Routine",
      gas: "~$5.00 - $15.00 / week",
      protocols: "10+ Protocols",
      potential: "$10,000 - $50,000+",
      days: [
        {
          day: "Monday",
          protocol: "Hyperliquid HLP Liquidity Vault",
          task: "Allocate capital into HLP liquidity provider vault, harvesting platform market-making revenue and daily points.",
          time: "10 mins",
          cost: "Zero gas",
          guide: "/airdrop/hyperliquid"
        },
        {
          day: "Tuesday",
          protocol: "Liquity V2 BOLD Stablecoin",
