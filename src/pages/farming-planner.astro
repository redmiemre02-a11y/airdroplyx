      potential: "$1,500 - $6,000+",
      days: [
        {
          day: "Monday",
          protocol: "Base L2 Organic Activity",
          task: "Execute $10 swap on Aerodrome, bridge a small fraction via Across Protocol to generate cross-chain intent volume.",
          time: "10 mins",
          cost: "< $0.05",
          guide: "/airdrop/aerodrome-finance"
        },
        {
          day: "Tuesday",
          protocol: "Linea zkEVM LXP Voyage",
          task: "Supply $20 USDC on ZeroLend or Nile, borrow $5 against collateral, and hold position to accumulate LXP.",
          time: "15 mins",
          cost: "~$0.12",
          guide: "/airdrop/linea"
        },
        {
          day: "Wednesday",
          protocol: "Jumper Exchange & Li.Fi",
          task: "Perform 1 cross-chain route between Arbitrum and Base, maximizing routing diversity with minimal slippage.",
          time: "10 mins",
          cost: "~$0.15",
          guide: "/airdrop/jumper-exchange"
        },
        {
          day: "Thursday",
          protocol: "Scroll zkEVM Marks",
          task: "Swap $15 on Ambient DEX, hold native ETH balance above 0.005 ETH to maintain sybil safety threshold.",
          time: "10 mins",
          cost: "~$0.10",
          guide: "/airdrop/scroll"
        },
        {
          day: "Friday",
          protocol: "Hyperliquid Spot DEX",
          task: "Place 1 limit buy order on Hyperliquid spot market (e.g. PURR or HYPE pair) to register organic volume.",
          time: "10 mins",
          cost: "< $0.02",
          guide: "/airdrop/hyperliquid"
        },
