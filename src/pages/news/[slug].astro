---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { newsArticles } from '../../data/news';
import { airdrops } from '../../data/airdrops';

export function getStaticPaths() {
  return newsArticles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const otherArticles = newsArticles.filter(a => a.slug !== article.slug).slice(0, 3);
const relatedAirdrop = article.relatedAirdropId ? airdrops.find(a => a.id === article.relatedAirdropId) : null;

// Parse accurate ISO 8601 timestamps for Google News
const parsedDate = new Date(article.date);
const publishDate = !isNaN(parsedDate.getTime()) ? parsedDate.toISOString() : '2026-10-28T12:00:00.000Z';
const wordCount = article.content.split(/\s+/).length;
const readTime = article.readTime || `${Math.max(1, Math.ceil(wordCount / 200))} min read`;

// Key takeaways for Google News snippet optimization
const keyTakeaways = [
  article.excerpt,
  `Category: ${article.category} reporting verified by Airdroplyx on-chain research intelligence.`,
  article.relatedAirdropId 
    ? `Directly impacts prospective eligibility criteria for the ${article.relatedAirdropId} network.` 
    : `Continuously tracked for retroactive community snapshot updates.`
];
---

<Layout 
  title={`${article.title} | Web3 Airdrop News | Airdroplyx`} 
  description={article.excerpt}
  image={article.image}
>
  <!-- Schema.org JSON-LD (Google News Compliant NewsArticle & Breadcrumbs) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://airdroplyx.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "News & Alpha",
            "item": "https://airdroplyx.com/news/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": article.title,
            "item": `https://airdroplyx.com/news/${article.slug}/`
          }
        ]
      },
      {
        "@type": "NewsArticle",
        "headline": article.title,
        "description": article.excerpt,
        "image": {
          "@type": "ImageObject",
          "url": article.image,
          "width": 1200,
          "height": 675
        },
        "datePublished": publishDate,
        "dateModified": publishDate,
        "wordCount": wordCount,
        "inLanguage": "en-US",
        "author": {
          "@type": "Person",
          "name": article.author,
          "jobTitle": "Web3 & Cryptocurrency Research Journalist",
          "worksFor": {
            "@type": "NewsMediaOrganization",
            "name": "Airdroplyx News",
            "url": "https://airdroplyx.com"
          }
        },
        "publisher": {
          "@type": "NewsMediaOrganization",
          "name": "Airdroplyx News",
          "url": "https://airdroplyx.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://airdroplyx.com/logo.jpg",
            "width": 512,
            "height": 512
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": `https://airdroplyx.com/news/${article.slug}/`
        }
      }
    ]
  })} />

  <Header />

  <main class="max-w-[900px] mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/news" class="hover:text-slate-900 dark:hover:text-white transition-colors">News</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white line-clamp-1">{article.title}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-900/40 text-xs font-black uppercase px-3 py-1 rounded-full">
          {article.category}
        </span>
        <span class="text-xs text-slate-400 font-medium">{readTime} • {wordCount} words</span>
        <a href="/fact-checking" class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800/40 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition-colors">
          <span>✓</span> Fact-Checked &amp; Verified
        </a>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-6">
        {article.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed mb-6 font-medium">
        {article.excerpt}
      </p>

      <div class="flex items-center gap-3 pt-6 border-t border-slate-100 dark:border-slate-800 text-sm text-slate-500">
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-md">
          AL
        </div>
        <div>
          <div class="font-bold text-slate-900 dark:text-white">{article.author}</div>
          <div class="text-xs text-slate-400">
            Published <time datetime={publishDate}>{article.date}</time> • <a href="/editorial-policy" class="hover:text-blue-500 underline underline-offset-2 transition-colors">Editorial Standards Compliant</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Executive Summary / Key Takeaways Box (Google News Friendly) -->
    <section class="bg-slate-50 dark:bg-slate-850/80 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-7 mb-10 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-lg">⚡</span>
        <h2 class="text-base font-black text-slate-900 dark:text-white uppercase tracking-wider">
          Key Takeaways &amp; Executive Summary
        </h2>
      </div>
      <ul class="space-y-2 text-sm sm:text-base text-slate-700 dark:text-slate-300">
        {keyTakeaways.map(point => (
          <li class="flex items-start gap-2.5">
            <span class="text-blue-600 dark:text-blue-400 font-bold shrink-0 mt-0.5">•</span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Main Hero Image (Strict 1200x675 16:9 Google News Specs) -->
    <div class="rounded-3xl overflow-hidden aspect-video bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xl mb-12">
      <img 
        src={article.image} 
        alt={article.title} 
        class="w-full h-full object-cover"
        loading="eager"
        width="1200"
        height="675"
      />
    </div>

    <!-- Article Content with Markdown Parsing (Headings, Quotes, Lists, Paragraphs) -->
    <article class="prose prose-slate dark:prose-invert max-w-none mb-12 text-slate-800 dark:text-slate-200">
      {article.content.split('\n\n').map(block => {
        const trimmed = block.trim();
        if (trimmed.startsWith('### ')) {
          return <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mt-8 mb-3 tracking-tight">{trimmed.replace(/^###\s+/, '')}</h3>;
        } else if (trimmed.startsWith('## ')) {
          return <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white mt-10 mb-4 tracking-tight border-b border-slate-100 dark:border-slate-800 pb-2">{trimmed.replace(/^##\s+/, '')}</h2>;
        } else if (trimmed.startsWith('> ')) {
          return <blockquote class="border-l-4 border-blue-500 pl-4 py-2 italic text-slate-700 dark:text-slate-200 my-6 bg-blue-50/50 dark:bg-slate-800/50 rounded-r-xl">{trimmed.replace(/^>\s+/, '')}</blockquote>;
        } else if (trimmed.startsWith('- ')) {
          const items = trimmed.split('\n').map(l => l.replace(/^-\s+/, ''));
          return (
            <ul class="list-disc list-inside space-y-2.5 my-5 text-slate-700 dark:text-slate-300 text-base sm:text-lg">
              {items.map(it => <li>{it}</li>)}
            </ul>
          );
        } else {
          return (
            <p class="text-base sm:text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-6 font-normal">
              {trimmed}
            </p>
          );
        }
      })}
    </article>

    <!-- Tags -->
    <div class="flex flex-wrap items-center gap-2 pt-6 border-t border-slate-200 dark:border-slate-800 mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-2">Tags:</span>
      {article.tags.map(tag => (
        <span class="text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-3 py-1.5 rounded-xl border border-slate-200/60 dark:border-slate-700/60">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Editorial & Regulatory News Disclaimer -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 mb-12">
      <div class="flex items-start gap-3">
        <span class="text-xl">⚖️</span>
        <div class="text-xs text-slate-500 dark:text-slate-400 space-y-1 leading-relaxed">
          <p><strong class="text-slate-700 dark:text-slate-300">Editorial Disclaimer:</strong> This news report is published strictly for objective industry monitoring and informational research purposes. None of the token developments, testnet announcements, or protocol metrics mentioned constitute investment, legal, or financial advice.</p>
          <p>Airdroplyx is an independent aggregator and does not guarantee airdrop allocations or token values. Cryptocurrency transactions carry technical and market risks. Always DYOR. <a href="/disclaimer" class="underline text-blue-600 dark:text-blue-400 font-medium">Read our full Risk Disclaimer &rarr;</a></p>
        </div>
      </div>
    </div>

    <!-- High-Converting Related Airdrop Internal Link Banner -->
    {relatedAirdrop && (
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-slate-800 dark:to-slate-850 border border-blue-200/80 dark:border-blue-900/40 rounded-3xl p-6 sm:p-8 mb-14 shadow-md flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <img 
            src={relatedAirdrop.logo} 
            alt={relatedAirdrop.name} 
            class="w-16 h-16 rounded-2xl shadow-md object-cover bg-white p-1"
          />
          <div>
            <div class="inline-block text-[11px] font-black uppercase text-blue-600 dark:text-blue-400 tracking-wider mb-1">
              Active Verified Opportunity
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white">
              {relatedAirdrop.name} Airdrop Guide
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
              Potential Reward: <span class="font-bold text-emerald-600 dark:text-emerald-400">{relatedAirdrop.reward}</span> • Stage: {relatedAirdrop.stage}
            </p>
          </div>
        </div>
        <a 
          href={`/airdrop/${relatedAirdrop.id}`} 
          class="w-full sm:w-auto text-center whitespace-nowrap bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm px-6 py-3 rounded-full transition-all shadow-lg shadow-blue-600/30"
        >
          View Full Guide →
        </a>
      </div>
    )}

    <!-- More Breaking Stories -->
    <div class="pt-10 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-2xl font-black text-slate-900 dark:text-white mb-6 tracking-tight">
        More Breaking Airdrop News
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {otherArticles.map(other => (
          <a href={`/news/${other.slug}`} class="group flex flex-col bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200 dark:border-slate-700/80 shadow-sm hover:shadow-md transition-all">
            <div class="aspect-video w-full rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-700 mb-3">
              <img src={other.image} alt={other.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            </div>
            <span class="text-[10px] font-bold uppercase text-rose-600 dark:text-rose-400 mb-1">{other.category}</span>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug">
              {other.title}
            </h4>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
