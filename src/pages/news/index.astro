---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { newsArticles } from '../../data/news';

const allNews = [...newsArticles].reverse();
const featuredNews = allNews[0];
const otherNews = allNews.slice(1);
---

<Layout 
  title={`Web3 Crypto Airdrop News & Daily Alpha Intel (2026) | Airdroplyx`} 
  description="Breaking Web3 crypto airdrop news, TGE dates, testnet announcements, snapshot deadlines, and institutional alpha intelligence updated daily."
>
  <Header />

  <!-- Schema.org JSON-LD (News Media Organization & Breadcrumbs) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://airdroplyx.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "News & Alpha",
            "item": "https://airdroplyx.com/news/"
          }
        ]
      },
      {
        "@type": "CollectionPage",
        "name": "Web3 Crypto Airdrop News & Daily Alpha Intel",
        "description": "Breaking Web3 crypto airdrop news, TGE alerts, and testnet announcements.",
        "url": "https://airdroplyx.com/news/"
      }
    ]
  })} />

  <main class="max-w-[1200px] mx-auto px-4 py-12">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 text-xs font-black uppercase tracking-widest px-3.5 py-1.5 rounded-full border border-rose-200 dark:border-rose-900/50 mb-4">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        Live Alpha & News Radar
      </div>
      <h1 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4 tracking-tight">
        Daily Web3 Airdrop News
      </h1>
      <p class="text-base md:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Breaking TGE announcements, snapshot verification deadlines, testnet incentives, and institutional alpha delivered directly from on-chain data.
      </p>
    </div>

    <!-- Featured Breaking News Hero -->
    {featuredNews && (
      <div class="mb-14">
        <article class="bg-gradient-to-br from-slate-900 via-slate-900 to-blue-950 rounded-3xl border border-slate-800 overflow-hidden shadow-2xl group grid grid-cols-1 lg:grid-cols-12 text-white">
          <div class="lg:col-span-7 aspect-video lg:aspect-auto overflow-hidden relative">
            <img 
              src={featuredNews.image} 
              alt={featuredNews.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90"
              loading="eager"
            />
            <div class="absolute top-4 left-4">
              <span class="bg-rose-600 text-white text-xs font-black uppercase px-3 py-1.5 rounded-full shadow-lg">
                {featuredNews.category}
              </span>
            </div>
          </div>
          <div class="lg:col-span-5 p-8 lg:p-10 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 text-xs text-slate-400 mb-3">
                <span>{featuredNews.author}</span>
                <span>•</span>
                <span>{featuredNews.date}</span>
                <span>•</span>
                <span class="text-blue-400 font-semibold">{featuredNews.readTime}</span>
              </div>
              <h2 class="text-2xl lg:text-3xl font-extrabold text-white group-hover:text-blue-400 transition-colors mb-4 leading-snug">
                <a href={`/news/${featuredNews.slug}`}>
                  {featuredNews.title}
                </a>
              </h2>
              <p class="text-slate-300 text-sm md:text-base leading-relaxed mb-6">
                {featuredNews.excerpt}
              </p>
            </div>
            <div class="pt-6 border-t border-slate-800 flex items-center justify-between">
              <div class="flex flex-wrap gap-2">
                {featuredNews.tags.slice(0, 3).map(tag => (
                  <span class="text-[11px] font-medium bg-slate-800 text-slate-300 px-2.5 py-1 rounded-lg">
                    #{tag}
                  </span>
                ))}
              </div>
              <a href={`/news/${featuredNews.slug}`} class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm px-5 py-2.5 rounded-full transition-all flex items-center gap-1.5 shadow-lg shadow-blue-600/30">
                Read Intel →
              </a>
            </div>
          </div>
        </article>
      </div>
    )}

    <!-- News Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {otherNews.map((article) => (
        <article class="bg-white dark:bg-slate-800 rounded-3xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col">
          <a href={`/news/${article.slug}`} class="aspect-video w-full overflow-hidden bg-slate-100 block relative">
            <img 
              src={article.image} 
              alt={article.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <span class="absolute top-3 left-3 text-[11px] font-black uppercase px-2.5 py-1 rounded-full shadow-md bg-white/90 dark:bg-slate-900/90 backdrop-blur-md text-slate-900 dark:text-white">
              {article.category}
            </span>
          </a>
          
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-3 text-xs text-slate-400">
                <span>{article.date}</span>
                <span>•</span>
                <span class="text-blue-600 dark:text-blue-400 font-semibold">{article.readTime}</span>
              </div>
              <h2 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 transition-colors mb-3 leading-snug">
                <a href={`/news/${article.slug}`}>
                  {article.title}
                </a>
              </h2>
              <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed mb-4">
                {article.excerpt}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 dark:border-slate-700/60 mt-4 flex items-center justify-between">
              <span class="text-xs text-slate-400 font-medium">By {article.author}</span>
              <a href={`/news/${article.slug}`} class="text-sm font-bold text-blue-600 hover:text-blue-700 dark:text-blue-400 flex items-center gap-1">
                Read Story →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
