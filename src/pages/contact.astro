---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Contact Us | Airdroplyx" description="Contact the Airdroplyx research team for project submissions, partnership inquiries, or to report suspicious airdrops.">
  <Header />
  <main class="max-w-[850px] mx-auto px-4 py-16">
    <div class="prose prose-slate dark:prose-invert mb-8 max-w-none">
      <h1 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white">Contact Us</h1>
      <p class="text-slate-600 dark:text-slate-300">
        Have a question, partnership inquiry, bug report, or want to report an unverified or scam airdrop? We would love to hear from you. Fill out the contact form below or email us directly at 
        <a href="mailto:emretknis0@gmail.com" class="text-blue-600 dark:text-blue-400 font-bold hover:underline">emretknis0@gmail.com</a>. Our team usually reviews and responds within 24 to 48 hours.
      </p>
    </div>

    <!-- Contact Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col justify-between">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
            ✉️
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-bold">Direct Email</div>
            <div class="text-sm font-bold text-slate-900 dark:text-white break-all">emretknis0@gmail.com</div>
          </div>
        </div>
        <a href="mailto:emretknis0@gmail.com" class="mt-3 text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
          Send Email Directly &rarr;
        </a>
      </div>

      <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col justify-between">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg">
            ⚡
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-bold">Response Time</div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">Within 24-48 Hours</div>
          </div>
        </div>
        <span class="mt-3 text-xs text-slate-400 font-medium">
          Editorial & Verification review
        </span>
      </div>

      <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col justify-between">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">
            🛡️
          </div>
          <div>
            <div class="text-xs uppercase tracking-wider text-slate-400 font-bold">Scam Reports</div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">Priority Triage</div>
          </div>
        </div>
        <a href="mailto:emretknis0@gmail.com?subject=Urgent%20Scam%20Report" class="mt-3 text-xs font-bold text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1">
          Report Fake Contract &rarr;
        </a>
      </div>
    </div>
    
    <div class="bg-white dark:bg-slate-800 p-8 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">Send an On-Site Message</h2>
      <form id="contact-form" class="flex flex-col gap-6">
        <div>
          <label class="block text-sm font-bold text-slate-700 dark:text-slate-200 mb-2">Name</label>
          <input type="text" id="contact-name" required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="Your Name" />
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 dark:text-slate-200 mb-2">Email</label>
          <input type="email" id="contact-email" required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="your@email.com" />
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 dark:text-slate-200 mb-2">Message</label>
          <textarea id="contact-message" rows="5" required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="How can our research team assist you?"></textarea>
        </div>
        <button type="submit" id="contact-submit-btn" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg shadow-blue-500/25 transition-all self-start text-sm">
          Send Message
        </button>
        <div id="contact-status" class="hidden text-sm font-bold p-4 rounded-xl"></div>
      </form>
    </div>
  </main>

  <script is:inline>
    const contactForm = document.getElementById('contact-form');
    const contactStatus = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit-btn');

    if (contactForm && contactStatus && submitBtn) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        setTimeout(() => {
          contactStatus.classList.remove('hidden');
          contactStatus.className = 'text-sm font-bold p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
          contactStatus.textContent = 'Thank you! Your message has been received. Our editorial team will review your inquiry shortly.';
          contactForm.reset();
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }, 600);
      });
    }
  </script>
</Layout>
