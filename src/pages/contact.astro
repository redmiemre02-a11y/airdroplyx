---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Contact Us | Airdroplyx">
  <Header />
  <main class="max-w-[800px] mx-auto px-4 py-16">
    <div class="prose prose-slate mb-8">
      <h1>Contact Us</h1>
      <p>Have a question, partnership inquiry, or want to report a scam? We'd love to hear from you. Fill out the form below and our team will get back to you within 24-48 hours.</p>
    </div>
    
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
      <form class="flex flex-col gap-6">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">Name</label>
          <input type="text" class="w-full border border-slate-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Your Name" />
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">Email</label>
          <input type="email" class="w-full border border-slate-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="your@email.com" />
        </div>
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">Message</label>
          <textarea rows="5" class="w-full border border-slate-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="How can we help you?"></textarea>
        </div>
        <button type="button" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl transition-colors">
          Send Message
        </button>
      </form>
    </div>
  </main>
</Layout>
