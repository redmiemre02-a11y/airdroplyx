---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { localizedAcademyPages } from '../../../data/localizedAcademy';
import { academyArticles } from '../../../data/academy';

export function getStaticPaths() {
  return localizedAcademyPages.map(page => ({
    params: { lang: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;

const alternates = [
  { lang: 'en', href: 'https://airdroplyx.com/academy/' },
  ...localizedAcademyPages.map(p => ({
    lang: p.lang,
    href: `https://airdroplyx.com/${p.slug}/academy/`
  })),
  { lang: 'x-default', href: 'https://airdroplyx.com/academy/' }
];
---

<Layout
  lang={page.lang}
  title={page.title}
  description={page.description}
  alternates={alternates}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": page.homeLabel, "item": "https://airdroplyx.com/" },
      { "@type": "ListItem", "position": 2, "name": page.breadcrumbLabel, "item": `https://airdroplyx.com/${page.slug}/academy/` }
    ]
  })} />

  <Header />

  <main class="max-w-[1150px] mx-auto px-4 py-12">
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 dark:hover:text-white">{page.homeLabel}</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white">{page.breadcrumbLabel}</span>
    </nav>

    <header class="bg-gradient-to-br from-slate-900 via-emerald-950 to-slate-900 text-white rounded-3xl p-8 md:p-12 mb-10 border border-emerald-500/20 shadow-xl">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-4">
        {page.flag} {page.badge}
      </span>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4 leading-tight">{page.h1}</h1>
      <p class="text-slate-300 text-base md:text-lg max-w-3xl leading-relaxed mb-6">{page.intro}</p>

      <div class="flex flex-wrap gap-3 mb-6">
        <a href={page.telegramHref} class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-5 py-3 rounded-xl text-sm transition-colors">
          {page.telegramBtn} →
        </a>
        <a href={page.testnetHref} class="bg-white/10 hover:bg-white/20 text-white font-bold px-5 py-3 rounded-xl text-sm border border-white/15 transition-colors">
          {page.testnetBtn} →
        </a>
      </div>

      <div class="flex flex-wrap gap-2">
        <a href="/academy/" class="px-3 py-1.5 rounded-lg text-xs font-bold border bg-white/10 border-white/15 text-slate-200 hover:bg-white/20">🇬🇧 EN</a>
        {localizedAcademyPages.map(p => (
          <a
            href={`/${p.slug}/academy/`}
            class={`px-3 py-1.5 rounded-lg text-xs font-bold border ${p.slug === page.slug ? 'bg-emerald-600 border-emerald-500 text-white' : 'bg-white/10 border-white/15 text-slate-200 hover:bg-white/20'}`}
          >
            {p.flag} {p.slug.toUpperCase()}
          </a>
        ))}
      </div>
    </header>

    <section class="mb-14">
      <h2 class="text-2xl font-black text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-700 pb-4 mb-6">
        {page.lessonsHeading}
      </h2>
      <div class="space-y-6">
        {page.lessons.map(lesson => (
          <article class="bg-white dark:bg-slate-800 rounded-2xl p-6 md:p-7 border border-slate-200 dark:border-slate-700 shadow-sm">
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">{lesson.title}</h3>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-4">{lesson.summary}</p>
            <ul class="space-y-2 mb-5">
              {lesson.keyPoints.map(pt => (
                <li class="flex items-start gap-2.5 text-sm text-slate-700 dark:text-slate-200">
                  <span class="text-emerald-500 font-bold shrink-0">✓</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
            <a href={`/academy/${lesson.slug}/`} class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline">
              {page.readFullLabel} →
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-slate-50 dark:bg-slate-800/50 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700">
      <h2 class="text-2xl font-black text-slate-900 dark:text-white mb-2">{page.fullArchiveHeading}</h2>
      <p class="text-sm text-slate-600 dark:text-slate-300 mb-6">{page.fullArchiveDesc}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {academyArticles.map(art => (
          <a href={`/academy/${art.slug}/`} class="p-3.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-700/80 hover:border-emerald-500 transition-colors text-xs font-bold text-slate-800 dark:text-slate-200 truncate">
            {art.title}
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
