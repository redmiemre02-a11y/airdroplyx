---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import { localizedAirdropGuides } from '../../../../data/localizedAirdropGuides';
import { airdrops } from '../../../../data/airdrops';

export function getStaticPaths() {
  return localizedAirdropGuides.map(guide => ({
    params: { lang: guide.slug, id: guide.id },
    props: { guide }
  }));
}

const { guide } = Astro.props;
const baseAirdrop = airdrops.find(a => a.id === guide.id)!;
const sameProjectGuides = localizedAirdropGuides.filter(g => g.id === guide.id);

const alternates = [
  { lang: 'en', href: `https://airdroplyx.com/airdrop/${guide.id}/` },
  ...sameProjectGuides.map(g => ({
    lang: g.lang,
    href: `https://airdroplyx.com/${g.slug}/airdrop/${g.id}/`
  })),
  { lang: 'x-default', href: `https://airdroplyx.com/airdrop/${guide.id}/` }
];

const canonicalAbs = `https://airdroplyx.com/${guide.slug}/airdrop/${guide.id}/`;
---

<Layout
  lang={guide.lang}
  title={guide.title}
  description={guide.description}
  image={baseAirdrop.logo}
  alternates={alternates}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": guide.homeLabel, "item": "https://airdroplyx.com/" },
          { "@type": "ListItem", "position": 2, "name": guide.hubLabel, "item": `https://airdroplyx.com${guide.hubHref}` },
          { "@type": "ListItem", "position": 3, "name": baseAirdrop.name, "item": canonicalAbs }
        ]
      },
      {
        "@type": "HowTo",
        "name": guide.h1,
        "description": guide.description,
        "image": "https://airdroplyx.com/logo.jpg",
        "step": guide.steps.map((s, idx) => ({
          "@type": "HowToStep",
          "position": idx + 1,
          "text": s
        }))
      },
      {
        "@type": "FAQPage",
        "mainEntity": guide.faqs.map(f => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <Header />

  <main class="max-w-[950px] mx-auto px-4 py-12">
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 dark:hover:text-white">{guide.homeLabel}</a>
      <span>/</span>
      <a href={guide.hubHref} class="hover:text-slate-900 dark:hover:text-white">{guide.hubLabel}</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white">{baseAirdrop.name}</span>
    </nav>

    <header class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-10 border border-slate-200 dark:border-slate-700 shadow-sm mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-5 mb-6">
        <img src={baseAirdrop.logo} alt={baseAirdrop.name} width="72" height="72" class="w-18 h-18 rounded-2xl object-cover bg-slate-50 p-1.5 border border-slate-200 dark:border-slate-700 shrink-0" />
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50 px-3 py-1 rounded-full border border-blue-200 dark:border-blue-800 mb-2">
            {guide.flag} {guide.badge}
          </span>
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white leading-tight">{guide.h1}</h1>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-700/70">
          <div class="text-slate-400 font-bold uppercase">{guide.rewardLabel}</div>
          <div class="font-bold text-slate-900 dark:text-white mt-0.5">{baseAirdrop.reward}</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-700/70">
          <div class="text-slate-400 font-bold uppercase">{guide.costLabel}</div>
          <div class="font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">{baseAirdrop.cost || 'Free ($0)'}</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-700/70">
          <div class="text-slate-400 font-bold uppercase">{guide.snapshotLabel}</div>
          <div class="font-bold text-slate-900 dark:text-white mt-0.5">{baseAirdrop.snapshot || 'Q1 2027'}</div>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-700/70">
          <div class="text-slate-400 font-bold uppercase">{guide.timeLabel}</div>
          <div class="font-bold text-slate-900 dark:text-white mt-0.5">{baseAirdrop.timeCommitment || '3 mins / day'}</div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <a href={baseAirdrop.refLink} target="_blank" rel="noopener noreferrer" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-3 rounded-xl text-sm transition-colors">
          {guide.ctaText} →
        </a>
        <a href={`/airdrop/${guide.id}/`} class="bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-800 dark:text-white font-bold px-4 py-3 rounded-xl text-xs transition-colors">
          🇬🇧 {guide.englishVersionLabel}
        </a>
      </div>

      <div class="flex flex-wrap gap-1.5 pt-4 border-t border-slate-100 dark:border-slate-700">
        {sameProjectGuides.map(g => (
          <a
            href={`/${g.slug}/airdrop/${g.id}/`}
            class={`px-2.5 py-1 rounded-lg text-[11px] font-bold border ${g.slug === guide.slug ? 'bg-blue-600 border-blue-500 text-white' : 'bg-slate-50 dark:bg-slate-900/50 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-blue-400'}`}
          >
            {g.flag} {g.slug.toUpperCase()}
          </a>
        ))}
      </div>
    </header>

    <div class="space-y-8">
      <section class="bg-white dark:bg-slate-800 rounded-2xl p-6 md:p-8 border border-slate-200 dark:border-slate-700">
        <h2 class="text-xl font-black text-slate-900 dark:text-white mb-3">{guide.overviewHeading}</h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-5">{guide.overview}</p>
        <h3 class="text-lg font-extrabold text-slate-900 dark:text-white mb-2">{guide.tokenomicsHeading}</h3>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">{guide.tokenomics}</p>
      </section>

      <section class="bg-white dark:bg-slate-800 rounded-2xl p-6 md:p-8 border border-slate-200 dark:border-slate-700">
        <h2 class="text-xl font-black text-slate-900 dark:text-white mb-4">{guide.stepsHeading}</h2>
        <ol class="space-y-3">
          {guide.steps.map((step, i) => (
            <li class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-700/70">
              <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-black flex items-center justify-center shrink-0 mt-0.5">{i + 1}</span>
              <span class="text-sm sm:text-base text-slate-700 dark:text-slate-200 leading-relaxed">{step}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="p-6 rounded-2xl bg-blue-50/70 dark:bg-blue-950/30 border border-blue-200/80 dark:border-blue-900/50">
          <h2 class="text-lg font-black text-blue-900 dark:text-blue-200 mb-2">🎯 {guide.strategyHeading}</h2>
          <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">{guide.strategy}</p>
        </div>
        <div class="p-6 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-900/50">
          <h2 class="text-lg font-black text-emerald-900 dark:text-emerald-200 mb-2">🛡️ {guide.sybilHeading}</h2>
          <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">{guide.sybilSafety}</p>
        </div>
      </section>

      <section class="bg-white dark:bg-slate-800 rounded-2xl p-6 md:p-8 border border-slate-200 dark:border-slate-700">
        <h2 class="text-xl font-black text-slate-900 dark:text-white mb-4">{guide.faqHeading}</h2>
        <div class="space-y-3">
          {guide.faqs.map(f => (
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-700/70">
              <h3 class="font-bold text-slate-900 dark:text-white text-sm sm:text-base mb-1">{f.q}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
