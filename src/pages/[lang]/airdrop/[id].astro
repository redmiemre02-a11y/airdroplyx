---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { i18n_airdrops } from '../../../data/i18n_airdrops';

export function getStaticPaths() {
  const langs = ['en', 'tr', 'ru', 'es', 'hi', 'id', 'vi', 'pt', 'zh', 'tl'];
  return langs.flatMap(lang => {
    const drops = i18n_airdrops[lang] || i18n_airdrops.en;
    return drops.map(airdrop => ({
      params: { lang, id: airdrop.id },
      props: { airdrop }
    }));
  });
}

const { lang, id } = Astro.params;
const { airdrop } = Astro.props;
const allDrops = i18n_airdrops[lang] || i18n_airdrops.en;
const relatedAirdrops = allDrops.filter(a => a.id !== airdrop.id).slice(0, 3);

const uiTranslations = {
  en: { steps: 'Step-by-Step Airdrop Guide', overview: 'Project Overview & Funding', metric: 'Metric', details: 'Details', funding: 'Total Funding', investors: 'Lead Investors', allocation: 'Airdrop Allocation', blockchain: 'Blockchain', strategy: 'Editor\'s Airdrop Strategy', faq: 'Frequently Asked Questions', sentiment: 'What\'s your sentiment on', sentimentSub: 'Join 2,451 other hunters in predicting the airdrop size.', bullish: 'Bullish', bearish: 'Bearish' },
  tr: { steps: 'Adım Adım Airdrop Rehberi', overview: 'Proje Özeti ve Fonlama', metric: 'Metrik', details: 'Detaylar', funding: 'Toplanan Fon', investors: 'Lider Yatırımcılar', allocation: 'Airdrop Payı', blockchain: 'Ağ (Blockchain)', strategy: 'Editörün Airdrop Stratejisi', faq: 'Sıkça Sorulan Sorular', sentiment: 'Hakkındaki düşünceniz nedir?', sentimentSub: 'Airdrop potansiyelini tahmin eden 2.451 avcıya katılın.', bullish: 'Kazandırır', bearish: 'Zaman Kaybı' },
  ru: { steps: 'Пошаговое руководство', overview: 'Обзор проекта и финансирование', metric: 'Метрика', details: 'Детали', funding: 'Общее финансирование', investors: 'Главные инвесторы', allocation: 'Доля Airdrop', blockchain: 'Блокчейн', strategy: 'Стратегия редактора', faq: 'Часто задаваемые вопросы', sentiment: 'Что вы думаете о', sentimentSub: 'Присоединяйтесь к 2451 охотнику.', bullish: 'Бычий', bearish: 'Медвежий' },
  es: { steps: 'Guía paso a paso del Airdrop', overview: 'Descripción del proyecto y financiación', metric: 'Métrica', details: 'Detalles', funding: 'Financiación total', investors: 'Inversores principales', allocation: 'Asignación de Airdrop', blockchain: 'Blockchain', strategy: 'Estrategia del editor', faq: 'Preguntas frecuentes', sentiment: '¿Cuál es su opinión sobre', sentimentSub: 'Únete a otros 2.451 cazadores.', bullish: 'Alcista', bearish: 'Bajista' },
  hi: { steps: 'चरण-दर-चरण एयरड्रॉप गाइड', overview: 'परियोजना सिंहावलोकन और वित्त पोषण', metric: 'मीट्रिक', details: 'विवरण', funding: 'कुल वित्त पोषण', investors: 'प्रमुख निवेशक', allocation: 'एयरड्रॉप आवंटन', blockchain: 'ब्लॉकचेन', strategy: 'संपादक की रणनीति', faq: 'अक्सर पूछे जाने वाले प्रश्न', sentiment: 'आपकी क्या राय है', sentimentSub: '2,451 अन्य शिकारियों से जुड़ें।', bullish: 'बुलिश', bearish: 'बियरिश' },
  id: { steps: 'Panduan Airdrop Langkah-demi-Langkah', overview: 'Tinjauan Proyek & Pendanaan', metric: 'Metrik', details: 'Detail', funding: 'Total Pendanaan', investors: 'Investor Utama', allocation: 'Alokasi Airdrop', blockchain: 'Blockchain', strategy: 'Strategi Editor', faq: 'Pertanyaan yang Sering Diajukan', sentiment: 'Apa sentimen Anda tentang', sentimentSub: 'Bergabunglah dengan 2.451 pemburu lainnya.', bullish: 'Bullish', bearish: 'Bearish' },
  vi: { steps: 'Hướng dẫn Airdrop từng bước', overview: 'Tổng quan dự án & Tài trợ', metric: 'Số liệu', details: 'Chi tiết', funding: 'Tổng tài trợ', investors: 'Nhà đầu tư chính', allocation: 'Phân bổ Airdrop', blockchain: 'Blockchain', strategy: 'Chiến lược của biên tập viên', faq: 'Các câu hỏi thường gặp', sentiment: 'Quan điểm của bạn về', sentimentSub: 'Tham gia cùng 2.451 thợ săn khác.', bullish: 'Tăng giá', bearish: 'Giảm giá' },
  pt: { steps: 'Guia passo a passo do Airdrop', overview: 'Visão geral do projeto e financiamento', metric: 'Métrica', details: 'Detalhes', funding: 'Financiamento total', investors: 'Principais investidores', allocation: 'Alocação de Airdrop', blockchain: 'Blockchain', strategy: 'Estratégia do editor', faq: 'Perguntas frequentes', sentiment: 'Qual é o seu sentimento sobre', sentimentSub: 'Junte-se a 2.451 outros caçadores.', bullish: 'Alta', bearish: 'Baixa' },
  zh: { steps: '空投分步指南', overview: '项目概述和资金', metric: '指标', details: '细节', funding: '总资金', investors: '主要投资者', allocation: '空投分配', blockchain: '区块链', strategy: '编辑策略', faq: '常见问题', sentiment: '您对...有什么看法', sentimentSub: '与其他 2,451 名猎人一起预测。', bullish: '看涨', bearish: '看跌' },
  tl: { steps: 'Hakbang-hakbang na Gabay sa Airdrop', overview: 'Pangkalahatang-ideya ng Proyekto', metric: 'Sukatan', details: 'Mga Detalye', funding: 'Kabuuang Pagpopondo', investors: 'Mga Pangunahing Mamumuhunan', allocation: 'Alokasyon ng Airdrop', blockchain: 'Blockchain', strategy: 'Diskarte ng Editor', faq: 'Mga Madalas Itanong', sentiment: 'Ano ang iyong damdamin sa', sentimentSub: 'Sumali sa 2,451 iba pang mangangaso.', bullish: 'Bullish', bearish: 'Bearish' }
};

const ui = uiTranslations[lang] || uiTranslations.en;
---

<Layout title={`${airdrop.name} Airdrop Guide | airdroplyx`}>
  <Header />

  <main class="flex-grow bg-slate-50 py-12">
    <div class="max-w-[1200px] mx-auto px-4 flex flex-col lg:flex-row gap-8">
      
      <div class="w-full lg:w-[70%]">
        <div class="bg-white rounded-3xl p-8 lg:p-10 shadow-sm border border-slate-100">
          
          <div class="flex items-center gap-6 mb-8 pb-8 border-b border-slate-100">
            <img src={airdrop.logo} alt={airdrop.name} class="w-20 h-20 rounded-2xl shadow-sm border border-slate-100 object-cover" />
            <div>
              <div class="flex items-center gap-3 mb-2">
                <h1 class="text-3xl font-extrabold text-slate-900 m-0">{airdrop.name}</h1>
                {airdrop.featured && (
                  <span class="bg-blue-100 text-blue-700 text-xs font-bold px-2 py-1 rounded-md uppercase tracking-wider">Editor's Pick</span>
                )}
              </div>
              <p class="text-slate-500 font-medium text-lg m-0">{airdrop.category}</p>
            </div>
          </div>

          <div class="bg-gradient-to-r from-indigo-50 to-blue-50 border border-blue-100 rounded-2xl p-6 mb-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div>
              <p class="text-blue-900 font-bold mb-1">TL;DR</p>
              <p class="text-blue-800 text-sm m-0">{airdrop.description}</p>
            </div>
            <div class="bg-white px-5 py-3 rounded-xl shadow-sm whitespace-nowrap text-center min-w-[140px] border border-blue-50">
              <p class="text-slate-500 text-xs font-bold mb-1 uppercase tracking-wider">Reward</p>
              <p class="text-indigo-600 font-extrabold text-lg m-0">{airdrop.reward}</p>
            </div>
          </div>

          <h2 class="text-2xl font-bold text-slate-900 mb-4">{ui.overview}</h2>
          <div class="text-slate-600 mb-8 space-y-4 leading-relaxed">
            {airdrop.overview?.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="overflow-hidden rounded-xl border border-slate-200 mb-10">
            <table class="min-w-full text-left text-sm m-0">
              <thead class="bg-slate-50 text-slate-700 font-bold">
                <tr>
                  <th class="px-6 py-4 border-b border-slate-200">{ui.metric}</th>
                  <th class="px-6 py-4 border-b border-slate-200">{ui.details}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-600">
                <tr>
                  <td class="px-6 py-4 font-medium text-slate-900">{ui.funding}</td>
                  <td class="px-6 py-4">{airdrop.funding || 'Undisclosed'}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-slate-900">{ui.investors}</td>
                  <td class="px-6 py-4">{airdrop.investors || 'N/A'}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-slate-900">{ui.allocation}</td>
                  <td class="px-6 py-4">{airdrop.allocation || 'Speculative'}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-slate-900">{ui.blockchain}</td>
                  <td class="px-6 py-4">{airdrop.category}</td>
                </tr>
              </tbody>
            </table>
          </div>

          {airdrop.strategy && (
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 mb-10">
              <h3 class="text-amber-800 font-bold text-lg mb-2 mt-0 flex items-center gap-2">
                <span>🎯</span> {ui.strategy}
              </h3>
              <p class="text-amber-900 text-sm m-0 leading-relaxed font-medium">
                {airdrop.strategy}
              </p>
            </div>
          )}

          <h2 class="text-2xl font-bold text-slate-900 mb-4">{ui.steps}</h2>
          <div class="bg-blue-50 border border-blue-100 rounded-2xl p-8 mb-12">
            <ol class="list-decimal list-outside ml-4 space-y-6 text-slate-800 font-medium leading-relaxed">
              {airdrop.steps && airdrop.steps.map((step, index) => (
  <li class="pl-2 flex items-start gap-4 step-item transition-all duration-300">
    <input type="checkbox" class="mt-1.5 w-5 h-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
    <span class="flex-1">{step}</span>
  </li>
))}
            </ol>
          </div>

          {airdrop.faqs && airdrop.faqs.length > 0 && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-slate-900 mb-6">{ui.faq}</h2>
              <div class="space-y-4">
                {airdrop.faqs.map((faq) => (
                  <div class="border border-slate-200 rounded-xl p-5 bg-white shadow-sm">
                    <h4 class="font-bold text-slate-900 m-0 mb-2">{faq.question}</h4>
                    <p class="text-slate-600 m-0 text-sm leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="bg-white border-2 border-slate-100 rounded-3xl p-8 text-center shadow-sm">
            <h3 class="text-xl font-extrabold text-slate-800 mt-0 mb-2">{ui.sentiment} {airdrop.name}?</h3>
            <p class="text-slate-500 text-sm mb-6 m-0">{ui.sentimentSub}</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
              <button class="flex-1 max-w-[200px] mx-auto bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 font-bold py-3 px-6 rounded-xl transition-all flex items-center justify-center gap-2">
                <span>🚀</span> {ui.bullish}
              </button>
              <button class="flex-1 max-w-[200px] mx-auto bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 font-bold py-3 px-6 rounded-xl transition-all flex items-center justify-center gap-2">
                <span>🐻</span> {ui.bearish}
              </button>
            </div>
          </div>
        </div>
      </div>
      
      <div class="w-full lg:w-[30%] space-y-6">
        <div class="bg-slate-900 rounded-3xl p-8 text-white text-center shadow-lg">
          <h3 class="font-bold text-xl mb-3">Join the Alpha</h3>
          <p class="text-slate-400 text-sm mb-6">Get notified about the most lucrative airdrops before the masses.</p>
          <a href="#" class="block w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-4 rounded-xl transition-colors">
            Subscribe Now
          </a>
        </div>
      </div>
    
      {relatedAirdrops.length > 0 && (
        <div class="mt-20 border-t border-slate-200 pt-16">
          <h3 class="text-2xl font-extrabold text-slate-900 mb-8">Related Airdrops</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedAirdrops.map(related => (
              <a href={`/${lang}/airdrop/${related.id}`} class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition-all group block">
                <div class="flex items-center gap-4 mb-4">
                  <img src={related.logo} alt={related.name} class="w-12 h-12 rounded-xl object-cover" />
                  <div>
                    <h4 class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{related.name}</h4>
                    <span class="text-xs font-bold text-slate-500 uppercase">{related.category}</span>
                  </div>
                </div>
                <p class="text-sm text-slate-600 line-clamp-2">{related.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer />

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const steps = document.querySelectorAll('.step-item');
    const airdropId = window.location.pathname.split('/').filter(Boolean).pop();
    
    steps.forEach((step, index) => {
      const checkbox = step.querySelector('input[type="checkbox"]');
      const storageKey = `airdroplyx_${airdropId}_step_${index}`;
      
      if (localStorage.getItem(storageKey) === 'true') {
        checkbox.checked = true;
        step.classList.add('opacity-50', 'line-through');
      }
      
      checkbox.addEventListener('change', (e) => {
        localStorage.setItem(storageKey, e.target.checked);
        if (e.target.checked) {
          step.classList.add('opacity-50', 'line-through');
        } else {
          step.classList.remove('opacity-50', 'line-through');
        }
      });
    });
  });
</script>

</Layout>
