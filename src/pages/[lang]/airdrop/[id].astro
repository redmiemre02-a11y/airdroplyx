---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { i18n_airdrops } from '../../../data/i18n_airdrops';

export function getStaticPaths() {
  return airdrops.map(airdrop => ({
    params: { id: airdrop.id },
    props: { airdrop },
  }));
}

const { airdrop } = Astro.props;
---

<Layout title={`${airdrop.name} Airdrop Guide | Airdroplyx`}>
  <Header />
  
  <main class="max-w-[1000px] mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-8 flex items-center gap-2">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <a href="#" class="hover:text-blue-600">{airdrop.category}</a>
      <span>/</span>
      <span class="text-slate-800 font-semibold">{airdrop.name}</span>
    </nav>

    <div class="bg-white rounded-3xl p-8 md:p-12 border border-slate-200 shadow-sm mb-12">
      <!-- Header -->
      <div class="flex flex-col md:flex-row gap-8 items-start border-b border-slate-100 pb-10 mb-10">
        <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center shrink-0 p-4 shadow-inner">
          <img src={airdrop.logo} alt={airdrop.name} class="w-full h-full object-contain drop-shadow-md" />
        </div>
        
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide">
              {airdrop.status}
            </span>
            <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide">
              {airdrop.category}
            </span>
            {airdrop.featured && (
              <span class="bg-gradient-to-r from-orange-400 to-red-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-sm">
                HOT
              </span>
            )}
          </div>
          <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">
            {airdrop.name} Airdrop Guide
          </h1>
          <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
            {airdrop.description}
          </p>
        </div>
        
        <div class="w-full md:w-auto bg-slate-50 rounded-2xl p-6 border border-slate-200 text-center md:text-left shrink-0">
          <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Estimated Value</p>
          <p class="text-2xl font-black text-emerald-600 mb-4">{airdrop.reward}</p>
          <a href="#" target="_blank" rel="noopener noreferrer" class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-xl transition-colors text-center shadow-lg shadow-blue-500/30">
            Go to Platform
          </a>
          <p class="text-[11px] text-slate-400 mt-3 flex items-center justify-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8V7a4 4 0 00-8 0v4h8z"></path></svg>
            Verified Link (Ref: 12345)
          </p>
        </div>
      </div>

      <!-- Article Content (SEO Optimized) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600">
          
          <!-- TL;DR Box -->
          <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-6 mb-10 shadow-sm">
            <h3 class="text-blue-800 font-extrabold text-lg flex items-center gap-2 mt-0 mb-2">
              <span>⚡</span> TL;DR (Quick Summary)
            </h3>
            <p class="text-blue-900 m-0 font-medium">
              Connect your Web3 wallet to the testnet, request free tokens from the faucet, and perform daily cross-chain swaps. <strong>Total cost: $0. Estimated time: 5 mins/day.</strong> Very high probability of a massive airdrop.
            </p>
          </div>

          <h2 class="text-2xl font-bold text-slate-900 mb-4">Project Overview & Funding</h2>
          <div class="text-slate-600 mb-8 space-y-4 leading-relaxed">
            {airdrop.overview?.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <!-- SEO Table -->
          <div class="overflow-hidden rounded-xl border border-slate-200 mb-10">
            <table class="min-w-full text-left text-sm m-0">
              <thead class="bg-slate-50 text-slate-700 font-bold">
                <tr>
                  <th class="px-6 py-4 border-b border-slate-200">Metric</th>
                  <th class="px-6 py-4 border-b border-slate-200">Details</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-600">
                <tr>
                  <td class="px-6 py-4 font-medium text-slate-900">Total Funding</td>
                  <td class="px-6 py-4">{airdrop.funding || 'Undisclosed'}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-slate-900">Lead Investors</td>
                  <td class="px-6 py-4">{airdrop.investors || 'N/A'}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-slate-900">Airdrop Allocation</td>
                  <td class="px-6 py-4">{airdrop.allocation || 'Speculative'}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-medium text-slate-900">Blockchain</td>
                  <td class="px-6 py-4">{airdrop.category}</td>
                </tr>
              </tbody>
            </table>
          </div>

          {airdrop.strategy && (
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 mb-10">
              <h3 class="text-amber-800 font-bold text-lg mb-2 mt-0 flex items-center gap-2">
                <span>🎯</span> Editor's Airdrop Strategy
              </h3>
              <p class="text-amber-900 text-sm m-0 leading-relaxed font-medium">
                {airdrop.strategy}
              </p>
            </div>
          )}

          <h2 class="text-2xl font-bold text-slate-900 mb-4">Step-by-Step Airdrop Guide</h2>
          <div class="bg-blue-50 border border-blue-100 rounded-2xl p-8 mb-12">
            <ol class="list-decimal list-outside ml-4 space-y-6 text-slate-800 font-medium leading-relaxed">
              {airdrop.steps && airdrop.steps.map((step) => (
                <li class="pl-2">{step}</li>
              ))}
            </ol>
          </div>

          {airdrop.faqs && airdrop.faqs.length > 0 && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
              <div class="space-y-4">
                {airdrop.faqs.map((faq) => (
                  <div class="border border-slate-200 rounded-xl p-5 bg-white shadow-sm">
                    <h4 class="font-bold text-slate-900 m-0 mb-2">{faq.question}</h4>
                    <p class="text-slate-600 m-0 text-sm leading-relaxed">{faq.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Sentiment Voting -->
          <div class="bg-white border-2 border-slate-100 rounded-3xl p-8 text-center shadow-sm">
            <h3 class="text-xl font-extrabold text-slate-800 mt-0 mb-2">What's your sentiment on {airdrop.name}?</h3>
            <p class="text-sm text-slate-500 mb-6">Join 2,451 other hunters in predicting the airdrop size.</p>
            
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
              <button class="w-full sm:w-auto flex flex-col items-center justify-center gap-1 bg-green-50 hover:bg-green-100 border border-green-200 text-green-700 rounded-2xl py-4 px-8 transition-all group">
                <span class="text-3xl group-hover:scale-125 transition-transform">🚀</span>
                <span class="font-bold">Bullish</span>
                <span class="text-xs text-green-600 font-semibold mt-1">82%</span>
              </button>
              
              <div class="h-12 w-px bg-slate-200 hidden sm:block"></div>
              
              <button class="w-full sm:w-auto flex flex-col items-center justify-center gap-1 bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 rounded-2xl py-4 px-8 transition-all group">
                <span class="text-3xl group-hover:scale-125 transition-transform">🐻</span>
                <span class="font-bold">Bearish</span>
                <span class="text-xs text-red-600 font-semibold mt-1">18%</span>
              </button>
            </div>
          </div>

        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-slate-900 rounded-2xl p-6 text-white shadow-xl relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-blue-500 rounded-full blur-3xl opacity-20"></div>
            <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
              <span class="text-2xl">💡</span> Editor's Note
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-6 relative z-10">
              "This is one of the highest conviction plays of the year. With backing from Tier-1 VCs and a confirmed massive community allocation, doing these simple testnet tasks is a no-brainer. Don't skip this!"
            </p>
            <div class="flex items-center gap-3 border-t border-slate-700 pt-4 relative z-10">
              <div class="w-10 h-10 rounded-full bg-slate-700 overflow-hidden">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Alex" alt="Author" />
              </div>
              <div>
                <p class="text-sm font-bold">Alex Walker</p>
                <p class="text-xs text-blue-400">Lead Airdrop Analyst</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  
</Layout>

