---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { airdrops } from '../../../data/airdrops';

const currentDate = new Date().toISOString().split('T')[0];
const telegramAirdrops = airdrops
  .filter(a => (!a.publishDate || a.publishDate <= currentDate) && a.status === 'active' && /telegram/i.test(a.category))
  .slice(-36)
  .reverse();

const faqs = [
  {
    q: "Telegram airdropları gerçekten ücretsiz mi?",
    a: "Evet, listelediğimiz Telegram Mini-App airdroplarının büyük çoğunluğu sıfır sermaye ($0) ile oynanır. Sadece ödül dağıtımı (claim) aşamasında TON ağı üzerinde çok düşük (birkaç sentlik) ağ ücreti gerekebilir."
  },
  {
    q: "Hangi cüzdanı Telegram botlarına bağlamalıyım?",
    a: "TON tabanlı mini uygulamalar için kendi kontrolünüzdeki (non-custodial) Tonkeeper, MyTonWallet veya Telegram Wallet kullanmanız önerilir. Güvenlik için ana varlıklarınızın bulunduğu cüzdan yerine airdrop'a özel ayrı bir cüzdan açın."
  },
  {
    q: "Telegram airdrop puanları ne zaman nakde döner?",
    a: "Her projenin Token Üretim Etkinliği (TGE) ve anlık görüntü (snapshot) takvimi farklıdır. Puanlar, snapshot sonrası proje tarafından belirlenen orana göre on-chain tokena dönüştürülür."
  },
  {
    q: "Botlar yüzünden hesabım elenir mi (Sybil filtresi)?",
    a: "Otomatik tıklama scriptleri, aynı cihazdan çoklu hesap açma ve sahte referanslar projelerin Sybil filtrelerine takılır. Günlük düzenli giriş ve tek doğrulanmış Tonkeeper cüzdanı en güvenli yoldur."
  }
];
const trAlternates = [
  { lang: 'en', href: 'https://airdroplyx.com/ecosystem/telegram/' },
  { lang: 'tr', href: 'https://airdroplyx.com/tr/telegram-airdroplari/' },
  { lang: 'ru', href: 'https://airdroplyx.com/ru/telegram-airdrops/' },
  { lang: 'id', href: 'https://airdroplyx.com/id/airdrop-telegram/' },
  { lang: 'vi', href: 'https://airdroplyx.com/vi/airdrop-telegram/' },
  { lang: 'es', href: 'https://airdroplyx.com/es/airdrops-telegram/' },
  { lang: 'pt', href: 'https://airdroplyx.com/pt/airdrops-telegram/' },
  { lang: 'ko', href: 'https://airdroplyx.com/ko/telegram-airdrops/' },
  { lang: 'ja', href: 'https://airdroplyx.com/ja/telegram-airdrops/' },
  { lang: 'ar', href: 'https://airdroplyx.com/ar/telegram-airdrops/' },
  { lang: 'x-default', href: 'https://airdroplyx.com/ecosystem/telegram/' }
];
---

<Layout
  lang="tr"
  alternates={trAlternates}
  title="En İyi Telegram Airdropları 2026: Ücretsiz TON Mini-App Listesi | Airdroplyx"
  description="2026 yılının en güncel ve güvenilir ücretsiz Telegram airdrop botları, TON mini uygulamaları, günlük kombo stratejileri ve Tonkeeper cüzdan bağlama rehberi."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": "https://airdroplyx.com/" },
          { "@type": "ListItem", "position": 2, "name": "Telegram Airdropları (TR)", "item": "https://airdroplyx.com/tr/telegram-airdroplari/" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map(f => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <Header />

  <main class="max-w-[1150px] mx-auto px-4 py-12">
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 dark:hover:text-white">Ana Sayfa</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white">Telegram Airdropları (Türkçe Rehber)</span>
    </nav>

    <header class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white rounded-3xl p-8 md:p-12 mb-12 border border-blue-500/20 shadow-xl">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-bold uppercase tracking-wider mb-4">
        🇹🇷 Türkçe Airdrop Merkezi • {telegramAirdrops.length}+ Aktif Proje
      </span>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4 leading-tight">
        En İyi Telegram Airdropları &amp; TON Mini-App Rehberi (2026)
      </h1>
      <p class="text-slate-300 text-base md:text-lg max-w-3xl leading-relaxed mb-6">
        Sermayesiz ($0) olarak katılabileceğiniz, yüksek potansiyelli güncel Telegram Mini-App projelerini, pasif puan kasma stratejilerini ve güvenli Tonkeeper cüzdan bağlama adımlarını tek sayfada derledik.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/tr/tonkeeper-airdrop-cekimi/" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-5 py-3 rounded-xl text-sm transition-colors">
          Tonkeeper Cüzdan &amp; Çekim Rehberi →
        </a>
        <a href="#liste" class="bg-white/10 hover:bg-white/20 text-white font-bold px-5 py-3 rounded-xl text-sm border border-white/15 transition-colors">
          Aktif Airdrop Listesine Git ↓
        </a>
      </div>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-12">
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
        <h2 class="font-extrabold text-lg text-slate-900 dark:text-white mb-2">1. Güvenilir Cüzdan Seçimi</h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          TON tabanlı Telegram botlarında ödül alabilmek için <strong>Tonkeeper</strong>, <strong>MyTonWallet</strong> veya <strong>Telegram Wallet</strong> gibi resmi non-custodial cüzdanları bağlamanız gerekir.
        </p>
      </div>
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
        <h2 class="font-extrabold text-lg text-slate-900 dark:text-white mb-2">2. Pasif Gelire Odaklanın</h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Ekrana sürekli dokunmak yerine saatlik pasif kazanç (*Profit Per Hour*), günlük kombo ve şifre görevlerini tamamlayarak çok daha az sürede yüksek puan toplayın.
        </p>
      </div>
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
        <h2 class="font-extrabold text-lg text-slate-900 dark:text-white mb-2">3. Dolandırıcılıktan Korunun</h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Hiçbir gerçek Telegram airdropu sizden 12/24 kelimelik gizli kurtarma cümlenizi (seed phrase) istemez. Yalnızca TON Connect onay imzası kullanın.
        </p>
      </div>
    </section>

    <section id="liste" class="mb-16">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-4 mb-6">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white">
          Güncel Telegram Mini-App Airdropları (En Yeni 36 Proje)
        </h2>
        <span class="text-xs font-bold bg-emerald-100 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 px-3 py-1 rounded-full">
          Aktif • Ücretsiz
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {telegramAirdrops.map(drop => (
          <a href={`/airdrop/${drop.id}/`} class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 hover:border-blue-500 hover:shadow-lg transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center gap-3 mb-3">
                <img src={drop.logo} alt={drop.name} width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 rounded-xl object-cover bg-slate-50 p-1 border border-slate-100 dark:border-slate-700 shrink-0" />
                <div class="min-w-0">
                  <h3 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-blue-600 transition-colors truncate">{drop.name}</h3>
                  <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 block truncate">{drop.cost || 'Free ($0)'}</span>
                </div>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed mb-4">
                {drop.description}
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs">
              <span class="font-semibold text-slate-500 dark:text-slate-400 truncate max-w-[65%]">{drop.reward}</span>
              <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0">Rehber →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-slate-50 dark:bg-slate-800/50 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700">
      <h2 class="text-2xl font-black text-slate-900 dark:text-white mb-5">
        Telegram Airdropları Hakkında Sıkça Sorulan Sorular
      </h2>
      <div class="space-y-4">
        {faqs.map(f => (
          <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-700/70">
            <h3 class="font-bold text-slate-900 dark:text-white text-base mb-1">{f.q}</h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>
