---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import AirdropCard from '../../components/AirdropCard.astro';
import { airdrops } from '../../data/airdrops';

const latestAirdrops = airdrops.filter(a => a.status === 'active' || a.status === 'upcoming');
const hottestAirdrops = airdrops.filter(a => a.featured);
const potentialAirdrops = airdrops.filter(a => a.status === 'upcoming' || a.category === 'Layer 2');
---

<Layout title="Kripto Airdropları 2026 » Onaylanmış Rehberler ve Bedava Tokenlar">
  <!-- TODO: Header component can be made multi-lingual too, for now we keep it -->
  <Header />
  
  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-slate-900 to-slate-800 text-white py-16 mb-12 border-b-4 border-blue-600">
    <div class="max-w-[1200px] mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">Kripto Airdroplarından</span> Payınızı Alın
      </h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
        En iyi kripto para airdropları, ödül avları ve yield farming fırsatları için en kapsamlı çok dilli rehberiniz. Her gün doğrulanır ve güncellenir.
      </p>
      
      <!-- Newsletter inside Hero -->
      <form class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto bg-white/10 p-2 rounded-2xl backdrop-blur-sm border border-white/20">
        <input type="email" placeholder="E-posta adresinizi girin..." class="flex-1 bg-white rounded-xl px-4 py-3 text-slate-900 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
        <button class="bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl px-6 py-3 transition-colors shadow-lg shadow-blue-500/30">
          Ücretsiz Abone Ol
        </button>
      </form>
      <p class="text-xs text-slate-400 mt-4">25.000+ aboneye katılın. Asla spam yapmayız.</p>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-4 mb-20">
    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Column 1: Latest -->
      <div class="col-span-1">
        <div class="flex items-center gap-2 mb-6 border-b border-slate-200 pb-3">
          <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h2 class="text-[22px] font-extrabold text-slate-800 tracking-tight uppercase">En Yeniler</h2>
        </div>
        <div class="flex flex-col gap-4">
          {latestAirdrops.map(airdrop => (
            <AirdropCard airdrop={airdrop} />
          ))}
        </div>
      </div>

      <!-- Column 2: Hottest -->
      <div class="col-span-1">
        <div class="flex items-center gap-2 mb-6 border-b border-slate-200 pb-3">
          <div class="w-8 h-8 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.5 11.2c-.3-.3-.8-.3-1.1 0-1.8 1.8-3.4 3.7-3.4 6.3 0 1.9 1.6 3.5 3.5 3.5s3.5-1.6 3.5-3.5c0-2.6-1.6-4.5-3.4-6.3zm-10-2.4c-1.8 1.8-3.4 3.7-3.4 6.3 0 1.9 1.6 3.5 3.5 3.5s3.5-1.6 3.5-3.5c0-2.6-1.6-4.5-3.4-6.3-.3-.3-.8-.3-1.1 0zM12 2C7.6 2 4 5.6 4 10s3.6 8 8 8 8-3.6 8-8-3.6-8-8-8zm0 14c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6z"></path></svg>
          </div>
          <h2 class="text-[22px] font-extrabold text-slate-800 tracking-tight uppercase">En Popüler</h2>
        </div>
        <div class="flex flex-col gap-4">
          {hottestAirdrops.map(airdrop => (
            <AirdropCard airdrop={airdrop} />
          ))}
        </div>
      </div>

      <!-- Column 3: Potential -->
      <div class="col-span-1">
        <div class="flex items-center gap-2 mb-6 border-b border-slate-200 pb-3">
          <div class="w-8 h-8 rounded-lg bg-purple-100 flex items-center justify-center text-purple-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h2 class="text-[22px] font-extrabold text-slate-800 tracking-tight uppercase">Potansiyel</h2>
        </div>
        <div class="flex flex-col gap-4">
          {potentialAirdrops.map(airdrop => (
            <AirdropCard airdrop={airdrop} />
          ))}
        </div>
      </div>

    </div>
  </div>

  
</Layout>

