---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { airdrops } from '../../../data/airdrops';

const comboDrops = airdrops.filter(a =>
  ['rocky-rabbit', 'pixelverse', 'grand-combat', 'super-meow', 'notbored-puppies', 'timeton', 'gemz', 'hamster-kombat'].includes(a.id)
);
---

<Layout
  lang="tr"
  title="Telegram Günlük Kombo, Şifre ve Enigma Rehberi (2026) | Airdroplyx"
  description="Telegram Mini-App oyunlarında günlük kombo kartları, şifre çözme (cipher) ve Enigma görevleriyle nasıl ekstra airdrop puanı kazanılır?"
>
  <Header />

  <main class="max-w-[1000px] mx-auto px-4 py-12">
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-slate-900 dark:hover:text-white">Ana Sayfa</a>
      <span>/</span>
      <a href="/tr/telegram-airdroplari/" class="hover:text-slate-900 dark:hover:text-white">Telegram Airdropları</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white">Günlük Kombo &amp; Şifre Rehberi</span>
    </nav>

    <header class="bg-gradient-to-br from-slate-900 via-purple-950 to-slate-900 text-white rounded-3xl p-8 md:p-10 mb-10 border border-purple-500/20">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/20 border border-purple-400/30 text-purple-200 text-xs font-bold uppercase mb-4">
        🎯 Günlük Bonus Stratejisi
      </span>
      <h1 class="text-3xl md:text-4xl font-black leading-tight mb-3">
        Telegram Airdroplarında Günlük Kombo, Şifre ve Enigma Nasıl Çözülür?
      </h1>
      <p class="text-slate-300 text-base leading-relaxed">
        Saatlerce ekrana dokunmak yerine günlük 3-4 kartlık kombo ve şifre görevlerini tamamlayarak airdrop puanlarınızı katlayın.
      </p>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-12">
      {comboDrops.map(drop => (
        <a href={`/airdrop/${drop.id}/`} class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 hover:border-purple-500 transition-all flex items-start gap-4 group">
          <img src={drop.logo} alt={drop.name} width="52" height="52" loading="lazy" decoding="async" class="w-13 h-13 rounded-xl object-cover bg-slate-50 p-1 border border-slate-100 dark:border-slate-700 shrink-0" />
          <div class="min-w-0">
            <h2 class="font-bold text-lg text-slate-900 dark:text-white group-hover:text-purple-500 transition-colors">{drop.name}</h2>
            <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 mt-1 mb-2">{drop.strategy}</p>
            <span class="text-xs font-bold text-purple-600 dark:text-purple-400">Rehberi Aç →</span>
          </div>
        </a>
      ))}
    </section>

    <div class="flex flex-wrap gap-3">
      <a href="/daily-combos/" class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-5 py-3 rounded-xl text-sm transition-colors">
        Global Daily Combos Paneline Git →
      </a>
      <a href="/tr/telegram-airdroplari/" class="bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-bold px-5 py-3 rounded-xl text-sm transition-colors">
        🇹🇷 Tüm Telegram Airdropları
      </a>
    </div>
  </main>
</Layout>
