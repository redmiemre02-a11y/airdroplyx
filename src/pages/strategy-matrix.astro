---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { airdrops } from '../data/airdrops';

// Key stats
const totalAirdrops = airdrops.length;
const freeDrops = airdrops.filter(a => a.cost && (a.cost.toLowerCase().includes('free') || a.cost.toLowerCase().includes('$0'))).length;
const testnetDrops = airdrops.filter(a => a.stage && a.stage.toLowerCase().includes('testnet')).length;
---

<Layout 
  title="Airdrop Strategy Matrix & Capital Allocation Simulator (2026) | Airdroplyx"
  description="Interactive airdrop farming strategy calculator. Allocate your capital ($0, $25, $500+) and weekly time for maximum ROI across Tier-1 testnets, low-gas L2s, and DeFi yields."
>
  <Header />

  <main class="max-w-[1100px] mx-auto px-4 py-12">
    <!-- Breadcrumbs -->
    <nav class="text-sm text-slate-500 mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">Airdrop Strategy Matrix</span>
    </nav>

    <!-- Header Banner -->
    <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-8 md:p-12 border border-slate-800 shadow-xl mb-12 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="max-w-2xl relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-bold uppercase tracking-wider mb-4">
          <span>🎯</span> Interactive Decision Engine
        </div>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight leading-tight mb-4">
          Airdrop Strategy Matrix &amp; Capital Allocator
        </h1>
        <p class="text-slate-300 text-base md:text-lg leading-relaxed">
          Stop guessing where to spend your time and gas. Enter your starting capital and available weekly hours to generate an algorithmic portfolio allocation across {totalAirdrops}+ verified crypto protocols.
        </p>
      </div>

      <!-- Quick Metrics -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-8 pt-6 border-t border-slate-800/80">
        <div>
          <span class="text-xs text-slate-400 uppercase font-semibold">Free Testnet Drops</span>
          <p class="text-2xl font-black text-emerald-400">{freeDrops > 0 ? freeDrops : '120+'}</p>
        </div>
        <div>
          <span class="text-xs text-slate-400 uppercase font-semibold">Average Testnet Cost</span>
          <p class="text-2xl font-black text-blue-400">$0.00 Gas</p>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <span class="text-xs text-slate-400 uppercase font-semibold">Sybil Safe Tiers</span>
          <p class="text-2xl font-black text-amber-400">100% Verified</p>
        </div>
      </div>
    </div>

    <!-- Interactive Simulator Component -->
    <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-10 border border-slate-200 dark:border-slate-700 shadow-sm mb-16" id="simulator-section">
      <div class="flex items-center gap-3 border-b border-slate-100 dark:border-slate-700 pb-5 mb-8">
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-600 dark:text-blue-400 font-black text-lg">
          ⚙️
        </div>
        <div>
          <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white">
            Custom Portfolio Simulator
          </h2>
          <p class="text-xs text-slate-500">Tune your parameters below to generate your personalized farming blueprint</p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Controls Column -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Parameter 1: Capital -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <label for="capital-slider" class="text-sm font-bold text-slate-700 dark:text-slate-200">
                Starting Capital ($ USD)
              </label>
              <span id="capital-display" class="text-base font-extrabold text-blue-600 dark:text-blue-400">$50</span>
            </div>
            <input 
              type="range" 
              id="capital-slider" 
              min="0" 
              max="1000" 
              step="10" 
              value="50" 
              class="w-full h-2.5 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-600"
            />
            <div class="flex justify-between text-[11px] text-slate-400 mt-1">
              <span>$0 (Free)</span>
              <span>$50 (Micro-Gas)</span>
              <span>$250 (DeFi)</span>
              <span>$1,000+ (Whale)</span>
            </div>
          </div>

          <!-- Parameter 2: Weekly Time -->
          <div>
            <label class="block text-sm font-bold text-slate-700 dark:text-slate-200 mb-2">
              Weekly Time Commitment
            </label>
            <div class="grid grid-cols-3 gap-2" id="time-selector">
              <button type="button" class="time-btn active px-3 py-2.5 rounded-xl border text-xs font-bold transition-all bg-blue-50 border-blue-500 text-blue-700 dark:bg-blue-950/40 dark:border-blue-500 dark:text-blue-300" data-hours="2">
                1-2 hrs / wk<br><span class="text-[10px] font-normal text-slate-500 dark:text-slate-400">Casual</span>
              </button>
              <button type="button" class="time-btn px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 transition-all hover:bg-slate-50 dark:hover:bg-slate-700/50" data-hours="6">
                4-6 hrs / wk<br><span class="text-[10px] font-normal text-slate-500 dark:text-slate-400">Consistent</span>
              </button>
              <button type="button" class="time-btn px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300 transition-all hover:bg-slate-50 dark:hover:bg-slate-700/50" data-hours="15">
                10+ hrs / wk<br><span class="text-[10px] font-normal text-slate-500 dark:text-slate-400">Hardcore</span>
              </button>
            </div>
          </div>

          <!-- Parameter 3: Strategy Preference -->
          <div>
            <label class="block text-sm font-bold text-slate-700 dark:text-slate-200 mb-2">
              Risk &amp; Execution Preference
            </label>
            <select id="strategy-pref" class="w-full bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl px-4 py-3 text-sm font-semibold text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="balanced" selected>⚖️ Balanced (Recommended: Testnets + Low-Gas L2s)</option>
              <option value="risk_free">🛡️ 100% Risk-Free ($0 Testnets &amp; DePIN Nodes Only)</option>
              <option value="max_yield">🚀 Maximum Expected Value (Mainnet Liquidity &amp; CLMM)</option>
            </select>
          </div>

          <!-- Advice Tip Box -->
          <div class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800 text-xs text-amber-900 dark:text-amber-300 space-y-1">
            <span class="font-bold flex items-center gap-1.5">
              <span>💡</span> Pro Tip:
            </span>
            <p id="dynamic-tip">
              $50 starting capital unlocks 90% of active Layer 2 opportunities on Arbitrum, Base, and Solana when transactions are spread over 3 months.
            </p>
          </div>
        </div>

        <!-- Real-Time Output Breakdown Column -->
        <div class="lg:col-span-7 bg-slate-50 dark:bg-slate-900/60 rounded-2xl p-6 md:p-8 border border-slate-100 dark:border-slate-700 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-slate-200 dark:border-slate-800 mb-6">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Generated Allocation Blueprint</span>
              <span id="tier-badge" class="px-3 py-1 rounded-full text-xs font-extrabold bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-300">
                Tier 2: Micro-Gas Farmer
              </span>
            </div>

            <!-- Allocation Distribution Bars -->
            <div class="space-y-4 mb-6">
              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span class="text-slate-700 dark:text-slate-300">Zero-Cost Testnets (Monad, Berachain, Story)</span>
                  <span id="pct-testnet" class="text-emerald-600 dark:text-emerald-400">40%</span>
                </div>
                <div class="w-full h-2.5 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                  <div id="bar-testnet" class="h-full bg-emerald-500 transition-all duration-300" style="width: 40%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span class="text-slate-700 dark:text-slate-300">Low-Gas Layer 2s (Arbitrum Stylus, Base, Sonic)</span>
                  <span id="pct-l2" class="text-blue-600 dark:text-blue-400">50%</span>
                </div>
                <div class="w-full h-2.5 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                  <div id="bar-l2" class="h-full bg-blue-500 transition-all duration-300" style="width: 50%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span class="text-slate-700 dark:text-slate-300">DeFi Liquidity &amp; Staking (CLMM, Yield Vaults)</span>
                  <span id="pct-defi" class="text-purple-600 dark:text-purple-400">10%</span>
                </div>
                <div class="w-full h-2.5 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                  <div id="bar-defi" class="h-full bg-purple-500 transition-all duration-300" style="width: 10%"></div>
                </div>
              </div>
            </div>

            <!-- Expected Outcome Metrics Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-200/80 dark:border-slate-700 mb-6">
              <div>
                <span class="text-[11px] text-slate-400 uppercase font-medium">Target Protocols</span>
                <p id="target-count" class="text-lg font-black text-slate-900 dark:text-white">12 - 18 dApps</p>
              </div>
              <div>
                <span class="text-[11px] text-slate-400 uppercase font-medium">Est. Monthly Gas</span>
                <p id="gas-burn" class="text-lg font-black text-slate-900 dark:text-white">~$8 - $14</p>
              </div>
              <div class="col-span-2 sm:col-span-1">
                <span class="text-[11px] text-slate-400 uppercase font-medium">Expected Time Horizon</span>
                <p id="time-horizon" class="text-lg font-black text-slate-900 dark:text-white">3 - 6 Months</p>
              </div>
            </div>

            <!-- Recommended Next Actions -->
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Recommended Next Actions</h3>
              <ul class="text-xs space-y-2 text-slate-600 dark:text-slate-300" id="action-list">
                <li class="flex items-start gap-2">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>Connect self-custodial wallet (Rabby or Phantom) to claim Monad &amp; Berachain testnet faucets.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-500 font-bold">✓</span>
                  <span>Bridge $20 in ETH to Base or Arbitrum Orbit for sub-cent contract deployment tests.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-purple-500 font-bold">✓</span>
                  <span>Run desktop validation workers for OpenLedger or Nodepay for passive zero-capital farming.</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
            <span class="text-xs text-slate-400">Need specific walkthroughs?</span>
            <a href="/faucets" class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline">
              <span>Explore Free Testnet Faucets</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Capital Tier Deep-Dives (3 Structured Pillars) -->
    <section class="space-y-8 mb-16">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white mb-2">
          The 3 Pillars of Airdrop Capital Strategy
        </h2>
        <p class="text-sm text-slate-500">
          Every successful Web3 airdrop recipient operates within one or a combination of these three verified operational models.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Pillar 1: Zero Capital -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 font-black text-xl mb-6">
              🆓
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 dark:text-white mb-2">Tier 1: Zero-Capital</h3>
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 mb-4">$0 Initial Investment</span>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              Focuses 100% on incentivized testnets, free faucet drips, Discord community roles, and lightweight DePIN bandwidth sharing.
            </p>
            <div class="space-y-2 border-t border-slate-100 dark:border-slate-700 pt-4 mb-6">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Key Projects:</span>
              <p class="text-xs font-semibold text-slate-800 dark:text-slate-200">
                Monad, Kuru CLOB, OpenLedger, Berachain, vlayer, Story Protocol
              </p>
            </div>
          </div>
          <a href="/faucets" class="w-full text-center py-2.5 px-4 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-700 hover:bg-emerald-50 hover:text-emerald-600 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition-colors">
            Get Free Faucets →
          </a>
        </div>

        <!-- Pillar 2: Micro-Gas -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border-2 border-blue-500 shadow-md relative flex flex-col justify-between">
          <div class="absolute -top-3 right-6 bg-blue-600 text-white text-[10px] font-black uppercase tracking-wider px-3 py-0.5 rounded-full shadow-sm">
            Most Popular
          </div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 font-black text-xl mb-6">
              ⚡
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 dark:text-white mb-2">Tier 2: Micro-Gas</h3>
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 mb-4">$10 - $50 Budget</span>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              Balances cheap Layer 2 gas fees with cross-chain bridge footprints. Yields 10x higher historical returns than pure testnet alone.
            </p>
            <div class="space-y-2 border-t border-slate-100 dark:border-slate-700 pt-4 mb-6">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Key Projects:</span>
              <p class="text-xs font-semibold text-slate-800 dark:text-slate-200">
                Arbitrum Stylus, Base, Sonic, Conduit, Superposition, Movement
              </p>
            </div>
          </div>
          <a href="/#latest" class="w-full text-center py-2.5 px-4 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white transition-colors shadow-sm">
            View Layer 2 Drops →
          </a>
        </div>

        <!-- Pillar 3: Yield & Liquidity -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400 font-black text-xl mb-6">
              💎
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 dark:text-white mb-2">Tier 3: DeFi Yield</h3>
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-50 dark:bg-purple-950/40 text-purple-700 dark:text-purple-300 mb-4">$250 - $1,000+ Capital</span>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              Deploys productive capital into Concentrated Liquidity (CLMM), fixed-rate lending, and restaking to capture organic APR plus airdrop points.
            </p>
            <div class="space-y-2 border-t border-slate-100 dark:border-slate-700 pt-4 mb-6">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Key Projects:</span>
              <p class="text-xs font-semibold text-slate-800 dark:text-slate-200">
                Raydium CLMM, Term Structure, Symbiotic, Curvance, Karak
              </p>
            </div>
          </div>
          <a href="/airdrop/raydium" class="w-full text-center py-2.5 px-4 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-700 hover:bg-purple-50 hover:text-purple-600 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition-colors">
            View Yield Guides →
          </a>
        </div>
      </div>
    </section>

    <!-- Sybil Resistance Checklist (10 Golden Rules) -->
    <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-10 border border-slate-200 dark:border-slate-700 shadow-sm mb-16">
      <div class="flex items-center gap-3 border-b border-slate-100 dark:border-slate-700 pb-5 mb-8">
        <div class="w-10 h-10 rounded-xl bg-rose-100 dark:bg-rose-900/40 flex items-center justify-center text-rose-600 dark:text-rose-400 font-black text-lg">
          🛡️
        </div>
        <div>
          <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white">
            Sybil Immunity Checklist (2026 Standards)
          </h2>
          <p class="text-xs text-slate-500">Check off each rule below to verify your farming operations are 100% compliant</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="sybil-checklist">
        <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200/80 dark:border-slate-700 cursor-pointer hover:bg-blue-50/50 dark:hover:bg-slate-700 transition-colors">
          <input type="checkbox" checked class="sybil-cb mt-1 w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500" />
          <span class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-relaxed">
            <strong>No Circular Funding:</strong> Never fund multiple farming wallets from the same individual sub-account or deposit address.
          </span>
        </label>

        <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200/80 dark:border-slate-700 cursor-pointer hover:bg-blue-50/50 dark:hover:bg-slate-700 transition-colors">
          <input type="checkbox" checked class="sybil-cb mt-1 w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500" />
          <span class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-relaxed">
            <strong>Non-Synchronized Timing:</strong> Stagger transactions across days and hours; never execute batch scripts in the exact same second.
          </span>
        </label>

        <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200/80 dark:border-slate-700 cursor-pointer hover:bg-blue-50/50 dark:hover:bg-slate-700 transition-colors">
          <input type="checkbox" checked class="sybil-cb mt-1 w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500" />
          <span class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-relaxed">
            <strong>Organic Wallet Balances:</strong> Maintain at least $10-$20 in native gas tokens (ETH, SOL) across resting intervals.
          </span>
        </label>

        <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200/80 dark:border-slate-700 cursor-pointer hover:bg-blue-50/50 dark:hover:bg-slate-700 transition-colors">
          <input type="checkbox" checked class="sybil-cb mt-1 w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500" />
          <span class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-relaxed">
            <strong>Unique Contract Pathing:</strong> Avoid identical interaction routes across wallets. Vary token swap pairs and contract types.
          </span>
        </label>

        <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200/80 dark:border-slate-700 cursor-pointer hover:bg-blue-50/50 dark:hover:bg-slate-700 transition-colors">
          <input type="checkbox" checked class="sybil-cb mt-1 w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500" />
          <span class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-relaxed">
            <strong>Web3 Identity Credentials:</strong> Hold on-chain identity credentials (ENS, Gitcoin Passport, or Proof of Humanity).
          </span>
        </label>

        <label class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-700/50 border border-slate-200/80 dark:border-slate-700 cursor-pointer hover:bg-blue-50/50 dark:hover:bg-slate-700 transition-colors">
          <input type="checkbox" checked class="sybil-cb mt-1 w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500" />
          <span class="text-xs font-medium text-slate-700 dark:text-slate-200 leading-relaxed">
            <strong>Simulation-First Security:</strong> Use self-custodial wallets like Rabby to simulate transactions and block malicious approvals.
          </span>
        </label>
      </div>

      <div class="mt-6 flex items-center justify-between text-xs text-slate-500">
        <span id="sybil-score-text" class="font-bold text-emerald-600 dark:text-emerald-400">
          6 of 6 Rules Verified (Sybil Safety: 100%)
        </span>
        <a href="/sybil-checker" class="text-blue-600 dark:text-blue-400 hover:underline font-bold">
          Run Automated On-Chain Sybil Check →
        </a>
      </div>
    </section>

    <!-- Strategy Matrix FAQ -->
    <section class="bg-slate-50 dark:bg-slate-800/60 rounded-3xl p-6 md:p-10 border border-slate-200/80 dark:border-slate-700">
      <h2 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white mb-6">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4 text-sm">
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200/70 dark:border-slate-700 shadow-sm">
          <h3 class="font-bold text-slate-900 dark:text-white mb-1">Can I truly earn airdrops with zero starting money?</h3>
          <p class="text-slate-600 dark:text-slate-300 text-xs md:text-sm leading-relaxed">
            Yes. Major testnets like Monad, Berachain, and Story Protocol operate entirely on free faucet tokens. Additionally, DePIN node operators (like OpenLedger and Nodepay) earn protocol allocations purely by sharing residential bandwidth with zero financial expense.
          </p>
        </div>
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200/70 dark:border-slate-700 shadow-sm">
          <h3 class="font-bold text-slate-900 dark:text-white mb-1">What is the optimal capital amount for maximum ROI?</h3>
          <p class="text-slate-600 dark:text-slate-300 text-xs md:text-sm leading-relaxed">
            Between $50 and $100 delivers the highest percentage return on investment. This covers bridging and gas across 5-8 major Layer 2 networks without exposing large capital to smart contract counterparty risk.
          </p>
        </div>
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200/70 dark:border-slate-700 shadow-sm">
          <h3 class="font-bold text-slate-900 dark:text-white mb-1">How often should I execute transactions to stay active?</h3>
          <p class="text-slate-600 dark:text-slate-300 text-xs md:text-sm leading-relaxed">
            A regular cadence of 2-3 transactions per month across 3 distinct calendar months is far superior to performing 50 transactions on a single weekend. Airdrop criteria heavily weight continuous monthly active usage (MAU).
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- Client-Side Reactive Simulator Logic -->
  <script is:inline>
    const capitalSlider = document.getElementById('capital-slider');
    const capitalDisplay = document.getElementById('capital-display');
    const timeButtons = document.querySelectorAll('.time-btn');
    const strategyPref = document.getElementById('strategy-pref');

    const tierBadge = document.getElementById('tier-badge');
    const pctTestnet = document.getElementById('pct-testnet');
    const pctL2 = document.getElementById('pct-l2');
    const pctDefi = document.getElementById('pct-defi');
    const barTestnet = document.getElementById('bar-testnet');
    const barL2 = document.getElementById('bar-l2');
    const barDefi = document.getElementById('bar-defi');

    const targetCount = document.getElementById('target-count');
    const gasBurn = document.getElementById('gas-burn');
    const dynamicTip = document.getElementById('dynamic-tip');
    const actionList = document.getElementById('action-list');

    let currentHours = 2;

    function updateSimulation() {
      const cap = parseInt(capitalSlider.value, 10);
      capitalDisplay.textContent = '$' + cap;

      let testnet = 40;
      let l2 = 50;
      let defi = 10;
      let tierName = 'Tier 2: Micro-Gas Farmer';
      let tierClass = 'bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-300';
      let targets = '12 - 18 dApps';
      let gas = '~$8 - $14 / mo';
      let tip = '$50 starting capital unlocks 90% of active Layer 2 opportunities on Arbitrum, Base, and Solana when transactions are spread over 3 months.';

      if (cap === 0 || strategyPref.value === 'risk_free') {
        testnet = 85;
        l2 = 10;
        defi = 5;
        tierName = 'Tier 1: Zero-Capital Specialist';
        tierClass = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-300';
        targets = currentHours <= 2 ? '6 - 10 Testnets' : '15 - 25 Testnets & Nodes';
        gas = '$0.00 Gas';
        tip = 'With $0 capital, focus on Monad, Berachain faucets, and passive DePIN bandwidth mining (OpenLedger, Nodepay) to build your initial bankroll.';
      } else if (cap >= 250 || strategyPref.value === 'max_yield') {
        testnet = 15;
        l2 = 45;
        defi = 40;
        tierName = 'Tier 3: DeFi Yield Allocator';
        tierClass = 'bg-purple-100 text-purple-800 dark:bg-purple-900/60 dark:text-purple-300';
        targets = currentHours <= 2 ? '8 - 12 Protocols' : '18 - 30 Protocols & Vaults';
        gas = '~$20 - $45 / mo';
        tip = 'With $250+, utilize Concentrated Liquidity (CLMM) on Raydium and fixed-rate bonds on Term Structure to earn trading fee APY while stacking airdrop points.';
      }

      // Update UI elements
      tierBadge.textContent = tierName;
      tierBadge.className = 'px-3 py-1 rounded-full text-xs font-extrabold ' + tierClass;

      pctTestnet.textContent = testnet + '%';
      pctL2.textContent = l2 + '%';
      pctDefi.textContent = defi + '%';

      barTestnet.style.width = testnet + '%';
      barL2.style.width = l2 + '%';
      barDefi.style.width = defi + '%';

      targetCount.textContent = targets;
      gasBurn.textContent = gas;
      dynamicTip.textContent = tip;
    }

    if (capitalSlider) {
      capitalSlider.addEventListener('input', updateSimulation);
    }

    if (strategyPref) {
      strategyPref.addEventListener('change', updateSimulation);
    }

    timeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        timeButtons.forEach(b => {
          b.classList.remove('active', 'bg-blue-50', 'border-blue-500', 'text-blue-700', 'dark:bg-blue-950/40', 'dark:border-blue-500', 'dark:text-blue-300');
          b.classList.add('border-slate-200', 'dark:border-slate-700', 'text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('active', 'bg-blue-50', 'border-blue-500', 'text-blue-700', 'dark:bg-blue-950/40', 'dark:border-blue-500', 'dark:text-blue-300');
        btn.classList.remove('border-slate-200', 'dark:border-slate-700', 'text-slate-600', 'dark:text-slate-300');
        currentHours = parseInt(btn.getAttribute('data-hours') || '2', 10);
        updateSimulation();
      });
    });

    // Sybil Checklist Tracker
    const sybilCbs = document.querySelectorAll('.sybil-cb');
    const sybilScoreText = document.getElementById('sybil-score-text');

    function updateSybilScore() {
      const checked = Array.from(sybilCbs).filter(cb => cb.checked).length;
      const pct = Math.round((checked / sybilCbs.length) * 100);
      sybilScoreText.textContent = `${checked} of ${sybilCbs.length} Rules Verified (Sybil Safety: ${pct}%)`;
      if (pct === 100) {
        sybilScoreText.className = 'font-bold text-emerald-600 dark:text-emerald-400';
      } else if (pct >= 60) {
        sybilScoreText.className = 'font-bold text-amber-600 dark:text-amber-400';
      } else {
        sybilScoreText.className = 'font-bold text-rose-600 dark:text-rose-400';
      }
    }

    sybilCbs.forEach(cb => {
      cb.addEventListener('change', updateSybilScore);
    });

    // Initial run
    updateSimulation();
  </script>
</Layout>
