---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { airdrops } from '../data/airdrops';

// Prepare a lightweight JSON serialized map of all airdrops for client-side matching
const airdropsLookup = airdrops.map(a => ({
  id: a.id,
  name: a.name,
  logo: a.logo,
  category: a.category,
  reward: a.reward,
  funding: a.funding,
  tier: a.tier,
  status: a.status,
  steps: a.steps,
  refLink: a.refLink,
  description: a.description
}));
---

<Layout 
  title="My Airdrop Watchlist & Farming Tracker | Airdroplyx" 
  description="Track your personal Web3 airdrop farming portfolio. Monitor task checklists, calculate combined potential rewards, and manage multi-protocol progress privately."
>
  <Header />

  <main class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-12 px-4 transition-colors duration-200">
    <div class="max-w-[1200px] mx-auto">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-medium">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <span>/</span>
        <span class="text-blue-600 dark:text-blue-400 font-semibold">Watchlist & Tracker</span>
      </nav>

      <!-- Hero Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
        <div>
          <div class="inline-flex items-center gap-2 bg-amber-100 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase mb-3 border border-amber-200 dark:border-amber-800/60 shadow-sm">
            <span>⭐</span>
            <span>Personal Farming Hub</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
            My Airdrop Watchlist
          </h1>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 max-w-2xl">
            Track your bookmarked protocols, monitor step-by-step checklist progress, and ensure you never miss critical snapshot deadlines.
          </p>
        </div>

        <!-- Action Buttons: Export / Import -->
        <div class="flex flex-wrap items-center gap-2.5">
          <button id="export-btn" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-all flex items-center gap-1.5 shadow-sm">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            <span>Backup (JSON)</span>
          </button>
          <label class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
            <span>Restore Backup</span>
            <input type="file" id="import-input" accept=".json" class="hidden" />
          </label>
          <button id="clear-watchlist-btn" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 dark:bg-rose-950/40 dark:hover:bg-rose-900/60 dark:text-rose-300 border border-rose-200 dark:border-rose-800/60 transition-all">
            Clear All
          </button>
        </div>
      </div>

      <!-- Stats Overview Bar -->
      <div id="stats-bar" class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Tracked Protocols</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span id="stat-total-count" class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">0</span>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">airdrops</span>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Steps Done</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span id="stat-tasks-done" class="text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400">0</span>
            <span id="stat-tasks-total" class="text-xs font-semibold text-slate-500 dark:text-slate-400">/ 0 tasks</span>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Overall Progress</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span id="stat-progress-pct" class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400">0%</span>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">completed</span>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Active Tier 1 Targets</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span id="stat-tier1-count" class="text-2xl sm:text-3xl font-black text-amber-500">0</span>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">high priority</span>
          </div>
        </div>
      </div>

      <!-- Filters & Search Toolbar -->
      <div id="toolbar-container" class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm mb-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        <!-- Search Input -->
        <div class="relative flex-1">
          <input 
            type="text" 
            id="watchlist-search" 
            placeholder="Search within your saved airdrops..." 
            class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-2 pl-9 pr-4 text-xs sm:text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>

        <!-- Status Filter Buttons -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0">
          <button class="filter-status-btn active px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-sm transition-all" data-filter="all">All</button>
          <button class="filter-status-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 transition-all" data-filter="active">Active</button>
          <button class="filter-status-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 transition-all" data-filter="upcoming">Upcoming</button>
          <button class="filter-status-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 transition-all" data-filter="completed">100% Done</button>
        </div>
      </div>

      <!-- Watchlist Items Container -->
      <div id="watchlist-cards-list" class="space-y-6">
        <!-- Dynamically rendered via JS -->
      </div>

      <!-- Empty State Container -->
      <div id="empty-state" class="hidden text-center py-16 px-4 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm max-w-2xl mx-auto my-6">
        <div class="w-20 h-20 rounded-3xl bg-amber-100 dark:bg-amber-950/40 text-amber-500 text-4xl flex items-center justify-center mx-auto mb-6 shadow-inner border border-amber-200 dark:border-amber-800/60">
          ⭐
        </div>
        <h2 class="text-2xl font-black text-slate-900 dark:text-white mb-2">Your Watchlist is Empty</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-8 max-w-md mx-auto leading-relaxed">
          You haven't bookmarked any airdrops yet. Click the star icon (⭐) on any airdrop card to start tracking tasks and deadlines.
        </p>

        <!-- Suggested Starter Drops -->
        <div class="text-left bg-slate-50 dark:bg-slate-800/60 p-5 rounded-2xl border border-slate-200 dark:border-slate-700/80 mb-8">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 block">🔥 Recommended Starter Airdrops</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="quick-add-container">
            <!-- Suggested drops injected via script -->
          </div>
        </div>

        <a href="/" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-xl shadow-lg shadow-blue-500/25 transition-all text-sm">
          <span>⚡</span>
          <span>Explore All 675+ Airdrops</span>
        </a>
      </div>

    </div>
  </main>
</Layout>

<script is:inline define:vars={{ airdropsMap: airdropsLookup }}>
  const STARTER_IDS = ['hyperliquid', 'berachain', 'monad', 'linea'];

  function getWatchlist() {
    try {
      return JSON.parse(localStorage.getItem('airdroplyx_watchlist') || '[]');
    } catch (e) {
      return [];
    }
  }

  function setWatchlist(list) {
    localStorage.setItem('airdroplyx_watchlist', JSON.stringify(list));
    window.dispatchEvent(new Event('watchlistUpdated'));
  }

  function getTaskState(airdropId) {
    try {
      return JSON.parse(localStorage.getItem(`airdrop_tasks_${airdropId}`) || '{}');
    } catch (e) {
      return {};
    }
  }

  function setTaskState(airdropId, state) {
    localStorage.setItem(`airdrop_tasks_${airdropId}`, JSON.stringify(state));
    renderWatchlist();
  }

  // Render Engine
  function renderWatchlist() {
    const watchlistIds = getWatchlist();
    const container = document.getElementById('watchlist-cards-list');
    const emptyState = document.getElementById('empty-state');
    const statsBar = document.getElementById('stats-bar');
    const toolbar = document.getElementById('toolbar-container');
    const searchVal = (document.getElementById('watchlist-search')?.value || '').toLowerCase().trim();
    const activeFilter = document.querySelector('.filter-status-btn.active')?.dataset.filter || 'all';

    if (!container || !emptyState) return;

    if (watchlistIds.length === 0) {
      container.innerHTML = '';
      emptyState.classList.remove('hidden');
      if (statsBar) statsBar.classList.add('hidden');
      if (toolbar) toolbar.classList.add('hidden');
      renderQuickAddSuggestions();
      return;
    }

    emptyState.classList.add('hidden');
    if (statsBar) statsBar.classList.remove('hidden');
    if (toolbar) toolbar.classList.remove('hidden');

    // Filter airdrops
    const matchedAirdrops = watchlistIds
      .map(id => airdropsMap.find(a => a.id === id))
      .filter(Boolean);

    // Calculate aggregated stats
    let totalTasks = 0;
    let completedTasks = 0;
    let tier1Count = 0;

    matchedAirdrops.forEach(a => {
      if (a.tier === 'Tier 1') tier1Count++;
      const taskState = getTaskState(a.id);
      const stepCount = (a.steps || []).length;
      totalTasks += stepCount;
      for (let i = 0; i < stepCount; i++) {
        if (taskState[i]) completedTasks++;
      }
    });

    // Update Stats Bar
    const statTotalCount = document.getElementById('stat-total-count');
    const statTasksDone = document.getElementById('stat-tasks-done');
    const statTasksTotal = document.getElementById('stat-tasks-total');
    const statProgressPct = document.getElementById('stat-progress-pct');
    const statTier1Count = document.getElementById('stat-tier1-count');

    if (statTotalCount) statTotalCount.textContent = matchedAirdrops.length;
    if (statTasksDone) statTasksDone.textContent = completedTasks;
    if (statTasksTotal) statTasksTotal.textContent = `/ ${totalTasks} tasks`;
    const overallPct = totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;
    if (statProgressPct) statProgressPct.textContent = `${overallPct}%`;
    if (statTier1Count) statTier1Count.textContent = tier1Count;

    // Filter by search & filter status
    const displayAirdrops = matchedAirdrops.filter(a => {
      // Search
      const matchesSearch = !searchVal || 
        a.name.toLowerCase().includes(searchVal) || 
        a.category.toLowerCase().includes(searchVal);
      if (!matchesSearch) return false;

      // Filter
      if (activeFilter === 'active') return a.status === 'active';
      if (activeFilter === 'upcoming') return a.status === 'upcoming';
      if (activeFilter === 'completed') {
        const taskState = getTaskState(a.id);
        const steps = a.steps || [];
        return steps.length > 0 && steps.every((_, idx) => taskState[idx]);
      }
      return true;
    });

    if (displayAirdrops.length === 0) {
      container.innerHTML = `
        <div class="text-center py-12 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
          <p class="text-sm font-semibold text-slate-500">No bookmarked airdrops match your search or filter.</p>
        </div>
      `;
      return;
    }

    // Render cards
    container.innerHTML = displayAirdrops.map(airdrop => {
      const taskState = getTaskState(airdrop.id);
      const steps = airdrop.steps || [];
      let doneCount = 0;
      steps.forEach((_, idx) => {
        if (taskState[idx]) doneCount++;
      });
      const progressPct = steps.length > 0 ? Math.round((doneCount / steps.length) * 100) : 0;

      const statusBadge = airdrop.status === 'active' 
        ? '<span class="text-[11px] font-extrabold uppercase px-2.5 py-0.5 rounded-full border bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800">Active</span>'
        : '<span class="text-[11px] font-extrabold uppercase px-2.5 py-0.5 rounded-full border bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border-amber-200 dark:border-amber-800">Upcoming</span>';

      return `
        <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-7 border border-slate-200 dark:border-slate-800 shadow-sm transition-all" data-card-id="${airdrop.id}">
          <!-- Top Row: Protocol Identity & Controls -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-4">
              <img src="${airdrop.logo}" alt="${airdrop.name}" class="w-14 h-14 rounded-2xl bg-slate-50 dark:bg-slate-800 p-1.5 border border-slate-100 dark:border-slate-700 object-cover shrink-0 shadow-sm" />
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                    <a href="/airdrop/${airdrop.id}" class="hover:text-blue-600 transition-colors">${airdrop.name}</a>
                  </h3>
                  ${statusBadge}
                </div>
                <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-medium">
                  <span class="bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md font-semibold text-slate-700 dark:text-slate-300">${airdrop.category}</span>
                  <span>•</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold">${airdrop.reward}</span>
                  <span>•</span>
                  <span>Funding: <strong>${airdrop.funding || 'Undisclosed'}</strong></span>
                </div>
              </div>
            </div>

            <!-- Card Actions -->
            <div class="flex items-center gap-2 self-end sm:self-center">
              <a href="/airdrop/${airdrop.id}" class="px-4 py-2 rounded-xl text-xs font-bold bg-blue-50 hover:bg-blue-100 text-blue-700 dark:bg-blue-950/40 dark:hover:bg-blue-900/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60 transition-all flex items-center gap-1">
                <span>Guide</span>
                <span>&rarr;</span>
              </a>
              <button class="remove-drop-btn p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors" data-id="${airdrop.id}" title="Remove from Watchlist">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="py-4">
            <div class="flex items-center justify-between text-xs font-bold mb-2">
              <span class="text-slate-600 dark:text-slate-300">Farming Checklist Progress</span>
              <span class="${progressPct === 100 ? 'text-emerald-500 font-extrabold' : 'text-blue-600 dark:text-blue-400'}">${doneCount} / ${steps.length} Steps (${progressPct}%)</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 h-2.5 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all duration-300 ${progressPct === 100 ? 'bg-emerald-500' : 'bg-blue-600'}" style="width: ${progressPct}%"></div>
            </div>
          </div>

          <!-- Checklist Items Drawer -->
          <div class="mt-2 space-y-2.5">
            ${steps.map((step, idx) => {
              const isChecked = !!taskState[idx];
              return `
                <div class="task-checkbox-item flex items-start gap-3 p-3 rounded-xl border border-slate-100 dark:border-slate-800/80 bg-slate-50/60 dark:bg-slate-800/40 hover:bg-slate-100/60 dark:hover:bg-slate-800/70 cursor-pointer transition-colors ${isChecked ? 'opacity-50 line-through' : ''}" data-airdrop-id="${airdrop.id}" data-step-idx="${idx}">
                  <input type="checkbox" class="mt-0.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 pointer-events-none" ${isChecked ? 'checked' : ''} />
                  <span class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-medium flex-1">
                    <strong class="text-slate-900 dark:text-white mr-1">Step ${idx + 1}:</strong>
                    ${step}
                  </span>
                </div>
              `;
            }).join('')}
          </div>

        </div>
      `;
    }).join('');

    // Attach Checklist Click Listeners
    container.querySelectorAll('.task-checkbox-item').forEach(el => {
      el.addEventListener('click', () => {
        const airdropId = el.dataset.airdropId;
        const stepIdx = el.dataset.stepIdx;
        const state = getTaskState(airdropId);
        state[stepIdx] = !state[stepIdx];
        setTaskState(airdropId, state);
      });
    });

    // Attach Remove Button Listeners
    container.querySelectorAll('.remove-drop-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idToRemove = btn.dataset.id;
        let list = getWatchlist().filter(id => id !== idToRemove);
        setWatchlist(list);
        renderWatchlist();
      });
    });
  }

  // Quick Add Suggestions for Empty State
  function renderQuickAddSuggestions() {
    const container = document.getElementById('quick-add-container');
    if (!container) return;

    const list = getWatchlist();
    const suggestions = STARTER_IDS
      .map(id => airdropsMap.find(a => a.id === id))
      .filter(Boolean)
      .filter(a => !list.includes(a.id));

    if (suggestions.length === 0) {
      container.parentElement.style.display = 'none';
      return;
    }

    container.parentElement.style.display = 'block';
    container.innerHTML = suggestions.map(a => `
      <div class="flex items-center justify-between p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="flex items-center gap-2.5 min-w-0">
          <img src="${a.logo}" alt="${a.name}" class="w-8 h-8 rounded-lg object-cover" />
          <div class="truncate">
            <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">${a.name}</h4>
            <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">${a.reward}</span>
          </div>
        </div>
        <button class="quick-add-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-700 dark:bg-amber-950/50 dark:hover:bg-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-800 transition-colors shrink-0" data-id="${a.id}">
          + Add
        </button>
      </div>
    `).join('');

    container.querySelectorAll('.quick-add-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        const currentList = getWatchlist();
        if (!currentList.includes(id)) {
          currentList.push(id);
          setWatchlist(currentList);
          renderWatchlist();
        }
      });
    });
  }

  // Export / Import Handlers
  document.getElementById('export-btn')?.addEventListener('click', () => {
    const watchlist = getWatchlist();
    const backupData = {
      version: 1,
      timestamp: new Date().toISOString(),
      watchlist,
      tasks: {}
    };
    watchlist.forEach(id => {
      backupData.tasks[id] = getTaskState(id);
    });

    const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `airdroplyx_watchlist_${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('import-input')?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const data = JSON.parse(event.target.result);
        if (Array.isArray(data.watchlist)) {
          localStorage.setItem('airdroplyx_watchlist', JSON.stringify(data.watchlist));
          if (data.tasks) {
            Object.entries(data.tasks).forEach(([id, state]) => {
              localStorage.setItem(`airdrop_tasks_${id}`, JSON.stringify(state));
            });
          }
          window.dispatchEvent(new Event('watchlistUpdated'));
          renderWatchlist();
          alert('Watchlist successfully restored! ✓');
        } else {
          alert('Invalid backup file format.');
        }
      } catch (err) {
        alert('Failed to parse backup file.');
      }
    };
    reader.readAsText(file);
  });

  document.getElementById('clear-watchlist-btn')?.addEventListener('click', () => {
    if (confirm('Are you sure you want to clear your entire watchlist?')) {
      setWatchlist([]);
      renderWatchlist();
    }
  });

  // Filter Buttons
  document.querySelectorAll('.filter-status-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-status-btn').forEach(b => {
        b.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-sm');
        b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
      });
      btn.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-sm');
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
      renderWatchlist();
    });
  });

  document.getElementById('watchlist-search')?.addEventListener('input', renderWatchlist);

  document.addEventListener('DOMContentLoaded', () => {
    renderWatchlist();
    window.addEventListener('watchlistUpdated', renderWatchlist);
  });
</script>
