---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import AirdropCard from '../components/AirdropCard.astro';
import { airdrops } from '../data/airdrops';
import { academyArticles } from '../data/academy';

// Current anchor date
const currentDate = '2026-09-19';

// Active drops (published today or in the past, and currently active/pre-TGE)
const activeAirdrops = airdrops.filter(a => (!a.publishDate || a.publishDate <= currentDate) && a.status === 'active');
const latestAirdrops = activeAirdrops;
const hottestAirdrops = activeAirdrops.filter(a => a.featured);

// 1-Week Scheduled Drops
const scheduledAirdrops = airdrops.filter(a => a.publishDate && a.publishDate > currentDate && a.status === 'active');

// Past / Concluded Airdrops (Historical TGEs)
const endedAirdrops = airdrops.filter(a => a.status === 'ended');
---

<Layout title="Crypto Airdrops 2026 » Verified Guides, Free Tokens & Testnets | Airdroplyx">
  <Header />
  
  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-slate-950 via-slate-900 to-slate-800 text-white py-16 md:py-20 border-b-4 border-blue-600">
    <div class="max-w-[1200px] mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-400/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-6">
        <span>⚡</span> Updated Hourly • Verified Opportunities
      </div>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-6 leading-tight">
        Claim Your Share of <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400">Crypto Airdrops</span>
      </h1>
      <p class="text-base md:text-xl text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
        Your trusted source for verified cryptocurrency airdrops, testnet incentives, and DeFi yield strategies. Zero guesswork, zero scams.
      </p>
      
      <!-- Newsletter inside Hero -->
      <form id="newsletter" class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto bg-white/10 p-2 rounded-2xl backdrop-blur-sm border border-white/20 shadow-2xl">
        <input type="email" placeholder="Enter your email address..." class="flex-1 bg-white rounded-xl px-4 py-3 text-slate-900 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm md:text-base" required />
        <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl px-6 py-3 transition-colors shadow-lg shadow-blue-500/30 whitespace-nowrap">
          Subscribe Free
        </button>
      </form>
      <p class="text-xs text-slate-400 mt-4">Join 25,000+ airdrop hunters. Daily alerts, no spam.</p>
    </div>
  </div>

  <!-- Main Content Area -->
  <main class="max-w-[1200px] mx-auto px-4 py-16">
    
    <!-- Airdrops Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-20">
      
      <!-- Latest Drops -->
      <section id="latest" class="space-y-6">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-600 dark:text-blue-400 font-bold text-lg">
              ⚡
            </div>
            <div>
              <h2 class="text-xl font-extrabold text-slate-900 dark:text-white uppercase tracking-tight">Latest Airdrops</h2>
              <p class="text-xs text-slate-500">Freshly added and active campaigns</p>
            </div>
          </div>
          <span class="text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 px-3 py-1 rounded-full">
            {latestAirdrops.length} Active
          </span>
        </div>

        <div class="flex flex-col gap-4">
          {latestAirdrops.map(airdrop => (
            <AirdropCard airdrop={airdrop} />
          ))}
        </div>
      </section>

      <!-- Hottest Drops -->
      <section id="hottest" class="space-y-6">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-700 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange-100 dark:bg-orange-900/40 flex items-center justify-center text-orange-600 dark:text-orange-400 font-bold text-lg">
              🔥
            </div>
            <div>
              <h2 class="text-xl font-extrabold text-slate-900 dark:text-white uppercase tracking-tight">Featured & Confirmed</h2>
              <p class="text-xs text-slate-500">Highest funding & confirmed token pools</p>
            </div>
          </div>
          <span class="text-xs font-semibold bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-300 px-3 py-1 rounded-full">
            Top Tier
          </span>
        </div>

        <div class="flex flex-col gap-4">
          {hottestAirdrops.map(airdrop => (
            <AirdropCard airdrop={airdrop} />
          ))}
        </div>
      </section>

    </div>

    <!-- 7-Day Drops Schedule Section (2 Drops per day) -->
    {scheduledAirdrops.length > 0 && (
      <section id="schedule" class="mb-20 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 md:p-10 text-white border border-indigo-500/20 shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 right-0 -mt-10 -mr-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 relative z-10">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-bold uppercase tracking-wider mb-3">
              <span>📅</span> 1-Week Publishing Schedule
            </div>
            <h2 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
              Upcoming Airdrop Releases (2 Per Day)
            </h2>
            <p class="text-sm text-slate-300 mt-1 max-w-xl">
              Curated roadmap of high-potential cryptocurrency airdrops unlocked daily. Explore comprehensive early research guides and prepare your wallets.
            </p>
          </div>
          <span class="mt-4 md:mt-0 text-xs font-semibold bg-white/10 text-indigo-200 px-4 py-2 rounded-full border border-white/10">
            {scheduledAirdrops.length} Drops Scheduled This Week
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10">
          {scheduledAirdrops.map(airdrop => (
            <div class="bg-white/5 hover:bg-white/10 border border-white/10 hover:border-indigo-400/40 rounded-2xl p-5 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-300 bg-indigo-500/20 border border-indigo-400/30 px-3 py-1 rounded-full">
                    📅 Drops {airdrop.publishDate}
                  </span>
                  <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                    {airdrop.category}
                  </span>
                </div>

                <div class="flex items-center gap-3 mb-3">
                  <div class="w-12 h-12 rounded-xl bg-white/10 border border-white/10 p-2 flex items-center justify-center shrink-0">
                    <img src={airdrop.logo} alt={airdrop.name} class="w-full h-full object-contain" loading="lazy" />
                  </div>
                  <div>
                    <h3 class="font-bold text-lg text-white group-hover:text-indigo-300 transition-colors">
                      <a href={`/airdrop/${airdrop.id}`}>{airdrop.name}</a>
                    </h3>
                    <span class="text-xs text-emerald-400 font-medium">{airdrop.reward}</span>
                  </div>
                </div>

                <p class="text-xs text-slate-300 line-clamp-2 mb-4 leading-relaxed">
                  {airdrop.description}
                </p>
              </div>

              <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                <span class="text-xs text-slate-400">Funding: <strong class="text-white">{airdrop.funding}</strong></span>
                <a href={`/airdrop/${airdrop.id}`} class="text-xs font-bold text-indigo-400 group-hover:text-indigo-300 flex items-center gap-1">
                  Preview Guide →
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Concluded / Past Airdrops Archive -->
    {endedAirdrops.length > 0 && (
      <section id="concluded" class="mb-20 bg-slate-50 dark:bg-slate-900/50 rounded-3xl p-6 md:p-10 border border-slate-200 dark:border-slate-800">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-bold uppercase tracking-wider mb-2">
              <span>🏛️</span> Historical Records
            </div>
            <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
              Concluded Airdrops & Past TGEs
            </h2>
            <p class="text-xs md:text-sm text-slate-500 dark:text-slate-400 mt-1">
              Token Generation Events (TGE) that have completed their distribution snapshot. Documented for historical reference.
            </p>
          </div>
          <span class="mt-4 md:mt-0 text-xs font-semibold bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 px-3.5 py-1.5 rounded-full">
            {endedAirdrops.length} Archived Drops
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {endedAirdrops.map(airdrop => (
            <div class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200 dark:border-slate-700 flex items-center justify-between group hover:border-slate-300 transition-all">
              <div class="flex items-center gap-3 min-w-0">
                <img src={airdrop.logo} alt={airdrop.name} class="w-10 h-10 rounded-xl object-contain bg-slate-50 p-1 border border-slate-100 dark:border-slate-700 shrink-0" loading="lazy" />
                <div class="min-w-0">
                  <h3 class="font-bold text-sm text-slate-800 dark:text-white group-hover:text-blue-600 transition-colors truncate">
                    <a href={`/airdrop/${airdrop.id}`}>{airdrop.name}</a>
                  </h3>
                  <span class="text-[11px] text-slate-400 block truncate">{airdrop.category}</span>
                </div>
              </div>
              <span class="text-[10px] font-bold text-slate-400 bg-slate-100 dark:bg-slate-700 px-2.5 py-1 rounded-md shrink-0">
                TGE Ended
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Academy Section (AdSense & SEO Booster) -->
    <section class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-800">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
        <div>
          <span class="text-blue-600 font-bold text-xs uppercase tracking-wider">Learn & Earn</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-1">
            Airdrop Academy Guides
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Master the art of Web3 retroactive farming with our complete educational tutorials.
          </p>
        </div>
        <a href="/academy" class="mt-4 md:mt-0 text-sm font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 group">
          View all {academyArticles.length} tutorials <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {academyArticles.slice(0, 3).map(article => (
          <a href={`/academy/${article.slug}`} class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-lg transition-all group flex flex-col">
            <div class="aspect-video w-full overflow-hidden bg-slate-100">
              <img src={article.image} alt={article.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-blue-600 transition-colors line-clamp-2 mb-2">
                  {article.title}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed">
                  {article.excerpt}
                </p>
              </div>
              <span class="text-xs font-bold text-blue-600 mt-4 inline-block">Read Full Guide →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </main>
</Layout>
