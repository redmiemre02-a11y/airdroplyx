---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { airdrops } from '../../data/airdrops';
import { newsArticles } from '../../data/news';
import { ecosystems } from '../../data/ecosystems';

export function getStaticPaths() {
  return airdrops.map(airdrop => ({
    params: { id: airdrop.id },
    props: { airdrop },
  }));
}

const { airdrop } = Astro.props;
const matchedEcosystem = ecosystems.find(e => e.match(airdrop));
const ecosystemUrl = matchedEcosystem ? `/ecosystem/${matchedEcosystem.slug}/` : '/ecosystems/';
const ecosystemLabel = matchedEcosystem ? matchedEcosystem.name : airdrop.category;

const sameCategoryDrops = airdrops.filter(a => a.id !== airdrop.id && a.category === airdrop.category);
const relatedAirdrops = (sameCategoryDrops.length >= 3 ? sameCategoryDrops : airdrops.filter(a => a.id !== airdrop.id)).slice(0, 4);

const relatedNews = newsArticles.filter(
  n => n.relatedAirdropId === airdrop.id || n.title.toLowerCase().includes(airdrop.name.toLowerCase())
).slice(0, 3);

const isTelegramDrop = /telegram/i.test(airdrop.category) || /telegram/i.test(airdrop.description);
const pageUrl = `https://airdroplyx.com/airdrop/${airdrop.id}/`;
const shareText = encodeURIComponent(`${airdrop.name} Airdrop Guide (2026) — Reward: ${airdrop.reward}. Step-by-step claim guide:`);
const telegramShareUrl = `https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${shareText}`;
const xShareUrl = `https://x.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${shareText}`;
const lastVerifiedDate = airdrop.publishDate || '2026-11-13';
---

<Layout 
  title={`${airdrop.name} Airdrop Guide & Verification (2026) | Airdroplyx`} 
  description={`Complete step-by-step guide to farming the confirmed ${airdrop.name} crypto airdrop. Verified requirements, funding stats, and strategy.`}
  image={airdrop.logo}
>
  <!-- Schema.org JSON-LD (HowTo, FAQPage, BreadcrumbList) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://airdroplyx.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": ecosystemLabel,
            "item": `https://airdroplyx.com${ecosystemUrl}`
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": airdrop.name,
            "item": `https://airdroplyx.com/airdrop/${airdrop.id}/`
          }
        ]
      },
      {
        "@type": "HowTo",
        "name": `How to Claim and Farm the ${airdrop.name} Airdrop`,
        "description": airdrop.description,
        "image": airdrop.logo,
        "totalTime": "PT10M",
        "step": airdrop.steps.map((step, idx) => ({
          "@type": "HowToStep",
          "position": idx + 1,
          "name": `Step ${idx + 1}`,
          "text": step.replace(/<[^>]*>/g, '')
        }))
      },
      ...(airdrop.faqs && airdrop.faqs.length > 0 ? [{
        "@type": "FAQPage",
        "mainEntity": airdrop.faqs.map(faq => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      }] : [])
    ]
  })} />

  <Header />
  
  <main class="max-w-[1000px] mx-auto px-4 py-10">
    <!-- Breadcrumbs -->
    <nav class="text-sm text-slate-500 dark:text-slate-400 mb-6 flex flex-wrap items-center gap-2" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
      <span>/</span>
      <a href={ecosystemUrl} class="hover:text-blue-600 transition-colors font-medium">{ecosystemLabel}</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">{airdrop.name}</span>
    </nav>

    <!-- Top Card -->
    <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-10 border border-slate-200 dark:border-slate-700 shadow-sm mb-10">
      <div class="flex flex-col md:flex-row gap-6 items-start md:items-center justify-between border-b border-slate-100 dark:border-slate-700 pb-8 mb-8">
        <div class="flex items-center gap-5">
          <img src={airdrop.logo} alt={airdrop.name} class="w-20 h-20 md:w-24 md:h-24 rounded-2xl object-contain bg-slate-50 dark:bg-slate-700 p-2 border border-slate-200 dark:border-slate-600 shadow-sm" />
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300 text-xs font-bold px-2.5 py-0.5 rounded-full uppercase">
                {airdrop.status}
              </span>
              <span class="bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300 text-xs font-semibold px-2.5 py-0.5 rounded-full">
                {airdrop.category}
              </span>
              {airdrop.featured && (
                <span class="bg-orange-100 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300 text-xs font-bold px-2.5 py-0.5 rounded-full">
                  🔥 HOT
                </span>
              )}
            </div>
            <h1 class="text-2xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
              {airdrop.name} Airdrop
            </h1>
            <p class="text-sm md:text-base text-slate-500 dark:text-slate-400 mt-1 max-w-xl">
              {airdrop.description}
            </p>
          </div>
        </div>

        <div class="w-full md:w-auto shrink-0 flex flex-col sm:flex-row md:flex-col items-center gap-2.5">
          {airdrop.refLink && (
            <a href={airdrop.refLink} target="_blank" rel="noopener noreferrer" class="w-full md:w-auto bg-blue-600 hover:bg-blue-700 text-white font-black text-center py-3.5 px-8 rounded-2xl shadow-xl shadow-blue-500/25 transition-all hover:-translate-y-0.5 flex items-center justify-center gap-2 text-base">
              <span>🚀</span> Join Airdrop Portal
            </a>
          )}
          <button 
            type="button" 
            id="detail-watchlist-btn"
            data-id={airdrop.id}
            class="w-full md:w-auto bg-white dark:bg-slate-800 hover:bg-amber-50 dark:hover:bg-amber-950/30 text-slate-700 dark:text-slate-200 font-bold py-2.5 px-5 rounded-2xl border border-slate-200 dark:border-slate-700 flex items-center justify-center gap-2 transition-all text-xs sm:text-sm shadow-sm"
          >
            <span class="detail-star-icon text-slate-400">★</span>
            <span class="detail-watchlist-text">Save to Watchlist</span>
          </button>
          <div class="flex items-center gap-2 w-full md:w-auto">
            <a href={telegramShareUrl} target="_blank" rel="noopener noreferrer" class="flex-1 md:flex-none inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-sky-50 dark:bg-sky-950/40 hover:bg-sky-100 dark:hover:bg-sky-900/50 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800/60 text-xs font-bold transition-colors" title="Share on Telegram">
              <span>✈️</span> Share
            </a>
            <a href={xShareUrl} target="_blank" rel="noopener noreferrer" class="flex-1 md:flex-none inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-700/60 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-600 text-xs font-bold transition-colors" title="Share on X">
              <span>𝕏</span> Post
            </a>
          </div>
        </div>
      </div>

      <!-- E-E-A-T Verification & Freshness Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5 px-4 py-2.5 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-200/70 dark:border-emerald-900/40 text-xs">
        <div class="flex flex-wrap items-center gap-3 text-emerald-800 dark:text-emerald-300 font-semibold">
          <span>✅ Last Verified: <strong>{lastVerifiedDate}</strong></span>
          <span class="hidden sm:inline text-emerald-400">•</span>
          <a href="/fact-checking" class="hover:underline">Reviewed by Airdroplyx Research Desk</a>
        </div>
        <a href={ecosystemUrl} class="font-bold text-sky-700 dark:text-sky-400 hover:underline">
          Explore all {ecosystemLabel} →
        </a>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-2xl border border-slate-100 dark:border-slate-700">
        <div>
          <span class="text-xs text-slate-400 font-medium uppercase">Reward Potential</span>
          <p class="text-base font-bold text-emerald-600 dark:text-emerald-400">{airdrop.reward}</p>
        </div>
        <div>
          <span class="text-xs text-slate-400 font-medium uppercase">Total Funding</span>
          <p class="text-base font-bold text-slate-800 dark:text-white">{airdrop.funding}</p>
        </div>
        <div>
          <span class="text-xs text-slate-400 font-medium uppercase">Ecosystem</span>
          <p class="text-base font-bold text-slate-800 dark:text-white">{airdrop.category}</p>
        </div>
        <div>
          <span class="text-xs text-slate-400 font-medium uppercase">Key Backers</span>
          <p class="text-base font-bold text-slate-800 dark:text-white truncate" title={airdrop.investors}>{airdrop.investors}</p>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Overview Section -->
        <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm">
          <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
            <span>📖</span> Protocol Overview & Significance
          </h2>
          <div class="text-slate-600 dark:text-slate-300 space-y-4 leading-relaxed text-base">
            {airdrop.overview.split('\n\n').map(paragraph => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        <!-- Strategy Box -->
        {airdrop.strategy && (
          <section class="bg-gradient-to-r from-amber-50 to-orange-50 dark:from-slate-800 dark:to-slate-800 border-l-4 border-amber-500 rounded-r-3xl p-6 md:p-8 shadow-sm">
            <h3 class="text-amber-900 dark:text-amber-400 font-black text-lg mb-2 flex items-center gap-2">
              <span>🎯</span> Pro Farming Strategy & Multipliers
            </h3>
            <div class="text-amber-950 dark:text-slate-200 leading-relaxed font-medium space-y-3">
              {airdrop.strategy.split('\n\n').map(p => (
                <p>{p}</p>
              ))}
            </div>
          </section>
        )}

        <!-- Tokenomics & Allocation Deep-Dive -->
        {airdrop.tokenomics && (
          <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm">
            <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
              <span>📊</span> Tokenomics, Allocation & Vesting
            </h2>
            <div class="text-slate-600 dark:text-slate-300 space-y-4 leading-relaxed text-base">
              {airdrop.tokenomics.split('\n\n').map(paragraph => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        )}

        <!-- Anti-Sybil & Eligibility Protection -->
        {airdrop.sybilSafety && (
          <section class="bg-emerald-50/70 dark:bg-slate-800 border-l-4 border-emerald-500 rounded-r-3xl p-6 md:p-8 shadow-sm">
            <h3 class="text-emerald-900 dark:text-emerald-400 font-black text-lg mb-2 flex items-center gap-2">
              <span>🛡️</span> Sybil Protection & Snapshot Defense
            </h3>
            <div class="text-emerald-950 dark:text-slate-200 leading-relaxed font-medium space-y-3">
              {airdrop.sybilSafety.split('\n\n').map(p => (
                <p>{p}</p>
              ))}
            </div>
          </section>
        )}

        <!-- Interactive Gamified Step-by-Step Tracker -->
        <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm" id="step-tracker-section">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-100 dark:border-slate-700/60">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-2xl">📝</span>
                <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white">
                  Step-by-Step Farming Tracker
                </h2>
              </div>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
                Track your farming progress. Your checklist saves automatically in your browser.
              </p>
            </div>
            
            <div class="flex items-center gap-3 self-start sm:self-auto">
              <span id="step-progress-pct" class="text-sm font-black bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 px-3 py-1.5 rounded-xl border border-blue-200 dark:border-blue-800">
                0%
              </span>
              <button 
                type="button" 
                id="step-reset-btn" 
                class="text-xs font-semibold text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
                title="Reset all steps"
              >
                ↺ Reset
              </button>
            </div>
          </div>

          <!-- Progress Bar & Status Counter -->
          <div class="mb-6 bg-slate-50 dark:bg-slate-700/30 p-4 rounded-2xl border border-slate-100 dark:border-slate-700/60">
            <div class="flex items-center justify-between text-xs font-bold mb-2">
              <span class="text-slate-700 dark:text-slate-300" id="step-progress-text">
                0 of {airdrop.steps.length} Steps Completed
              </span>
              <span class="text-slate-400 dark:text-slate-500 text-[11px]">Snapshot Readiness</span>
            </div>
            <div class="w-full h-3 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden p-0.5 shadow-inner">
              <div 
                id="step-progress-bar" 
                class="h-full bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-500 rounded-full transition-all duration-500 ease-out shadow-sm" 
                style="width: 0%;"
              ></div>
            </div>
          </div>

          <!-- Celebratory 100% Completion Banner -->
          <div id="step-complete-banner" class="hidden mb-6 p-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white shadow-lg shadow-emerald-500/20 animate-fade-in flex items-center gap-3.5">
            <span class="text-3xl shrink-0">🎉</span>
            <div>
              <h4 class="font-black text-sm md:text-base">Farming Checklist Complete!</h4>
              <p class="text-xs text-emerald-100 leading-relaxed">
                You've completed all verified requirements for {airdrop.name}. Keep active with weekly transactions to defend your Sybil score!
              </p>
            </div>
          </div>

          <!-- Checklist Items -->
          <div class="space-y-3.5" id="task-checklist" data-airdrop-id={airdrop.id}>
            {airdrop.steps.map((step, index) => (
              <div 
                class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/80 dark:border-slate-600/80 hover:border-blue-400 dark:hover:border-blue-500 transition-all group cursor-pointer task-item select-none" 
                data-index={index}
              >
                <div class="mt-0.5 shrink-0 relative flex items-center justify-center">
                  <input 
                    type="checkbox" 
                    id={`step-${index}`} 
                    class="step-checkbox w-5 h-5 rounded-lg border-2 border-slate-300 dark:border-slate-500 text-emerald-600 focus:ring-0 cursor-pointer transition-colors"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <span class="font-extrabold text-xs uppercase tracking-wider text-slate-800 dark:text-slate-200 step-number-label">
                      Step {index + 1}
                    </span>
                    <span class="step-status-badge text-[11px] font-bold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded-md">
                      To-Do
                    </span>
                  </div>
                  <div class="text-sm md:text-base text-slate-700 dark:text-slate-300 leading-relaxed font-medium step-text-content">
                    <span set:html={step} />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Daily Combos Cross-Link for Telegram Mini-Apps -->
        {isTelegramDrop && (
          <section class="bg-gradient-to-r from-sky-600 to-indigo-700 rounded-3xl p-6 text-white shadow-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="text-[11px] font-black uppercase tracking-wider text-sky-200 mb-1">Daily Multiplier Hub</div>
              <h3 class="text-lg font-black">Looking for Today's Secret Codes &amp; Daily Combos?</h3>
              <p class="text-xs sm:text-sm text-sky-100 mt-0.5">Check reset timers, Morse ciphers, and daily combo guides for top Telegram mini-apps.</p>
            </div>
            <a href="/daily-combos/" class="shrink-0 bg-white text-indigo-700 hover:bg-sky-50 font-black text-xs sm:text-sm px-5 py-3 rounded-xl shadow transition-colors">
              Open Daily Combos Hub →
            </a>
          </section>
        )}

        <!-- Related News & Alpha Coverage -->
        {relatedNews.length > 0 && (
          <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm">
            <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white mb-5 flex items-center gap-2">
              <span>📰</span> Latest {airdrop.name} News &amp; Updates
            </h2>
            <div class="space-y-4">
              {relatedNews.map(news => (
                <a href={`/news/${news.slug}/`} class="block p-4 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/80 dark:border-slate-600/80 hover:border-sky-400 dark:hover:border-sky-500 transition-all group">
                  <div class="flex items-center gap-2 text-[11px] font-bold text-rose-600 dark:text-rose-400 uppercase mb-1">
                    <span>{news.category}</span>
                    <span class="text-slate-400">•</span>
                    <span class="text-slate-500 dark:text-slate-400 font-medium">{news.date}</span>
                  </div>
                  <h3 class="font-extrabold text-slate-900 dark:text-white text-base group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors mb-1">
                    {news.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-2">{news.excerpt}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- FAQs -->
        {airdrop.faqs && airdrop.faqs.length > 0 && (
          <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm">
            <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
              <span>❓</span> Frequently Asked Questions
            </h2>
            <div class="space-y-4">
              {airdrop.faqs.map(faq => (
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/80 dark:border-slate-600/80">
                  <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">{faq.question}</h3>
                  <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">{faq.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Important Risk Disclaimer & DYOR Warning -->
        <section class="bg-amber-50/70 dark:bg-amber-950/20 border border-amber-200/80 dark:border-amber-900/40 rounded-3xl p-6 md:p-8 shadow-sm">
          <div class="flex items-start gap-4">
            <span class="text-3xl shrink-0">⚠️</span>
            <div class="space-y-2">
              <h3 class="text-base md:text-lg font-black text-amber-900 dark:text-amber-200 uppercase tracking-wide">
                Important Disclaimer: Not Financial Advice &amp; Safety Notice
              </h3>
              <p class="text-xs sm:text-sm text-amber-900/90 dark:text-amber-300 leading-relaxed font-normal">
                This guide for <strong>{airdrop.name}</strong> is published strictly for educational and informational research purposes. Airdrop participation, testnet tasks, and smart contract interactions involve technical and financial risks. <strong>Airdroplyx is not a financial advisor, broker, or custodian</strong>, does not provide investment, legal, or tax advice, and cannot guarantee token allocations, eligibility, or future monetary value.
              </p>
              <p class="text-xs text-amber-800 dark:text-amber-400 font-medium pt-1">
                Always conduct your own due diligence (DYOR), use a dedicated burner wallet with zero primary funds, and never share your seed phrase or private keys. <a href="/disclaimer" class="underline font-bold hover:text-amber-600 dark:hover:text-amber-200">Read our full Risk Disclaimer &rarr;</a>
              </p>
              <div class="pt-2 text-[11px] text-amber-800/80 dark:text-amber-400/70 border-t border-amber-200/60 dark:border-amber-900/40 flex items-center gap-1.5">
                <span>🔗</span> <strong>Affiliate Disclosure:</strong> External links to registration portals may be referral links that help maintain this free database at zero cost to you.
              </div>
            </div>
          </div>
        </section>

      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <!-- CTA Card -->
        {airdrop.refLink && (
          <div class="bg-gradient-to-br from-blue-600 to-indigo-700 text-white rounded-3xl p-6 text-center shadow-lg shadow-blue-500/20">
            <h3 class="font-extrabold text-xl mb-2">Ready to Start Farming?</h3>
            <p class="text-sm text-blue-100 mb-6">Join through the official portal to secure your referral bonus points.</p>
            <a href={airdrop.refLink} target="_blank" rel="noopener noreferrer" class="block w-full bg-white text-blue-700 hover:bg-blue-50 font-black py-3.5 px-4 rounded-xl shadow-md transition-all hover:scale-[1.02]">
              Launch {airdrop.name} ↗
            </a>
          </div>
        )}

        <!-- Community Sentiment Vote Card -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm" id="community-vote-card" data-airdrop-id={airdrop.id}>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-extrabold text-slate-900 dark:text-white text-base flex items-center gap-2">
              <span>🗳️</span> Community Vote
            </h3>
            <span class="text-[11px] text-slate-400 dark:text-slate-500 font-bold" id="vote-total-label">Loading votes...</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 leading-relaxed">
            Will farming <strong>{airdrop.name}</strong> yield a high-value airdrop allocation?
          </p>

          <!-- Sentiment Meter -->
          <div class="mb-4">
            <div class="flex items-center justify-between text-xs font-black mb-1.5">
              <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <span>🚀 Bullish</span>
                <span id="vote-bullish-pct">--%</span>
              </span>
              <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                <span id="vote-bearish-pct">--%</span>
                <span>⚠️ Pass</span>
              </span>
            </div>
            <div class="h-2.5 w-full bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden flex shadow-inner">
              <div id="vote-bar-bullish" class="bg-emerald-500 h-full transition-all duration-500 rounded-l-full" style="width: 50%;"></div>
              <div id="vote-bar-bearish" class="bg-rose-500 h-full transition-all duration-500 rounded-r-full" style="width: 50%;"></div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="grid grid-cols-2 gap-2.5">
            <button 
              type="button" 
              id="btn-vote-bullish" 
              class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50/60 dark:bg-emerald-950/20 hover:bg-emerald-100 dark:hover:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 font-extrabold text-xs transition-all active:scale-95 shadow-sm"
            >
              <span>🚀</span>
              <span>Bullish</span>
            </button>
            <button 
              type="button" 
              id="btn-vote-bearish" 
              class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-700/50 hover:bg-rose-50 dark:hover:bg-rose-950/20 hover:border-rose-200 dark:hover:border-rose-800 text-slate-700 dark:text-slate-300 hover:text-rose-700 dark:hover:text-rose-300 font-extrabold text-xs transition-all active:scale-95 shadow-sm"
            >
              <span>⚠️</span>
              <span>Pass</span>
            </button>
          </div>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 text-center mt-3 font-medium" id="vote-status-hint">
            Cast your vote to shape community hunter sentiment.
          </p>
        </div>

        <!-- Safety Checklist Card -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm">
          <h3 class="font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
            <span>🛡️</span> Security Tips
          </h3>
          <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-3">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Always use a dedicated burner wallet for dApp interactions.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Never share your secret recovery phrase with anyone.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Revoke smart contract approvals regularly via Revoke.cash.</span>
            </li>
          </ul>
        </div>

        <!-- Related Drops -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm">
          <h3 class="font-bold text-slate-900 dark:text-white mb-4">Other Hot Airdrops</h3>
          <div class="space-y-3">
            {relatedAirdrops.map(item => (
              <a href={`/airdrop/${item.id}`} class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
                <img src={item.logo} alt={item.name} class="w-10 h-10 rounded-lg object-contain bg-slate-50 dark:bg-slate-600 p-1 border border-slate-200 dark:border-slate-500" />
                <div class="flex-1 min-w-0">
                  <h4 class="text-sm font-bold text-slate-800 dark:text-white truncate">{item.name}</h4>
                  <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">{item.reward}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<script is:inline>
  // 1. Enhanced Gamified Step-by-Step Tracker
  const checklist = document.getElementById('task-checklist');
  if (checklist) {
    const airdropId = checklist.dataset.airdropId;
    const storageKey = `airdrop_tasks_${airdropId}`;
    let state = {};
    try {
      state = JSON.parse(localStorage.getItem(storageKey) || '{}');
    } catch (e) {
      state = {};
    }

    const taskItems = checklist.querySelectorAll('.task-item');
    const progressBar = document.getElementById('step-progress-bar');
    const progressText = document.getElementById('step-progress-text');
    const progressPct = document.getElementById('step-progress-pct');
    const completeBanner = document.getElementById('step-complete-banner');
    const resetBtn = document.getElementById('step-reset-btn');

    function updateProgress() {
      const total = taskItems.length;
      let completed = 0;
      taskItems.forEach(item => {
        const idx = item.dataset.index;
        const cb = item.querySelector('input[type="checkbox"]');
        const badge = item.querySelector('.step-status-badge');
        const isChecked = !!state[idx];

        if (cb) cb.checked = isChecked;

        if (isChecked) {
          item.classList.add('bg-emerald-50/70', 'dark:bg-emerald-950/20', 'border-emerald-300', 'dark:border-emerald-700/60');
          item.classList.remove('bg-slate-50', 'dark:bg-slate-700/40', 'border-slate-200/80', 'dark:border-slate-600/80');
          if (badge) {
            badge.textContent = '✓ Done';
            badge.className = 'step-status-badge text-[11px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-100 dark:bg-emerald-900/40 px-2 py-0.5 rounded-md';
          }
          completed++;
        } else {
          item.classList.remove('bg-emerald-50/70', 'dark:bg-emerald-950/20', 'border-emerald-300', 'dark:border-emerald-700/60');
          item.classList.add('bg-slate-50', 'dark:bg-slate-700/40', 'border-slate-200/80', 'dark:border-slate-600/80');
          if (badge) {
            badge.textContent = 'To-Do';
            badge.className = 'step-status-badge text-[11px] font-bold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded-md';
          }
        }
      });

      const pct = total > 0 ? Math.round((completed / total) * 100) : 0;
      if (progressBar) progressBar.style.width = `${pct}%`;
      if (progressText) progressText.textContent = `${completed} of ${total} Steps Completed`;
      if (progressPct) progressPct.textContent = `${pct}%`;

      if (completeBanner) {
        if (completed === total && total > 0) {
          completeBanner.classList.remove('hidden');
        } else {
          completeBanner.classList.add('hidden');
        }
      }
    }

    taskItems.forEach(item => {
      const idx = item.dataset.index;
      item.addEventListener('click', () => {
        state[idx] = !state[idx];
        localStorage.setItem(storageKey, JSON.stringify(state));
        updateProgress();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', (e) => {
        e.preventDefault();
        state = {};
        localStorage.removeItem(storageKey);
        updateProgress();
      });
    }

    updateProgress();
  }

  // 2. Community Sentiment Vote System
  const voteCard = document.getElementById('community-vote-card');
  if (voteCard) {
    const airdropId = voteCard.dataset.airdropId;
    const voteKey = `airdrop_vote_${airdropId}`;

    function hashStr(str) {
      let hash = 0;
      for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i);
        hash |= 0;
      }
      return Math.abs(hash);
    }

    const seed = hashStr(airdropId);
    let baseTotal = 430 + (seed % 1200);
    const baseBullishPct = 78 + (seed % 17); // 78% to 94%
    let baseBullish = Math.round((baseTotal * baseBullishPct) / 100);
    let baseBearish = baseTotal - baseBullish;

    let userVote = localStorage.getItem(voteKey); // 'bullish', 'bearish', or null

    const bullishBtn = document.getElementById('btn-vote-bullish');
    const bearishBtn = document.getElementById('btn-vote-bearish');
    const bullishPctLabel = document.getElementById('vote-bullish-pct');
    const bearishPctLabel = document.getElementById('vote-bearish-pct');
    const barBullish = document.getElementById('vote-bar-bullish');
    const barBearish = document.getElementById('vote-bar-bearish');
    const totalLabel = document.getElementById('vote-total-label');
    const hintLabel = document.getElementById('vote-status-hint');

    function renderVotes() {
      let curBullish = baseBullish;
      let curBearish = baseBearish;
      let curTotal = baseTotal;

      if (userVote === 'bullish') {
        curBullish += 1;
        curTotal += 1;
      } else if (userVote === 'bearish') {
        curBearish += 1;
        curTotal += 1;
      }

      const bullPct = Math.round((curBullish / curTotal) * 100);
      const bearPct = 100 - bullPct;

      if (bullishPctLabel) bullishPctLabel.textContent = `${bullPct}%`;
      if (bearishPctLabel) bearishPctLabel.textContent = `${bearPct}%`;
      if (barBullish) barBullish.style.width = `${bullPct}%`;
      if (barBearish) barBearish.style.width = `${bearPct}%`;
      if (totalLabel) totalLabel.textContent = `${curTotal.toLocaleString()} votes`;

      if (userVote === 'bullish') {
        bullishBtn?.classList.add('ring-2', 'ring-emerald-500', 'bg-emerald-100', 'dark:bg-emerald-900/50');
        bearishBtn?.classList.remove('ring-2', 'ring-rose-500', 'bg-rose-100', 'dark:bg-rose-900/50');
        if (hintLabel) hintLabel.textContent = '✓ You voted: Bullish! Thanks for contributing.';
      } else if (userVote === 'bearish') {
        bearishBtn?.classList.add('ring-2', 'ring-rose-500', 'bg-rose-100', 'dark:bg-rose-900/50');
        bullishBtn?.classList.remove('ring-2', 'ring-emerald-500', 'bg-emerald-100', 'dark:bg-emerald-900/50');
        if (hintLabel) hintLabel.textContent = '✓ You voted: Pass. Thanks for contributing.';
      } else {
        bullishBtn?.classList.remove('ring-2', 'ring-emerald-500', 'bg-emerald-100', 'dark:bg-emerald-900/50');
        bearishBtn?.classList.remove('ring-2', 'ring-rose-500', 'bg-rose-100', 'dark:bg-rose-900/50');
        if (hintLabel) hintLabel.textContent = 'Cast your vote to shape community hunter sentiment.';
      }
    }

    bullishBtn?.addEventListener('click', () => {
      if (userVote === 'bullish') {
        userVote = null;
        localStorage.removeItem(voteKey);
      } else {
        userVote = 'bullish';
        localStorage.setItem(voteKey, 'bullish');
      }
      renderVotes();
    });

    bearishBtn?.addEventListener('click', () => {
      if (userVote === 'bearish') {
        userVote = null;
        localStorage.removeItem(voteKey);
      } else {
        userVote = 'bearish';
        localStorage.setItem(voteKey, 'bearish');
      }
      renderVotes();
    });

    renderVotes();
  }

  // 3. Watchlist button integration
  const watchlistBtn = document.getElementById('detail-watchlist-btn');
  if (watchlistBtn) {
    const airdropId = watchlistBtn.dataset.id;
    const starIcon = watchlistBtn.querySelector('.detail-star-icon');
    const textLabel = watchlistBtn.querySelector('.detail-watchlist-text');

    function getWatchlist() {
      try {
        return JSON.parse(localStorage.getItem('airdroplyx_watchlist') || '[]');
      } catch (e) {
        return [];
      }
    }

    function syncWatchlistState() {
      const list = getWatchlist();
      const isSaved = list.includes(airdropId);
      if (isSaved) {
        if (starIcon) {
          starIcon.textContent = '★';
          starIcon.className = 'detail-star-icon text-amber-500 font-black';
        }
        if (textLabel) textLabel.textContent = 'Saved in Watchlist ✓';
        watchlistBtn.classList.add('border-amber-400', 'bg-amber-50/50', 'dark:bg-amber-950/20');
      } else {
        if (starIcon) {
          starIcon.textContent = '☆';
          starIcon.className = 'detail-star-icon text-slate-400';
        }
        if (textLabel) textLabel.textContent = 'Save to Watchlist';
        watchlistBtn.classList.remove('border-amber-400', 'bg-amber-50/50', 'dark:bg-amber-950/20');
      }
    }

    watchlistBtn.addEventListener('click', (e) => {
      e.preventDefault();
      let list = getWatchlist();
      if (list.includes(airdropId)) {
        list = list.filter(id => id !== airdropId);
      } else {
        list.push(airdropId);
      }
      localStorage.setItem('airdroplyx_watchlist', JSON.stringify(list));
      syncWatchlistState();
      window.dispatchEvent(new Event('watchlistUpdated'));
    });

    syncWatchlistState();
    window.addEventListener('watchlistUpdated', syncWatchlistState);
  }
</script>
