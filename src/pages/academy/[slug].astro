---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { academyArticles } from '../../data/academy';

export function getStaticPaths() {
  return academyArticles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const otherArticles = academyArticles.filter(a => a.slug !== article.slug).slice(0, 3);
---

<Layout title={`${article.title} | Airdroplyx Academy`} description={article.excerpt}>
  <Header />

  <main class="max-w-[840px] mx-auto px-4 py-12">
    <!-- Breadcrumbs -->
    <nav class="text-sm text-slate-500 mb-8 flex items-center gap-2">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <a href="/academy" class="hover:text-blue-600">Academy</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold truncate max-w-xs">{article.title}</span>
    </nav>

    <article class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-12 border border-slate-200 dark:border-slate-700 shadow-sm mb-12">
      <header class="mb-8">
        <h1 class="text-3xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight mb-6 leading-tight">
          {article.title}
        </h1>
        <div class="flex items-center gap-3 text-xs text-slate-400 font-medium pb-6 border-b border-slate-100 dark:border-slate-700">
          <span>By Airdroplyx Research</span>
          <span>•</span>
          <span>Updated September 2026</span>
          <span>•</span>
          <span>5 min read</span>
        </div>
      </header>

      <div class="aspect-video w-full rounded-2xl overflow-hidden mb-10 bg-slate-100 shadow-md">
        <img src={article.image} alt={article.title} class="w-full h-full object-cover" />
      </div>

      <div class="prose prose-slate dark:prose-invert max-w-none text-base md:text-lg leading-relaxed text-slate-700 dark:text-slate-200 space-y-6">
        {article.content.split('\n\n').map((para) => (
          <p class="leading-relaxed">{para}</p>
        ))}
      </div>

      <!-- Callout Box -->
      <div class="mt-12 p-6 rounded-2xl bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
        <h3 class="text-base font-bold text-blue-900 dark:text-blue-200 mb-1">Ready to put this knowledge to work?</h3>
        <p class="text-sm text-blue-800 dark:text-blue-300 mb-4">Explore our curated list of confirmed airdrops and start building your on-chain resume today.</p>
        <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-2.5 px-5 rounded-xl transition-colors">
          Browse Live Airdrops →
        </a>
      </div>
    </article>

    <!-- Related Articles -->
    <div class="border-t border-slate-200 dark:border-slate-700 pt-12">
      <h3 class="text-xl font-extrabold text-slate-900 dark:text-white mb-6">Continue Learning</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {otherArticles.map(item => (
          <a href={`/academy/${item.slug}`} class="bg-white dark:bg-slate-800 rounded-2xl p-4 border border-slate-200 dark:border-slate-700 hover:shadow-md transition-all group">
            <img src={item.image} alt={item.title} class="w-full aspect-video rounded-xl object-cover mb-3" />
            <h4 class="text-sm font-bold text-slate-800 dark:text-white group-hover:text-blue-600 transition-colors line-clamp-2">
              {item.title}
            </h4>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
