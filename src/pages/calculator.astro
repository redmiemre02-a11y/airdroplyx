---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { airdrops } from '../data/airdrops';

// Preset protocols with realistic market estimates
const presets = [
  {
    id: 'hyperliquid',
    name: 'Hyperliquid ($HYPE)',
    logo: '/images/airdrops/hyperliquid.svg',
    fdv: 3000000000,
    allocationPct: 31,
    totalPoints: 50000000,
    userPoints: 10000,
    guideUrl: '/airdrop/hyperliquid'
  },
  {
    id: 'berachain',
    name: 'Berachain ($BERA)',
    logo: '/images/airdrops/berachain.svg',
    fdv: 2500000000,
    allocationPct: 10,
    totalPoints: 100000000,
    userPoints: 25000,
    guideUrl: '/airdrop/berachain'
  },
  {
    id: 'monad',
    name: 'Monad ($MONAD)',
    logo: '/images/airdrops/monad.svg',
    fdv: 5000000000,
    allocationPct: 12,
    totalPoints: 150000000,
    userPoints: 30000,
    guideUrl: '/airdrop/monad'
  },
  {
    id: 'linea',
    name: 'Linea ($LINEA)',
    logo: '/images/airdrops/linea.svg',
    fdv: 4000000000,
    allocationPct: 15,
    totalPoints: 800000000,
    userPoints: 45000,
    guideUrl: '/airdrop/linea'
  },
  {
    id: 'ether-fi',
    name: 'ether.fi ($ETHFI)',
    logo: '/images/airdrops/ether-fi.svg',
    fdv: 1500000000,
    allocationPct: 11,
    totalPoints: 500000000,
    userPoints: 150000,
    guideUrl: '/airdrop/ether-fi'
  },
  {
    id: 'grass',
    name: 'Grass ($GRASS)',
    logo: '/images/airdrops/grass.svg',
    fdv: 1200000000,
    allocationPct: 10,
    totalPoints: 200000000,
    userPoints: 50000,
    guideUrl: '/airdrop/grass'
  }
];
---

<Layout 
  title="Crypto Airdrop Value & Points Calculator (2026) | Airdroplyx"
  description="Free interactive cryptocurrency airdrop calculator. Estimate your airdrop reward in USD ($) based on user points, FDV, community pool %, and dilution."
>
  <!-- Schema.org JSON-LD for WebApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Crypto Airdrop Value & Points Calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "All",
    "url": "https://airdroplyx.com/calculator/",
    "description": "Calculate projected crypto airdrop payout in USD using customizable protocol parameters and market valuations."
  })} />

  <Header />

  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-slate-950 via-slate-900 to-slate-800 text-white py-14 md:py-18 border-b-4 border-blue-600">
    <div class="max-w-[1200px] mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-bold uppercase tracking-wider mb-6">
        <span>🧮</span> Interactive Web3 Tool
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight mb-4 leading-tight text-white">
        Crypto Airdrop <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400">Value Calculator</span>
      </h1>
      <p class="text-base md:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Estimate how much your points, testnet XP, and farming capital will be worth at TGE. Select popular protocol presets or enter custom parameters.
      </p>
    </div>
  </div>

  <!-- Main Calculator Engine Area -->
  <main class="max-w-[1100px] mx-auto px-4 py-12">
    
    <!-- Protocol Preset Pills -->
    <div class="mb-8">
      <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3">
        Select a Protocol Preset or Customize Below:
      </label>
      <div class="flex flex-wrap gap-2.5" id="preset-container">
        {presets.map((preset, index) => (
          <button 
            type="button"
            class={`preset-btn px-4 py-2.5 rounded-2xl border font-bold text-xs flex items-center gap-2 transition-all ${index === 0 ? 'bg-blue-600 text-white border-blue-600 shadow-md shadow-blue-500/25' : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border-slate-200 dark:border-slate-700 hover:border-blue-400'}`}
            data-preset={JSON.stringify(preset)}
          >
            <img src={preset.logo} alt={preset.name} class="w-4 h-4 rounded-full object-contain" />
            <span>{preset.name}</span>
          </button>
        ))}
        <button 
          type="button" 
          id="custom-preset-btn"
          class="px-4 py-2.5 rounded-2xl border border-dashed border-slate-300 dark:border-slate-600 font-bold text-xs text-slate-600 dark:text-slate-400 hover:text-blue-600 hover:border-blue-500 transition-all"
        >
          ⚙️ Custom Protocol
        </button>
      </div>
    </div>

    <!-- Calculator Card Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
      
      <!-- Left Inputs Form (7 cols) -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm space-y-6">
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
          <span>⚙️</span> Valuation Parameters
        </h2>

        <!-- User Points Input -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="input-user-points" class="text-sm font-bold text-slate-700 dark:text-slate-200">
              Your Total Points / XP:
            </label>
            <span class="text-xs font-semibold text-blue-600 dark:text-blue-400" id="display-user-points">10,000 Points</span>
          </div>
          <input 
            type="number" 
            id="input-user-points" 
            value="10000" 
            min="1" 
            step="100" 
            class="w-full bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl px-4 py-3 text-slate-900 dark:text-white font-bold text-base focus:ring-2 focus:ring-blue-500 focus:outline-none"
          />
        </div>

        <!-- Protocol Estimated FDV Slider -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="input-fdv" class="text-sm font-bold text-slate-700 dark:text-slate-200">
              Estimated Fully Diluted Valuation (FDV):
            </label>
            <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400" id="display-fdv">$3,000,000,000</span>
          </div>
          <input 
            type="range" 
            id="input-fdv" 
            min="100000000" 
            max="15000000000" 
            step="100000000" 
            value="3000000000" 
            class="w-full h-2 bg-slate-200 dark:bg-slate-600 rounded-lg appearance-none cursor-pointer accent-blue-600"
          />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1">
            <span>$100M (Micro-cap)</span>
            <span>$3B (Mid-tier)</span>
            <span>$15B (Mega-tier)</span>
          </div>
        </div>

        <!-- Community Allocation % Slider -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="input-allocation" class="text-sm font-bold text-slate-700 dark:text-slate-200">
              Community Airdrop Pool (% of Supply):
            </label>
            <span class="text-xs font-bold text-purple-600 dark:text-purple-400" id="display-allocation">31%</span>
          </div>
          <input 
            type="range" 
            id="input-allocation" 
            min="1" 
            max="40" 
            step="1" 
            value="31" 
            class="w-full h-2 bg-slate-200 dark:bg-slate-600 rounded-lg appearance-none cursor-pointer accent-purple-600"
          />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1">
            <span>1% (Minimal)</span>
            <span>10% - 15% (Standard)</span>
            <span>40% (Community First)</span>
          </div>
        </div>

        <!-- Total Community Points Input -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="input-total-points" class="text-sm font-bold text-slate-700 dark:text-slate-200">
              Total Community Points Pool (Estimated):
            </label>
            <span class="text-xs font-semibold text-slate-500" id="display-total-points">50,000,000</span>
          </div>
          <input 
            type="number" 
            id="input-total-points" 
            value="50000000" 
            min="1000" 
            step="1000000" 
            class="w-full bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-xl px-4 py-3 text-slate-900 dark:text-white font-bold text-base focus:ring-2 focus:ring-blue-500 focus:outline-none"
          />
        </div>

      </div>

      <!-- Right Reactive Result Card (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 md:p-8 text-white border border-indigo-500/20 shadow-2xl relative overflow-hidden">
        <div class="absolute -top-10 -right-10 w-48 h-48 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-6">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Projected Valuation</span>
          </div>

          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Estimated Airdrop Value</span>
          <div class="text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 tracking-tight mb-6" id="res-usd-value">
            $18,600
          </div>

          <!-- Metrics Breakdown -->
          <div class="space-y-4 bg-white/5 border border-white/10 rounded-2xl p-5 mb-6">
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-400">Total Airdrop Pool USD:</span>
              <strong class="text-white" id="res-pool-usd">$930,000,000</strong>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-400">Your Share of Points Pool:</span>
              <strong class="text-emerald-400" id="res-pool-share">0.0200%</strong>
            </div>
            <div class="flex items-center justify-between text-sm border-t border-white/10 pt-3">
              <span class="text-slate-400">Estimated Value Per Point:</span>
              <strong class="text-cyan-300" id="res-per-point">$1.86 / pt</strong>
            </div>
          </div>

          <!-- Market Scenarios Preview -->
          <div class="grid grid-cols-3 gap-2 text-center text-xs mb-6">
            <div class="bg-white/5 rounded-xl p-2.5 border border-white/5">
              <span class="text-[10px] text-slate-400 block uppercase">Bear (-40%)</span>
              <strong class="text-rose-400 font-bold block mt-0.5" id="res-bear">$11,160</strong>
            </div>
            <div class="bg-blue-500/20 rounded-xl p-2.5 border border-blue-400/30">
              <span class="text-[10px] text-blue-300 block uppercase">Base</span>
              <strong class="text-white font-bold block mt-0.5" id="res-base">$18,600</strong>
            </div>
            <div class="bg-emerald-500/20 rounded-xl p-2.5 border border-emerald-400/30">
              <span class="text-[10px] text-emerald-300 block uppercase">Bull (+80%)</span>
              <strong class="text-emerald-300 font-bold block mt-0.5" id="res-bull">$33,480</strong>
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-center gap-3">
            <button 
              type="button" 
              id="btn-copy-estimate" 
              class="flex-1 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold py-3 px-4 rounded-xl text-xs transition-colors text-center"
            >
              📋 Copy Breakdown
            </button>
            <a 
              href="/airdrop/hyperliquid" 
              id="dynamic-guide-link" 
              class="flex-1 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-4 rounded-xl text-xs transition-colors text-center shadow-lg shadow-blue-500/30"
            >
              Open Farming Guide →
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- Calculator Risk Disclaimer -->
    <div class="mb-12 p-6 rounded-3xl bg-amber-50/70 dark:bg-amber-950/20 border border-amber-200/80 dark:border-amber-900/40 shadow-sm">
      <div class="flex items-start gap-4">
        <span class="text-2xl shrink-0">⚠️</span>
        <div class="text-xs sm:text-sm text-amber-900/90 dark:text-amber-300 space-y-1">
          <p><strong class="font-bold text-amber-900 dark:text-amber-200">Valuation Modeling Disclaimer:</strong> All projections generated by this calculator are hypothetical mathematical simulations based on user-supplied inputs and speculative market FDVs.</p>
          <p>These figures do not represent guaranteed returns, financial advice, or promises of allocation. Protocol foundations determine snapshot criteria, Sybil blacklists, and token allocations at their sole discretion. Always DYOR. <a href="/disclaimer" class="underline font-bold hover:text-amber-600 dark:hover:text-amber-200">Read our full Risk Disclaimer &rarr;</a></p>
        </div>
      </div>
    </div>

    <!-- Educational FAQs Section (SEO) -->
    <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-sm">
      <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
        <span>❓</span> How Airdrop Value is Calculated
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/80 dark:border-slate-600/80">
          <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">What is Fully Diluted Valuation (FDV)?</h3>
          <p>FDV represents the hypothetical market cap of a project if 100% of its total token supply were in circulation at current listing prices. Tier-1 Layer 1s and perps DEXs commonly list between $2B and $5B FDV.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/80 dark:border-slate-600/80">
          <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">How Does Point Dilution Work?</h3>
          <p>As more participants join a farming program, the total community points denominator expands. Your individual allocation equals (Your Points / Total Circulating Points) multiplied by the total USD airdrop pool.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/80 dark:border-slate-600/80">
          <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">Are Airdrop Points Guaranteed Tokens?</h3>
          <p>Most points programs convert directly into governance tokens at TGE. However, protocols enforce Sybil filtering criteria to disqualify bot rings and inactive wallets before final calculation.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200/80 dark:border-slate-600/80">
          <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">What is a Standard Community Allocation?</h3>
          <p>Tier-1 protocols typically distribute between 8% and 15% of total genesis token supply to early community participants. Some community-centric protocols like Hyperliquid allocate over 30%.</p>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script is:inline>
  // Interactive Live Calculation Script
  const userPointsInput = document.getElementById('input-user-points');
  const fdvInput = document.getElementById('input-fdv');
  const allocationInput = document.getElementById('input-allocation');
  const totalPointsInput = document.getElementById('input-total-points');

  const displayUserPoints = document.getElementById('display-user-points');
  const displayFdv = document.getElementById('display-fdv');
  const displayAllocation = document.getElementById('display-allocation');
  const displayTotalPoints = document.getElementById('display-total-points');

  const resUsdValue = document.getElementById('res-usd-value');
  const resPoolUsd = document.getElementById('res-pool-usd');
  const resPoolShare = document.getElementById('res-pool-share');
  const resPerPoint = document.getElementById('res-per-point');
  const resBear = document.getElementById('res-bear');
  const resBase = document.getElementById('res-base');
  const resBull = document.getElementById('res-bull');
  const dynamicGuideLink = document.getElementById('dynamic-guide-link');
  const copyBtn = document.getElementById('btn-copy-estimate');

  function formatCurrency(num) {
    return '$' + Math.round(num).toLocaleString('en-US');
  }

  function recalculate() {
    const userPoints = parseFloat(userPointsInput.value) || 0;
    const fdv = parseFloat(fdvInput.value) || 0;
    const allocationPct = parseFloat(allocationInput.value) || 0;
    const totalPoints = parseFloat(totalPointsInput.value) || 1;

    displayUserPoints.textContent = userPoints.toLocaleString('en-US') + ' Points';
    displayFdv.textContent = formatCurrency(fdv);
    displayAllocation.textContent = allocationPct + '%';
    displayTotalPoints.textContent = totalPoints.toLocaleString('en-US');

    // Formula: Total Pool USD = FDV * (allocationPct / 100)
    const poolUsd = fdv * (allocationPct / 100);
    // User Share = User Points / Total Points
    const share = totalPoints > 0 ? (userPoints / totalPoints) : 0;
    // Estimated USD Value = Pool USD * Share
    const estimatedValue = poolUsd * share;
    const perPointValue = userPoints > 0 ? (estimatedValue / userPoints) : 0;

    resUsdValue.textContent = formatCurrency(estimatedValue);
    resPoolUsd.textContent = formatCurrency(poolUsd);
    resPoolShare.textContent = (share * 100).toFixed(4) + '%';
    resPerPoint.textContent = '$' + perPointValue.toFixed(2) + ' / pt';

    resBear.textContent = formatCurrency(estimatedValue * 0.6);
    resBase.textContent = formatCurrency(estimatedValue);
    resBull.textContent = formatCurrency(estimatedValue * 1.8);
  }

  [userPointsInput, fdvInput, allocationInput, totalPointsInput].forEach(el => {
    el.addEventListener('input', recalculate);
  });

  // Preset Buttons Handling
  const presetBtns = document.querySelectorAll('.preset-btn');
  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      presetBtns.forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-md');
        b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200');
      });
      btn.classList.add('bg-blue-600', 'text-white', 'border-blue-600', 'shadow-md');
      btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200');

      const data = JSON.parse(btn.dataset.preset);
      userPointsInput.value = data.userPoints;
      fdvInput.value = data.fdv;
      allocationInput.value = data.allocationPct;
      totalPointsInput.value = data.totalPoints;
      dynamicGuideLink.href = data.guideUrl;
      dynamicGuideLink.textContent = `Open ${data.name.split(' ')[0]} Guide →`;

      recalculate();
    });
  });

  // Copy Breakdown
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const text = `Airdroplyx Estimate: Projected Airdrop Value: ${resUsdValue.textContent} (Base: ${resBase.textContent}, Bull: ${resBull.textContent}) calculated on https://airdroplyx.com/calculator/`;
      navigator.clipboard.writeText(text).then(() => {
        const orig = copyBtn.textContent;
        copyBtn.textContent = '✓ Copied!';
        setTimeout(() => { copyBtn.textContent = orig; }, 2000);
      });
    });
  }

  // Initial calculation run
  recalculate();
</script>
