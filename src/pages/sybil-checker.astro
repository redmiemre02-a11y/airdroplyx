<script is:inline>
  // Diagnostic Engine
  function calculateSybilRisk() {
    const q1 = parseInt(document.querySelector('input[name="funding_origin"]:checked')?.value || '0', 10);
    const q2 = parseInt(document.querySelector('input[name="cross_transfers"]:checked')?.value || '0', 10);
    const q3 = parseInt(document.querySelector('input[name="timing_pattern"]:checked')?.value || '0', 10);
    const q4 = parseInt(document.querySelector('input[name="amount_entropy"]:checked')?.value || '0', 10);
    const q5 = parseInt(document.querySelector('input[name="contract_count"]:checked')?.value || '0', 10);
    const q6 = parseInt(document.querySelector('input[name="balance_retention"]:checked')?.value || '0', 10);
    const q7 = parseInt(document.querySelector('input[name="l1_footprint"]:checked')?.value || '0', 10);
    const q8 = parseInt(document.querySelector('input[name="identity_attestation"]:checked')?.value || '0', 10);

    const fundingSum = q1 + q2; // max: 80
    const timingSum = q3 + q4;   // max: 55
    const diversitySum = q5 + q6; // max: 55
    const identitySum = q7 + q8;  // max: 45

    // Total raw sum
    let totalRaw = fundingSum + timingSum + diversitySum + identitySum;
    
    // Scale to percentage: 0 to 100%
    let percentage = Math.min(Math.max(Math.round((totalRaw / 180) * 100), 2), 99);

    // Update gauge & text
    const scorePercentageEl = document.getElementById('score-percentage');
    const scoreCircleEl = document.getElementById('score-circle');
    const riskBadgeEl = document.getElementById('risk-badge');
    const scoreSummaryEl = document.getElementById('score-summary');

    if (scorePercentageEl) scorePercentageEl.textContent = `${percentage}%`;

    // SVG Circumference: 2 * PI * 50 = 314.159
    const circumference = 314.159;
    const offset = circumference - (percentage / 100) * circumference;
    if (scoreCircleEl) {
      scoreCircleEl.style.strokeDashoffset = offset;
    }

    // Determine Risk Level Styling & Color
    let riskTier = 'Low Risk';
    let badgeClass = 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800';
    let circleClass = 'text-emerald-500';
    let summaryText = 'Your wallet profile exhibits natural human entropy and safe funding patterns. Highly likely to qualify for snapshots.';

    if (percentage >= 70) {
      riskTier = 'Critical Risk';
      badgeClass = 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300 border-rose-300 dark:border-rose-800 animate-pulse';
      circleClass = 'text-rose-600';
      summaryText = 'DANGER: Extremely high sybil probability! Direct funding links or robotic timing patterns guarantee cluster blacklisting by automated filters.';
    } else if (percentage >= 45) {
      riskTier = 'High Risk';
      badgeClass = 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 border-amber-300 dark:border-amber-800';
      circleClass = 'text-amber-500';
      summaryText = 'CAUTION: Multiple behavioral red flags detected. You are vulnerable to strict clustering models unless remediation actions are taken.';
    } else if (percentage >= 20) {
      riskTier = 'Moderate Risk';
      badgeClass = 'bg-yellow-100 text-yellow-800 dark:bg-yellow-950 dark:text-yellow-300 border-yellow-300 dark:border-yellow-800';
      circleClass = 'text-yellow-500';
      summaryText = 'ACCEPTABLE: Wallet is largely organic, but lack of mainnet tenure or low balance dust may decrease your airdrop allocation tier.';
    }

    if (riskBadgeEl) {
      riskBadgeEl.textContent = riskTier;
      riskBadgeEl.className = `px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border ${badgeClass}`;
    }
    if (scoreCircleEl) {
      scoreCircleEl.setAttribute('class', `${circleClass} transition-all duration-700 ease-out`);
    }
    if (scoreSummaryEl) {
      scoreSummaryEl.textContent = summaryText;
    }

    // Breakdown Bars
    const barFunding = document.getElementById('bar-funding');
    const barFundingLabel = document.getElementById('bar-funding-label');
    const fundingPct = Math.min(Math.round((fundingSum / 80) * 100), 100);
    if (barFunding) barFunding.style.width = `${Math.max(fundingPct, 4)}%`;
    if (barFundingLabel) {
      barFundingLabel.textContent = fundingPct > 40 ? `Risk (${fundingPct}%)` : `Safe (${fundingPct}%)`;
      barFundingLabel.className = fundingPct > 40 ? 'text-rose-500 font-bold' : 'text-emerald-500 font-bold';
    }

    const barTiming = document.getElementById('bar-timing');
    const barTimingLabel = document.getElementById('bar-timing-label');
    const timingPct = Math.min(Math.round((timingSum / 55) * 100), 100);
    if (barTiming) barTiming.style.width = `${Math.max(timingPct, 4)}%`;
    if (barTimingLabel) {
      barTimingLabel.textContent = timingPct > 40 ? `Clustered (${timingPct}%)` : `Natural (${timingPct}%)`;
      barTimingLabel.className = timingPct > 40 ? 'text-rose-500 font-bold' : 'text-emerald-500 font-bold';
    }

    const barDiversity = document.getElementById('bar-diversity');
    const barDiversityLabel = document.getElementById('bar-diversity-label');
    const diversityPct = Math.min(Math.round((diversitySum / 55) * 100), 100);
    if (barDiversity) barDiversity.style.width = `${Math.max(diversityPct, 4)}%`;
    if (barDiversityLabel) {
      barDiversityLabel.textContent = diversityPct > 40 ? `Shallow (${diversityPct}%)` : `Sticky (${diversityPct}%)`;
      barDiversityLabel.className = diversityPct > 40 ? 'text-rose-500 font-bold' : 'text-emerald-500 font-bold';
    }

    const barIdentity = document.getElementById('bar-identity');
    const barIdentityLabel = document.getElementById('bar-identity-label');
    const identityPct = Math.min(Math.max(Math.round((identitySum / 45) * 100), 0), 100);
    if (barIdentity) barIdentity.style.width = `${Math.max(identityPct, 4)}%`;
    if (barIdentityLabel) {
      barIdentityLabel.textContent = identitySum <= 0 ? 'Verified' : `Unverified (${identityPct}%)`;
      barIdentityLabel.className = identitySum <= 0 ? 'text-emerald-500 font-bold' : 'text-amber-500 font-bold';
    }

    // Dynamic Red Flags
    const redFlagsList = document.getElementById('red-flags-list');
    if (redFlagsList) {
      const flags = [];
      if (q2 === 45) flags.push('CRITICAL: Cross-wallet transactions detected between farming addresses (Instant graph linkage).');
      if (q1 === 35) flags.push('HIGH: Funded directly from another private wallet (Tree clustering vulnerability).');
      if (q3 === 30) flags.push('HIGH: Rapid sequential batch execution across wallets within minutes.');
      if (q6 === 30) flags.push('MODERATE: Wallet balance drained to near zero (Flagged as transient capital).');
      if (q5 === 25) flags.push('MODERATE: Interacted with &lt; 2 smart contracts (Lacks genuine user depth).');
      if (q8 === 20) flags.push('NOTICE: Zero on-chain identity credentials (ENS, Gitcoin, or PoH missing).');

      if (flags.length === 0) {
        redFlagsList.innerHTML = `
          <div class="p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40 text-xs flex items-center gap-2">
            <span>✨</span>
            <span>No critical clustering red flags detected! Excellent wallet hygiene.</span>
          </div>
        `;
      } else {
        redFlagsList.innerHTML = flags.map(flag => `
          <div class="p-2.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800/50 text-xs flex items-start gap-2">
            <span class="text-rose-500 shrink-0 mt-0.5">⚠️</span>
            <span>${flag}</span>
          </div>
        `).join('');
      }
    }
  }

  // Preset Loaders
  function applyPreset(preset) {
    if (preset === 'organic') {
      document.querySelector('input[name="funding_origin"][value="0"]').checked = true;
      document.querySelector('input[name="cross_transfers"][value="0"]').checked = true;
      document.querySelector('input[name="timing_pattern"][value="0"]').checked = true;
      document.querySelector('input[name="amount_entropy"][value="0"]').checked = true;
      document.querySelector('input[name="contract_count"][value="0"]').checked = true;
      document.querySelector('input[name="balance_retention"][value="0"]').checked = true;
      document.querySelector('input[name="l1_footprint"][value="0"]').checked = true;
      document.querySelector('input[name="identity_attestation"][value="-10"]').checked = true;
    } else if (preset === 'casual') {
      document.querySelector('input[name="funding_origin"][value="15"]').checked = true;
      document.querySelector('input[name="cross_transfers"][value="0"]').checked = true;
      document.querySelector('input[name="timing_pattern"][value="15"]').checked = true;
      document.querySelector('input[name="amount_entropy"][value="10"]').checked = true;
      document.querySelector('input[name="contract_count"][value="12"]').checked = true;
      document.querySelector('input[name="balance_retention"][value="10"]').checked = true;
      document.querySelector('input[name="l1_footprint"][value="10"]').checked = true;
      document.querySelector('input[name="identity_attestation"][value="5"]').checked = true;
    } else if (preset === 'sybil') {
      document.querySelector('input[name="funding_origin"][value="35"]').checked = true;
      document.querySelector('input[name="cross_transfers"][value="45"]').checked = true;
      document.querySelector('input[name="timing_pattern"][value="30"]').checked = true;
      document.querySelector('input[name="amount_entropy"][value="25"]').checked = true;
      document.querySelector('input[name="contract_count"][value="25"]').checked = true;
      document.querySelector('input[name="balance_retention"][value="30"]').checked = true;
      document.querySelector('input[name="l1_footprint"][value="25"]').checked = true;
      document.querySelector('input[name="identity_attestation"][value="20"]').checked = true;
    } else if (preset === 'reset') {
      document.querySelector('input[name="funding_origin"][value="0"]').checked = true;
      document.querySelector('input[name="cross_transfers"][value="0"]').checked = true;
      document.querySelector('input[name="timing_pattern"][value="0"]').checked = true;
      document.querySelector('input[name="amount_entropy"][value="0"]').checked = true;
      document.querySelector('input[name="contract_count"][value="0"]').checked = true;
      document.querySelector('input[name="balance_retention"][value="0"]').checked = true;
      document.querySelector('input[name="l1_footprint"][value="0"]').checked = true;
      document.querySelector('input[name="identity_attestation"][value="-10"]').checked = true;
    }
    calculateSybilRisk();
  }

  // Event Listeners
  document.addEventListener('DOMContentLoaded', () => {
    const radioInputs = document.querySelectorAll('input[type="radio"]');
    radioInputs.forEach(input => {
      input.addEventListener('change', calculateSybilRisk);
    });

    document.getElementById('preset-organic')?.addEventListener('click', () => applyPreset('organic'));
    document.getElementById('preset-casual')?.addEventListener('click', () => applyPreset('casual'));
    document.getElementById('preset-sybil')?.addEventListener('click', () => applyPreset('sybil'));
    document.getElementById('preset-reset')?.addEventListener('click', () => applyPreset('reset'));

    // Copy Diagnostic Report
    const copyBtn = document.getElementById('copy-report-btn');
    const copyText = document.getElementById('copy-report-text');
    copyBtn?.addEventListener('click', () => {
      const score = document.getElementById('score-percentage')?.textContent || '0%';
      const badge = document.getElementById('risk-badge')?.textContent || 'Safe';
      const summary = document.getElementById('score-summary')?.textContent || '';
      
      const report = `🛡️ Airdroplyx Sybil Diagnostic Report
━━━━━━━━━━━━━━━━━━━━━━━━━━━
• Sybil Probability: ${score}
• Risk Status: ${badge}
• Summary: ${summary}
• Diagnostic Date: ${new Date().toLocaleDateString()}
━━━━━━━━━━━━━━━━━━━━━━━━━━━
