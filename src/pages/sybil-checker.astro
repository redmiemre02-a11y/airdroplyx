---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout 
  title="Web3 Sybil Risk & Wallet Health Checker | Airdroplyx" 
  description="Evaluate your crypto wallet against real-world airdrop anti-sybil clustering algorithms. Check CEX funding links, temporal clustering, dApp diversity, and get actionable remediation advice."
>
  <Header />

  <main class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-12 px-4 transition-colors duration-200">
    <div class="max-w-[1200px] mx-auto">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-medium">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <span>/</span>
        <span class="text-blue-600 dark:text-blue-400 font-semibold">Sybil Risk Checker</span>
      </nav>

      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 bg-rose-100 dark:bg-rose-900/40 text-rose-700 dark:text-rose-300 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase mb-4 border border-rose-200 dark:border-rose-800/60 shadow-sm">
          <span>🛡️</span>
          <span>Anti-Sybil Defense Engine</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white mb-4">
          Sybil Risk & Wallet Diagnostic
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Major protocols (LayerZero, Celestia, Arbitrum, Starknet) eliminate over 40% of farming wallets using behavioral clustering. Audit your wallet against historical sybil criteria before the snapshot is taken.
        </p>

        <!-- Privacy Assurance Banner -->
        <div class="mt-6 inline-flex items-center gap-2.5 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 px-4 py-2 rounded-xl text-xs font-semibold border border-emerald-200 dark:border-emerald-800/60 shadow-sm">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"></path>
          </svg>
          <span>100% Client-Side & Private: No wallet connection or private keys required. Zero data leaves your device.</span>
        </div>
      </div>

      <!-- Quick Preset Simulation Profiles -->
      <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm mb-10">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">⚡ Quick Simulation Profiles</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Test predefined behavioral archetypes to see how different farming styles score.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button id="preset-organic" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-100 hover:bg-emerald-200 text-emerald-800 dark:bg-emerald-950/60 dark:hover:bg-emerald-900 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 transition-all flex items-center gap-1.5">
              <span>🟢</span>
              <span>Organic Power User</span>
            </button>
            <button id="preset-casual" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-100 hover:bg-amber-200 text-amber-800 dark:bg-amber-950/60 dark:hover:bg-amber-900 dark:text-amber-300 border border-amber-300 dark:border-amber-800 transition-all flex items-center gap-1.5">
              <span>🟡</span>
              <span>Casual Farmer</span>
            </button>
            <button id="preset-sybil" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-100 hover:bg-rose-200 text-rose-800 dark:bg-rose-950/60 dark:hover:bg-rose-900 dark:text-rose-300 border border-rose-300 dark:border-rose-800 transition-all flex items-center gap-1.5">
              <span>🔴</span>
              <span>High-Risk Cluster</span>
            </button>
            <button id="preset-reset" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 transition-all">
              Reset Form
            </button>
          </div>
        </div>
      </div>

      <!-- Main Audit Layout: 2 Columns on Desktop -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left: Diagnostic Questionnaire (7 Cols) -->
        <div class="lg:col-span-7 space-y-8">
          
          <!-- Category 1: Funding & CEX Origins -->
          <div class="bg-white dark:bg-slate-900 p-6 sm:p-7 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
              <span class="w-8 h-8 rounded-xl bg-rose-100 dark:bg-rose-900/50 text-rose-600 dark:text-rose-400 font-black text-sm flex items-center justify-center">1</span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">Funding Origins & CEX Interaction</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Cross-wallet graph analysis is the #1 way protocols flag sybil clusters.</p>
              </div>
            </div>

            <div class="space-y-6">
              <!-- Q1 -->
              <div>
                <label class="block text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">
                  1. How was this wallet initially funded with gas / capital?
                </label>
                <div class="grid grid-cols-1 gap-2.5">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="funding_origin" value="0" class="mt-0.5 text-blue-600 focus:ring-blue-500" checked />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Independent CEX / Segregated Sub-account</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Withdrawn directly from Binance/OKX using dedicated unique sub-account addresses or personal KYC deposit address.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="funding_origin" value="15" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Single Main CEX Account without Sub-accounts</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Withdrawn from one CEX account to multiple wallets, but spread across several days with varying amounts.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="funding_origin" value="35" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Direct Transfer from another Private Wallet (Parent Wallet)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Funded directly by sending ETH/USDC from another personal private MetaMask wallet (Creates a direct on-chain tree link).</span>
                    </div>
                  </label>
                </div>
              </div>

              <!-- Q2 -->
              <div>
                <label class="block text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">
                  2. Have you ever transferred tokens between your farming wallets?
                </label>
                <div class="grid grid-cols-1 gap-2.5">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="cross_transfers" value="0" class="mt-0.5 text-blue-600 focus:ring-blue-500" checked />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Strict Zero Cross-Transfer (Completely Isolated)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">No funds, NFTs, or gas tokens have ever moved directly between this wallet and any other wallet you own.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="cross_transfers" value="20" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Accidental Single Transfer in the past</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">A small gas refund or accidental transaction occurred once between two wallets months ago.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="cross_transfers" value="45" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Frequent Inter-Wallet Rebalancing / Fund Sweeping</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Regularly consolidating airdrop rewards or pooling gas between several personal addresses (Guaranteed clustering flag).</span>
                    </div>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- Category 2: Temporal Patterns & Automation -->
          <div class="bg-white dark:bg-slate-900 p-6 sm:p-7 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
              <span class="w-8 h-8 rounded-xl bg-amber-100 dark:bg-amber-900/50 text-amber-600 dark:text-amber-400 font-black text-sm flex items-center justify-center">2</span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">Execution Timing & Behavioral Entropy</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Bots execute in deterministic minutes; human users exhibit natural chaos and spacing.</p>
              </div>
            </div>

            <div class="space-y-6">
              <!-- Q3 -->
              <div>
                <label class="block text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">
                  3. When performing transactions across multiple wallets, how do you time them?
                </label>
                <div class="grid grid-cols-1 gap-2.5">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="timing_pattern" value="0" class="mt-0.5 text-blue-600 focus:ring-blue-500" checked />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Naturally Distributed across Days & Weeks</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Each wallet is used on different days, at random hours, with no batch sequencing.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="timing_pattern" value="15" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Same Day, but manually spaced out by hours</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Farmed in the same 24-hour cycle, but switching wallets manually over several hours.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="timing_pattern" value="30" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Rapid Succession / Same Hour Execution (Batching)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Executing the exact same contract steps on wallet A, then immediately wallet B, C, D within minutes.</span>
                    </div>
                  </label>
                </div>
              </div>

              <!-- Q4 -->
              <div>
                <label class="block text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">
                  4. What do your transaction amounts look like?
                </label>
                <div class="grid grid-cols-1 gap-2.5">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="amount_entropy" value="0" class="mt-0.5 text-blue-600 focus:ring-blue-500" checked />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Fractional & Randomized (High Entropy)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">E.g., $137.42, 0.0483 ETH, 89.15 USDC (mimics authentic everyday economic activity).</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="amount_entropy" value="10" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Semi-Round Numbers</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">E.g., $50, $100, $250 round amounts, but varying between different protocols.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="amount_entropy" value="25" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Identical Exact Minimum Thresholds</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Always bridging exactly $10.01 or swapping exactly $5.00 across all wallets to minimize gas.</span>
                    </div>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- Category 3: DApp Diversity & Balance Retention -->
          <div class="bg-white dark:bg-slate-900 p-6 sm:p-7 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
              <span class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 font-black text-sm flex items-center justify-center">3</span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">Contract Diversity & Capital Stickiness</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Protocols reward organic liquidity providers and penalize transient "hit-and-run" wallets.</p>
              </div>
            </div>

            <div class="space-y-6">
              <!-- Q5 -->
              <div>
                <label class="block text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">
                  5. How many distinct smart contracts / dApps has this wallet interacted with on the target network?
                </label>
                <div class="grid grid-cols-1 gap-2.5">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="contract_count" value="0" class="mt-0.5 text-blue-600 focus:ring-blue-500" checked />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">10+ Diverse Contracts (DEX, Lending, NFT, Names, Bridges)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">High interaction breadth across multiple ecosystem categories over several months.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="contract_count" value="12" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">3 to 9 Contracts</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Interacted with the primary official bridge and 2-3 prominent decentralized exchanges.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="contract_count" value="25" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Only 1 or 2 Contracts (Bare Minimum Route)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Only bridged in and made a single swap, then left the wallet idle.</span>
                    </div>
                  </label>
                </div>
              </div>

              <!-- Q6 -->
              <div>
                <label class="block text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">
                  6. What is the current native token balance kept in the wallet?
                </label>
                <div class="grid grid-cols-1 gap-2.5">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="balance_retention" value="0" class="mt-0.5 text-blue-600 focus:ring-blue-500" checked />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Active Sticky Capital (> $50 - $100+ equivalent in native/stables)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Wallet holds substantial unbridged liquidity or LP tokens continuously.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="balance_retention" value="10" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Modest Gas Dust ($5 to $20)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Enough for a few future transactions, but most farming capital was withdrawn.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="balance_retention" value="30" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Swept to Near Zero (&lt; $1.00 / 0.0005 ETH)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Drained all capital immediately after completing farming steps (Major sybil filter in Arbitrum/Optimism/ZkSync).</span>
                    </div>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- Category 4: Web3 Identity & Historical Footprint -->
          <div class="bg-white dark:bg-slate-900 p-6 sm:p-7 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
              <span class="w-8 h-8 rounded-xl bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400 font-black text-sm flex items-center justify-center">4</span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">Web3 Identity & Proof-of-Humanity</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Verifiable credentials and L1 activity significantly reduce clustering suspicion.</p>
              </div>
            </div>

            <div class="space-y-6">
              <!-- Q7 -->
              <div>
                <label class="block text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 mb-2">
                  7. Does this wallet have an established footprint on Ethereum L1 or major base layers?
                </label>
                <div class="grid grid-cols-1 gap-2.5">
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="l1_footprint" value="0" class="mt-0.5 text-blue-600 focus:ring-blue-500" checked />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Aged Wallet with Ethereum L1 History (&gt; 6-12 months)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Has executed multiple transactions on Ethereum mainnet over a multi-month or multi-year span.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="l1_footprint" value="10" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">L2 Only User (Polygon / Arbitrum / Base history only)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Active on low-cost rollups for several months, but never paid Ethereum L1 mainnet gas.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700/80 hover:bg-slate-50 dark:hover:bg-slate-800/60 cursor-pointer transition-colors text-xs sm:text-sm">
                    <input type="radio" name="l1_footprint" value="25" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                    <div>
                      <strong class="text-slate-900 dark:text-white block font-medium">Brand New Wallet (&lt; 30 days old)</strong>
                      <span class="text-slate-500 dark:text-slate-400 text-xs">Created specifically for this airdrop with zero pre-existing blockchain tenure.</span>
                    </div>
                  </label>
                </div>
              </div>

