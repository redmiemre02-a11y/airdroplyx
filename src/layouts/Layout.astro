---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import CommandPalette from '../components/CommandPalette.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	lang?: string;
}

const { 
	title, 
	description = "The ultimate guide to verified crypto airdrops, testnet guides, and Web3 farming strategies.",
	image = "https://airdroplyx.com/logo.jpg",
	lang = "en"
} = Astro.props;

const rawAbsImage = image.startsWith('http') ? image : `https://airdroplyx.com${image.startsWith('/') ? '' : '/'}${image}`;
const ogImage = rawAbsImage.endsWith('.svg') ? "https://airdroplyx.com/logo.jpg" : rawAbsImage;

const normalizedPath = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(normalizedPath, Astro.site || "https://airdroplyx.com");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

		<!-- RSS Autodiscovery Feed -->
		<link rel="alternate" type="application/rss+xml" title="Airdroplyx - Master RSS Feed" href="https://airdroplyx.com/rss.xml" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Airdroplyx" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="675" />
		<meta property="og:image:type" content="image/jpeg" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Google Search Console Verification -->
		<meta name="google-site-verification" content="miXhgrypb-Z3tfLedIHMe1bBxiEVSsw0NPXUYXmtp0U" />
		
		<!-- Google Analytics (GA4) -->
		<GoogleAnalytics />

		<!-- Google AdSense & OneSignal (Deferred for Core Web Vitals) -->
		<script is:inline>
			(function() {
				let thirdPartyLoaded = false;
				function loadThirdParty() {
					if (thirdPartyLoaded) return;
					thirdPartyLoaded = true;

					// Google AdSense
					const ads = document.createElement('script');
					ads.async = true;
					ads.crossOrigin = 'anonymous';
					ads.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2409736261623563';
					document.head.appendChild(ads);

					// OneSignal Web Push
					window.OneSignalDeferred = window.OneSignalDeferred || [];
					window.OneSignalDeferred.push(async function(OneSignal) {
						await OneSignal.init({
							appId: "fe3434ff-e2df-4d5f-9faa-6859e830cb97",
						});
					});
					const os = document.createElement('script');
					os.defer = true;
					os.src = 'https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';
					document.head.appendChild(os);
				}
				['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function(evt) {
					window.addEventListener(evt, loadThirdParty, { once: true, passive: true });
				});
				setTimeout(loadThirdParty, 3500);
			})();
		</script>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
		
		<!-- JSON-LD WebSite Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "Airdroplyx",
			"url": "https://airdroplyx.com/",
			"description": "Verified cryptocurrency airdrops, testnet farming guides, and Web3 reward tracking.",
			"potentialAction": {
				"@type": "SearchAction",
				"target": "https://airdroplyx.com/?q={search_term_string}",
				"query-input": "required name=search_term_string"
			}
		})} />

		<!-- Multi-Language Engine Styles -->
		<style is:global>
			.goog-te-banner-frame.skiptranslate, 
			.goog-te-banner-frame,
			iframe.goog-te-banner-frame { 
				display: none !important; 
				visibility: hidden !important;
				height: 0 !important;
			}
			body { 
				top: 0px !important; 
				position: static !important;
			}
			.goog-te-gadget,
			.goog-te-gadget-simple,
			#goog-gt-tt, 
			.goog-te-balloon-frame,
			.VIpgJd-ZVi9od-ORHb-OEVmcd,
			.VIpgJd-ZVi9od-aZ2wEe-wOHMyf,
			.VIpgJd-ZVi9od-aZ2wEe-OiiCO { 
				display: none !important; 
				visibility: hidden !important;
			}
			.goog-text-highlight { 
				background: none !important; 
				box-shadow: none !important; 
			}
		</style>
		<script is:inline>
			// Bulletproof global language switcher function
			window.changeAirdroplyxLanguage = function(langCode, flag, code) {
				if (!langCode) return;
				localStorage.setItem('airdroplyx_lang', langCode);
				if (flag) localStorage.setItem('airdroplyx_flag', flag);
				if (code) localStorage.setItem('airdroplyx_code', code);
				document.documentElement.lang = langCode;

				const isEn = langCode === 'en';
				const cookieVal = isEn ? '' : '/en/' + langCode;
				const expiresDate = isEn 
					? 'expires=Thu, 01 Jan 1970 00:00:00 UTC;' 
					: 'expires=' + new Date(Date.now() + 365*24*60*60*1000).toUTCString() + ';';
				
				const host = window.location.hostname;
				const hostParts = host ? host.split('.') : [];
				const domains = [''];
				if (host) {
					domains.push(host);
					domains.push('.' + host);
				}
				if (hostParts.length >= 2) {
					const rootDomain = hostParts.slice(-2).join('.');
					if (rootDomain !== host) {
						domains.push(rootDomain);
						domains.push('.' + rootDomain);
					}
				}

				domains.forEach(function(d) {
					const domAttr = d ? ' domain=' + d + ';' : '';
					if (isEn) {
						document.cookie = 'googtrans=; path=/; ' + expiresDate + domAttr;
						document.cookie = 'googtrans=none; path=/; ' + expiresDate + domAttr;
						document.cookie = 'googtransopt=; path=/; ' + expiresDate + domAttr;
					} else {
						document.cookie = 'googtrans=' + cookieVal + '; path=/; ' + expiresDate + domAttr;
						document.cookie = 'googtrans=/auto/' + langCode + '; path=/; ' + expiresDate + domAttr;
					}
				});

				// Check if Google Translate combo is currently available in DOM
				const combo = document.querySelector('.goog-te-combo');
				if (combo) {
					combo.value = isEn ? 'en' : langCode;
					combo.dispatchEvent(new Event('change'));
					setTimeout(function() {
						window.location.reload();
					}, 150);
				} else {
					window.location.reload();
				}
			};

			window.googleTranslateElementInit = function() {
				new google.translate.TranslateElement({
					pageLanguage: 'en',
					includedLanguages: 'en,tr,ru,es,vi,zh-CN,de,ja,ko,fr,pt,id,uk,ar',
					autoDisplay: false
				}, 'google_translate_element');

				// Auto-sync translation if non-English language is set in localStorage
				const saved = localStorage.getItem('airdroplyx_lang');
				if (saved && saved !== 'en') {
					let attempts = 0;
					const interval = setInterval(function() {
						attempts++;
						const combo = document.querySelector('.goog-te-combo');
						if (combo) {
							if (combo.value !== saved) {
								combo.value = saved;
								combo.dispatchEvent(new Event('change'));
							}
							clearInterval(interval);
						}
						if (attempts > 25) clearInterval(interval);
					}, 200);
				}
			};

			// Sync html lang attribute early & load Google Translate ONLY when needed
			const savedLang = localStorage.getItem('airdroplyx_lang');
			if (savedLang) {
				document.documentElement.lang = savedLang;
				if (savedLang !== 'en') {
					const gt = document.createElement('script');
					gt.async = true;
					gt.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
					document.head.appendChild(gt);
				}
			}
		</script>

		<script is:inline>
			if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class="bg-gray-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col font-sans antialiased transition-colors duration-200">
		<!-- Google Translate Neural Integration Container inside body -->
		<div id="google_translate_element" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none;" aria-hidden="true"></div>
		<slot />
		<Footer />
		<CookieBanner />
		<CommandPalette />
	</body>
</html>
