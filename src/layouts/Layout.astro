---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Crypto Airdrops & Free Drops" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/jpeg" href="/favicon.jpg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
		
		<!-- OneSignal Web Push -->
		<script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
		<script>
			window.OneSignalDeferred = window.OneSignalDeferred || [];
			OneSignalDeferred.push(async function(OneSignal) {
				await OneSignal.init({
					appId: "YOUR-ONESIGNAL-APP-ID",
				});
			});
		</script>
		<!-- Language Auto-Detector -->
		<script>
			(function() {
				// Only run on root path to avoid redirect loops
				if (window.location.pathname === '/') {
					const storedLang = localStorage.getItem('preferredLang');
					if (storedLang) return; // User already chose a language
					
					const userLang = navigator.language || navigator.userLanguage;
					const langCode = userLang.split('-')[0].toLowerCase();
					
					const supportedLangs = ['tr', 'ru', 'es', 'hi', 'id', 'vi', 'pt', 'zh', 'tl'];
					if (supportedLangs.includes(langCode)) {
						window.location.replace('/' + langCode + '/');
					}
				}
			})();
		</script>

		<script is:inline>
			if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	<!-- OneSignal Push Notifications -->
    <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
    <script>
      window.OneSignalDeferred = window.OneSignalDeferred || [];
      OneSignalDeferred.push(async function(OneSignal) {
        await OneSignal.init({
          appId: "fe3434ff-e2df-4d5f-9faa-6859e830cb97",
        });
      });
    </script>
  </head>
	<body class="bg-[#f3f4f6] dark:bg-slate-900 text-[#334155] dark:text-slate-300 font-['Inter',sans-serif] antialiased flex flex-col min-h-screen transition-colors duration-300">
		<slot />
		<Footer />
		<CookieBanner />
	</body>
</html>
